# Board delta for rnsbox_orangepi_r1_defconfig.
# Common selections live in configs/base.config; this file is appended
# after it and wins for any symbol it mentions.

# RNSBox Orange Pi R1 — Allwinner H2+ (4x Cortex-A7), 256 MB RAM, 100M
# Ethernet, RTL8189ETV SDIO WiFi, micro-USB OTG (CDC-NCM gadget).
#
# Buildroot flow: upstream Buildroot + Linux 6.6 LTS +
# U-Boot 2024.01 (the same pinned pair as Buildroot's own orangepi_r1
# defconfig), with the RNSBox external tree supplying the router stack.
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_VFPV4=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV7_EABIHF_MUSL_STABLE=y
BR2_JLEVEL=4
BR2_ROOTFS_DEVICE_TABLE="system/device_table_dev.txt system/device_table.txt"
BR2_TARGET_GENERIC_ISSUE="RNSBox - Reticulum router (Orange Pi R1)"
# root login closed: the root password is locked ('*') at build time; the
# operator account is `admin` (locked too, until the user sets a password in
# the portal — see board/common/users.txt).
BR2_TARGET_ENABLE_ROOT_LOGIN=y
BR2_TARGET_GENERIC_ROOT_PASSWD="admin"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/orangepi-r1/users.txt"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/orangepi-r1/post-build.sh $(BR2_EXTERNAL_RNSBOX_PATH)/board/common/slim-target.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/orangepi-r1/post-image.sh"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RNSBOX_PATH)/board/common/rootfs-overlay $(BR2_EXTERNAL_RNSBOX_PATH)/board/orangepi-r1/rootfs-overlay"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/orangepi-r1/busybox.fragment"

# ---- kernel + U-Boot (upstream orangepi_r1 pair) ----
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.31"
BR2_LINUX_KERNEL_DEFCONFIG="sunxi"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/orangepi-r1/linux.fragment"

BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="allwinner/sun8i-h2-plus-orangepi-r1"
BR2_LINUX_KERNEL_LOCALVERSION="-rnsbox"
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2024.01"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="orangepi_r1"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-sunxi-with-spl.bin"
# image-size: the rootfs is grown to fill the card by S02resizefs on first
# boot; the factory size only sets the download size.
BR2_TARGET_ROOTFS_EXT2_SIZE="224M"
BR2_TARGET_ROOTFS_EXT2_RESBLKS=1
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_BOOT_SCRIPT=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_BOOT_SCRIPT_SOURCE="$(BR2_EXTERNAL_RNSBOX_PATH)/board/orangepi-r1/boot.cmd"

# ---- router data plane ----
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_JSON_C=y
BR2_PACKAGE_LIBUBOX=y
BR2_PACKAGE_UHTTPD=y
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_RNSBOX_UPDATE=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_OPENSSH_CLIENT=y
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_NTP_NTPD=y

# ---- rnsd (Reticulum) + Python stack ----
BR2_PACKAGE_PYTHON3_UNICODEDATA=y
BR2_PACKAGE_PYTHON3_PY_ONLY=y
BR2_PACKAGE_PYTHON3_PIP=y
BR2_PACKAGE_PYTHON_RNS=y
BR2_PACKAGE_PYTHON_SERIAL=y
BR2_PACKAGE_PYTHON_LXMF=y

# ---- WiFi (RTL8189ETV SDIO) + WPA supplicant/hostapd ----
BR2_PACKAGE_RTL8189ES=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_ACS=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_IW=y

# ---- Bluetooth LE transport (BlueZ + bleak/dbus-fast + ble-reticulum) ----
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
BR2_PACKAGE_BLUEZ5_UTILS_MONITOR=y
BR2_PACKAGE_PYTHON_BLEAK=y
BR2_PACKAGE_PYTHON_BLE_RETICULUM=y
# dbus-python (bluezero's transport) parses D-Bus introspection XML with
# xml.parsers.expat; without it BLE peripheral mode fails on import.
BR2_PACKAGE_PYTHON3_PYEXPAT=y

# TTY console: zsh, served by the portal itself.
BR2_PACKAGE_ZSH=y
