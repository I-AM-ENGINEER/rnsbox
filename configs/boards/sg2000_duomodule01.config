# Board delta for rnsbox_sg2000_duomodule01_defconfig.
# Common selections live in configs/base.config; this file is appended
# after it and wins for any symbol it mentions.

# RNSBox Milk-V Duo Module 01 EVB (Sophgo, C906 rv64gc) — Linux 7.3 flow.
# SD boot, internal EPHY Ethernet, eMMC on &emmc, AIC8800 SDIO1.

BR2_riscv=y
# rv64gc (C906; Bootlin toolchain + rust riscv64gc target require C)
BR2_RISCV_ISA_RVC=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_RISCV64_LP64D_GLIBC_STABLE=y
BR2_JLEVEL=3
BR2_TARGET_GENERIC_ISSUE="RNSBox - Reticulum router (Milk-V Duo Module 01 EVB)"
BR2_ROOTFS_DEVICE_TABLE="system/device_table_dev.txt system/device_table.txt"
BR2_TARGET_GENERIC_ROOT_PASSWD="admin"
# Shared SoC-independent RNSBox overlay first, SG2002-specific bits last
# (the later overlay wins: tuned fstab + zram/fstrim policy).
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2000/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/common/slim-target.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2000/post-image.sh"
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="v7.3-rc7"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2000/linux-patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sophgo/linux-rv64.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="sophgo/sg2000-duomodule01-evb"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2000/busybox.fragment"
BR2_PACKAGE_XZ=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
BR2_PACKAGE_HOST_DTC=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
BR2_PACKAGE_DBUS_PYTHON=y
# dbus-python (bluezero's transport) parses D-Bus introspection XML with
# xml.parsers.expat; without it BLE peripheral mode fails on import.
BR2_PACKAGE_PYTHON3_PYEXPAT=y
BR2_PACKAGE_PYTHON_BLEAK=y
BR2_PACKAGE_PYTHON_DBUS_FAST=y
BR2_PACKAGE_RNSBOX_PYTHON_BLUEZERO=y
BR2_PACKAGE_PYTHON_BLE_RETICULUM=y
# WiFi: the portal and S35wifi drive iw/wpa_supplicant/hostapd; the
# AIC8800D80 is a cfg80211 fullmac, so nl80211 is the only backend.
# The driver is out-of-tree: /root/wifi.sh insmods the two .ko in /root.
BR2_PACKAGE_AIC8800=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_HOSTAPD_ACS=y
BR2_PACKAGE_HOSTAPD_WPA3=y

# TTY console: zsh, served by the portal itself.
BR2_PACKAGE_ZSH=y
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/common/users.txt"

BR2_GENERATE_LOCALE="C.UTF-8"
BR2_ENABLE_LOCALE_WHITELIST="C en_US C.UTF-8 C.utf8"
