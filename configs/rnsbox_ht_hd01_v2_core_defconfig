# Generated by scripts/gen-defconfigs.sh — do not edit.
# Sources: configs/base.config + configs/boards/ht_hd01_v2_core.config

# RNSBox common configuration — every external-tree board (rpi-universal,
# orangepi-r1, pc-x86_64, milkv-duo-cv1800b, the Sophgo
# boards).  The vendor-BSP flows under patches/ keep their own defconfigs:
# their Kconfig/package set differs and build.sh stamps the vendor policy.
#
# Source of truth:
#   configs/base.config              this file — shared selections
#   configs/boards/<board>.config    board delta, appended AFTER this file
#   configs/rnsbox_<board>_defconfig generated by scripts/gen-defconfigs.sh
#
# The generated defconfigs are committed so plain `make <board>_defconfig`
# keeps working; never edit them by hand.  A delta wins over this file for
# any symbol it mentions (kconfig is last-wins), and the generator removes
# the base line for that symbol so the result has no duplicate assignments.
#
# Keep this file to truly universal selections.  Anything that differs per
# board (architecture, toolchain, kernel source/DTS, overlay, image size,
# users table, root-login policy, WiFi/BT) belongs in the board delta.

# --- target identity and image format ---
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_PACKAGE_HOST_GENIMAGE=y

# --- kernel build prerequisites (the source/DTS/config stay per board) ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# --- compiler cache: CI rebuilds are dominated by the kernel and python
# recompiles; ccache turns every unchanged object into a cache hit. The
# cache lands in ~/.buildroot-ccache (or $BR2_CCACHE_DIR when the
# environment sets it — the CI workflow points it at a cached /mnt path).
# Bounded so eight board caches fit the GitHub 10 GB cache quota.
BR2_CCACHE=y
BR2_CCACHE_INITIAL_SETUP="--max-size=1200M"

# --- base userspace and filesystem tools ---
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y

# --- router data plane ---
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_OPENRESOLV=y
# The operator account is admin (root is locked); sudo is the one privileged
# path for SSH and the browser Console. The sudoers drop-in lives in
# board/common/sudoers.d and is installed by slim-target.sh.
BR2_PACKAGE_SUDO=y

# --- WiFi userspace (every board except the 64 MB CV1800B and MT7628) ---
# S35wifi and the portal's WiFi tab drive iw/wpa_supplicant/hostapd. The
# per-board radio module is separate: AIC8800 boards select
# BR2_PACKAGE_AIC8800, RPi/OrangePi carry their SoC driver in the kernel.
# The two small-RAM deltas turn this whole block off.

# --- rnsd (Reticulum) and the portal stack ---
BR2_PACKAGE_CA_CERTIFICATES=y
# git is required by rngit / git-remote-rns (Git over Reticulum)
BR2_PACKAGE_PYTHON3=y
# Time over Reticulum: S88rnstime sets the clock from a mesh rns-time server
# when ordinary NTP is unreachable (and can serve time to the mesh too).
BR2_PACKAGE_PYTHON_RNS_TIME=y
BR2_PACKAGE_RNSBOX_PORTAL=y

# Board delta for rnsbox_ht_hd01_v2_core_defconfig.
# Common selections live in configs/base.config; this file is appended
# after it and wins for any symbol it mentions.

# Heltec HT-HD01-V2 — MediaTek MT7628AN (MIPS 24KEc, little-endian,
# soft-float), 128 MB RAM, 32 MB SPI NOR.  Core image: rnsd + portal + SSH +
# LXMF echo bot.  No BlueZ/BLE (the board has no Bluetooth radio), no git,
# no on-device pip.

BR2_mipsel=y
BR2_mips_32r2=y
BR2_MIPS_SOFT_FLOAT=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_USE_MMU=y
BR2_USE_WCHAR=y
BR2_TOOLCHAIN_HAS_THREADS=y
BR2_INSTALL_LIBSTDCPP=y
BR2_SOFT_FLOAT=y

BR2_TARGET_GENERIC_ISSUE="RNSBox - Reticulum router (HT-HD01-V2)"
BR2_TARGET_GENERIC_HOSTNAME="rnsbox"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/ht-hd01-v2/users.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RNSBOX_PATH)/board/common/rootfs-overlay $(BR2_EXTERNAL_RNSBOX_PATH)/board/ht-hd01-v2/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/common/slim-target.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/ht-hd01-v2/post-image.sh"

# Linux 7.3 + the board DTS (injected by external.mk)
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.3"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="vocore2"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/ht-hd01-v2/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="ralink/ht-hd01-v2"
BR2_LINUX_KERNEL_UIMAGE=y
# Stock Ralink U-Boot 1.1.3 has gzip/xz disabled; only LZMA is built in.
BR2_LINUX_KERNEL_LZMA=y
BR2_LINUX_KERNEL_LOCALVERSION="-rnsbox"

# First bring-up image is an initramfs uImage (safe TFTP-to-RAM test).
# The production variant switches to squashfs + jffs2 overlay.
# BR2_TARGET_ROOTFS_EXT2 is not set
# BR2_TARGET_ROOTFS_INITRAMFS is not set
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
BR2_TARGET_ROOTFS_SQUASHFS_EXTREME_COMP=y

# Python: compiled-only payload (read-only/initramfs root; no runtime writes).
BR2_PACKAGE_PYTHON3_PYC_ONLY=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON3_UNICODEDATA=y
BR2_PACKAGE_PYTHON_LXMF=y

# Remove full-image weight that this board does not need.
# BR2_PACKAGE_GIT is not set
# BR2_PACKAGE_NANO is not set
# BR2_PACKAGE_E2FSPROGS is not set
# BR2_PACKAGE_UTIL_LINUX_BINARIES is not set
# BR2_PACKAGE_PYTHON_PSUTIL is not set
# BR2_PACKAGE_PYTHON_NOMADNET is not set
# BR2_PACKAGE_PYTHON3_PIP is not set

# SSH: Dropbear, not OpenSSH. The listener is ~370 KB either way, but every
# OpenSSH session forks a multi-MB sshd, while Dropbear stays ~1-2 MB — this
# matters on the 64 MB target. Dropbear still installs an `ssh` client.
# BR2_PACKAGE_OPENSSH is not set
# BR2_PACKAGE_OPENSSH_CLIENT is not set
# BR2_PACKAGE_OPENSSH_SERVER is not set
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_CLIENT=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y

# NTP: OpenNTPD instead of ISC ntpd (950 KB binary, ~760 KB RSS -> ~300 KB
# and a much smaller attack surface). The portal still edits /etc/ntp.conf;
# the board's S49ntp converts its server lines to openntpd syntax.
# BR2_PACKAGE_NTP is not set
# BR2_PACKAGE_NTP_NTPDATE is not set
# BR2_PACKAGE_NTP_NTPD is not set
BR2_PACKAGE_OPENNTPD=y

# HaLow + 2.4 GHz firmware/userspace.
BR2_PACKAGE_MORSE_DRIVER=y
BR2_PACKAGE_MT7628_ESW=y
BR2_PACKAGE_HT_HD01_FIRMWARE=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
# MT7628 frame engine advertises TX/RX checksum offload that corrupts TCP
# payloads with the flat switch; S30network disables it at boot.
BR2_PACKAGE_ETHTOOL=y

# WiFi userspace: the MT7603E is built into the kernel; STA association,
# scanning and hostapd AP need the nl80211 tools.  iproute2 is needed to
# create br-lan because busybox ip has no bridge link type.
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_HOSTAPD_ACS=y
BR2_PACKAGE_HOSTAPD_WPA3=y

# Use 6.19 UAPI headers: Buildroot 2026.02 does not know 7.x yet, and
# "same as kernel" would fail its strict header check.  The 7.3 kernel is
# still built; only the userspace UAPI headers come from 6.19.
# BR2_KERNEL_HEADERS_AS_KERNEL is not set
BR2_KERNEL_HEADERS_6_19=y

# C/OpenSSL crypto for RNS on mipsel (no Rust/MIPS target).
BR2_PACKAGE_PYTHON_CRYPTOGRAPHY_LEGACY=y
