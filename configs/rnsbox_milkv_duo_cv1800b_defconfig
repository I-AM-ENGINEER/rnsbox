# Generated by scripts/gen-defconfigs.sh — do not edit.
# Sources: configs/base.config + configs/boards/milkv_duo_cv1800b.config

# RNSBox common configuration — every external-tree board (rpi-universal,
# orangepi-r1, pc-x86_64, milkv-duo-cv1800b, the Sophgo
# boards).  The vendor-BSP flows under patches/ keep their own defconfigs:
# their Kconfig/package set differs and build.sh stamps the vendor policy.
#
# Source of truth:
#   configs/base.config              this file — shared selections
#   configs/boards/<board>.config    board delta, appended AFTER this file
#   configs/rnsbox_<board>_defconfig generated by scripts/gen-defconfigs.sh
#
# The generated defconfigs are committed so plain `make <board>_defconfig`
# keeps working; never edit them by hand.  A delta wins over this file for
# any symbol it mentions (kconfig is last-wins), and the generator removes
# the base line for that symbol so the result has no duplicate assignments.
#
# Keep this file to truly universal selections.  Anything that differs per
# board (architecture, toolchain, kernel source/DTS, overlay, image size,
# users table, root-login policy, WiFi/BT) belongs in the board delta.

# --- target identity and image format ---
BR2_TARGET_GENERIC_HOSTNAME="rnsbox"
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_PACKAGE_HOST_GENIMAGE=y

# --- kernel build prerequisites (the source/DTS/config stay per board) ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# --- base userspace and filesystem tools ---
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_NANO=y

# --- router data plane ---
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_OPENRESOLV=y
BR2_PACKAGE_NTP=y
BR2_PACKAGE_NTP_NTPDATE=y
BR2_PACKAGE_OPENSSH=y
# The operator account is admin (root is locked); sudo is the one privileged
# path for SSH and the browser Console. The sudoers drop-in lives in
# board/common/sudoers.d and is installed by slim-target.sh.
BR2_PACKAGE_SUDO=y

# --- WiFi userspace (every board except the 64 MB CV1800B and MT7628) ---
# S35wifi and the portal's WiFi tab drive iw/wpa_supplicant/hostapd. The
# per-board radio module is separate: AIC8800 boards select
# BR2_PACKAGE_AIC8800, RPi/OrangePi carry their SoC driver in the kernel.
# The two small-RAM deltas turn this whole block off.

# --- rnsd (Reticulum) and the portal stack ---
BR2_PACKAGE_CA_CERTIFICATES=y
# git is required by rngit / git-remote-rns (Git over Reticulum)
BR2_PACKAGE_GIT=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON_PSUTIL=y
# Time over Reticulum: S88rnstime sets the clock from a mesh rns-time server
# when ordinary NTP is unreachable (and can serve time to the mesh too).
BR2_PACKAGE_PYTHON_RNS_TIME=y
BR2_PACKAGE_RNSBOX_PORTAL=y

# Board delta for rnsbox_milkv_duo_cv1800b_defconfig.
# Common selections live in configs/base.config; this file is appended
# after it and wins for any symbol it mentions.

# RNSBox Milk-V Duo 64M (Sophgo CV1800B, C906 rv64gc) — Linux flow.
# External-tree board like rpi-universal: buildroot 2026.02.3 userspace (riscv64
# lp64d GLIBC Bootlin — the portable rv64gc ABI, milkv-duo-cv1800b series
# 0032 lesson; glibc over musl because buildroot's rust tier lists carry
# riscv64 only for glibc, and python-rns -> python-cryptography needs
# host-rustc target support) + upstream kernel from the pinned kernel.org
# stable tag with board/milkv-duo/linux-patches on top (ethernet enable, USB
# gadget mode, opensbi memory reserve). Boot blobs are the vendor fip.bin —
# see board/milkv-duo/README.fip.md; boot.sd FIT assembly in
# board/milkv-duo/post-image.sh. Kernel config: 64 MB RAM budget (no
# DEBUG_INFO, no wireless/media/extra filesystems), full driver set for the
# SoC (dwcmshc mmc, dwmac + internal PHY, 8250, saradc, rtc) + DWC2
# dual-role gadget + virtio-mmio for the QEMU smoke test.
BR2_riscv=y
# rv64gc (C906 boots it; the Bootlin toolchain and the rust tier2
# riscv64gc-unknown-linux-gnu match both require the C extension)
BR2_RISCV_ISA_RVC=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_RISCV64_LP64D_GLIBC_STABLE=y
BR2_JLEVEL=3
BR2_TARGET_GENERIC_ISSUE="RNSBox - Reticulum router (Milk-V Duo CV1800B)"
BR2_ROOTFS_DEVICE_TABLE="system/device_table_dev.txt system/device_table.txt"
BR2_TARGET_GENERIC_ROOT_PASSWD="admin"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RNSBOX_PATH)/board/common/rootfs-overlay $(BR2_EXTERNAL_RNSBOX_PATH)/board/milkv-duo/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/common/slim-target.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/milkv-duo/post-image.sh"
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="v7.3-rc7"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_RNSBOX_PATH)/board/common/linux-patches $(BR2_EXTERNAL_RNSBOX_PATH)/board/milkv-duo/linux-patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sophgo/linux-rv64.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="sophgo/cv1800b-milkv-duo"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/milkv-duo/busybox.fragment"
BR2_PACKAGE_XZ=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
BR2_PACKAGE_HOST_DTC=y
# No WiFi and no NomadNet on the 64 MB CV1800B: there is no radio to drive,
# and the LXMF/pages stack does not fit comfortably. Everything below
# overrides the shared Wi-Fi/NomadNet block in configs/base.config.
# BR2_PACKAGE_PYTHON_NOMADNET is not set
# BR2_PACKAGE_IW is not set
# BR2_PACKAGE_WIRELESS_REGDB is not set
# BR2_PACKAGE_WPA_SUPPLICANT is not set
# BR2_PACKAGE_WPA_SUPPLICANT_NL80211 is not set
# BR2_PACKAGE_WPA_SUPPLICANT_CLI is not set
# BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE is not set
# BR2_PACKAGE_WPA_SUPPLICANT_WPA3 is not set
# BR2_PACKAGE_HOSTAPD is not set
# BR2_PACKAGE_HOSTAPD_DRIVER_NL80211 is not set
# BR2_PACKAGE_HOSTAPD_ACS is not set
# BR2_PACKAGE_HOSTAPD_WPA3 is not set

# TTY console: zsh, served by the portal itself.
BR2_PACKAGE_ZSH=y
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/common/users.txt"

BR2_GENERATE_LOCALE="C.UTF-8"
BR2_ENABLE_LOCALE_WHITELIST="C en_US C.UTF-8 C.utf8"
