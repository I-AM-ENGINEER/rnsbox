# RNSBox Milk-V Duo S (Sophgo SG2000, Cortex-A53 aarch64) — MAINLINE 7.3.
# Internal EPHY Ethernet, eMMC, SD, AIC8800 SDIO1 (driver out-of-tree),
# USB CDC-NCM gadget.  The boot chain stays vendor: the ARM64 fip.bin from
# the SG2000 vendor BSP plus our boot.sd FIT around the mainline Image/DTB.

BR2_aarch64=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_MUSL_STABLE=y
BR2_JLEVEL=3
BR2_TARGET_GENERIC_HOSTNAME="rnsbox"
BR2_TARGET_GENERIC_ISSUE="RNSBox - Reticulum router (Milk-V Duo S, ARM64, mainline)"
BR2_ROOTFS_DEVICE_TABLE="system/device_table_dev.txt system/device_table.txt"
BR2_TARGET_GENERIC_ROOT_PASSWD="admin"
BR2_TARGET_ENABLE_ROOT_LOGIN=y
# Shared SoC-independent RNSBox overlay (same as the RISC-V Duo S image).
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2000-mainline/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/common/slim-target.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2000-duo-s-arm64-mainline/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="v7.3-rc7"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2000-duo-s-arm64-mainline/linux-patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2000-duo-s-arm64-mainline/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2000-duo-s-arm64-mainline/linux-sbc.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="sophgo/sg2000-milkv-duo-s"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_LOCALVERSION="-rnsbox"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2000-mainline/busybox.fragment"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON_PSUTIL=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_NTP=y
BR2_PACKAGE_NTP_NTPDATE=y
BR2_PACKAGE_OPENRESOLV=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
BR2_PACKAGE_HOST_DTC=y
BR2_PACKAGE_PYTHON_NOMADNET=y
BR2_PACKAGE_RNSBOX_PORTAL=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
BR2_PACKAGE_DBUS_PYTHON=y
BR2_PACKAGE_PYTHON_BLEAK=y
BR2_PACKAGE_PYTHON_DBUS_FAST=y
BR2_PACKAGE_RNSBOX_PYTHON_BLUEZERO=y
BR2_PACKAGE_PYTHON_BLE_RETICULUM=y
# WiFi: the portal and S35wifi drive iw/wpa_supplicant/hostapd; the
# AIC8800D80 is a cfg80211 fullmac, so nl80211 is the only backend.
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_HOSTAPD_ACS=y
BR2_PACKAGE_HOSTAPD_WPA3=y

# Full web terminal: ttyd (xterm.js) + zsh for the Console tab.
BR2_PACKAGE_TTYD=y
BR2_PACKAGE_ZSH=y
