# Generated by scripts/gen-defconfigs.sh — do not edit.
# Sources: configs/base.config + configs/boards/pc_x86_64.config

# RNSBox common configuration — every external-tree board (rpi-universal,
# orangepi-r1, pc-x86_64, milkv-duo-cv1800b, the Sophgo
# boards).  The vendor-BSP flows under patches/ keep their own defconfigs:
# their Kconfig/package set differs and build.sh stamps the vendor policy.
#
# Source of truth:
#   configs/base.config              this file — shared selections
#   configs/boards/<board>.config    board delta, appended AFTER this file
#   configs/rnsbox_<board>_defconfig generated by scripts/gen-defconfigs.sh
#
# The generated defconfigs are committed so plain `make <board>_defconfig`
# keeps working; never edit them by hand.  A delta wins over this file for
# any symbol it mentions (kconfig is last-wins), and the generator removes
# the base line for that symbol so the result has no duplicate assignments.
#
# Keep this file to truly universal selections.  Anything that differs per
# board (architecture, toolchain, kernel source/DTS, overlay, image size,
# users table, root-login policy, WiFi/BT) belongs in the board delta.

# --- target identity and image format ---
BR2_TARGET_GENERIC_HOSTNAME="rnsbox"
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_PACKAGE_HOST_GENIMAGE=y

# --- kernel build prerequisites (the source/DTS/config stay per board) ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# --- base userspace and filesystem tools ---
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_NANO=y

# --- router data plane ---
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_OPENRESOLV=y
BR2_PACKAGE_NTP=y
BR2_PACKAGE_NTP_NTPDATE=y
BR2_PACKAGE_OPENSSH=y
# The operator account is admin (root is locked); sudo is the one privileged
# path for SSH and the browser Console. The sudoers drop-in lives in
# board/common/sudoers.d and is installed by slim-target.sh.
BR2_PACKAGE_SUDO=y

# --- WiFi userspace (every board except the 64 MB CV1800B and MT7628) ---
# S35wifi and the portal's WiFi tab drive iw/wpa_supplicant/hostapd. The
# per-board radio module is separate: AIC8800 boards select
# BR2_PACKAGE_AIC8800, RPi/OrangePi carry their SoC driver in the kernel.
# The two small-RAM deltas turn this whole block off.
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_HOSTAPD_ACS=y
BR2_PACKAGE_HOSTAPD_WPA3=y

# --- rnsd (Reticulum) and the portal stack ---
BR2_PACKAGE_CA_CERTIFICATES=y
# git is required by rngit / git-remote-rns (Git over Reticulum)
BR2_PACKAGE_GIT=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON_PSUTIL=y
BR2_PACKAGE_PYTHON_NOMADNET=y
# Time over Reticulum: S88rnstime sets the clock from a mesh rns-time server
# when ordinary NTP is unreachable (and can serve time to the mesh too).
BR2_PACKAGE_PYTHON_RNS_TIME=y
BR2_PACKAGE_RNSBOX_PORTAL=y

# Board delta for rnsbox_pc_x86_64_defconfig.
# Common selections live in configs/base.config; this file is appended
# after it and wins for any symbol it mentions.

# RNSBox PC/VM image — x86_64, BIOS boot, for QEMU / VirtualBox / VMware.
#
# One raw disk: grub2 (i386-pc) staged into the MBR by post-image.sh, one
# ext4 root partition carrying /boot/bzImage + /boot/grub/grub.cfg. The
# router software stack is byte-for-byte the boards' stack (S-chain, portal,
# rnsd, dnsmasq, nftables, dropbear-less OpenSSH) from the shared external
# packages; the board delta lives in board/pc/rnsbox-x86_64/ (overlay + kernel
# config + grub/genimage). Roles: eth0 = WAN (DHCP — the boards' eth0), eth1
# = LAN port of br-lan 10.42.0.1/24 (the boards' usb0 gadget; see S30lan).
# Feature parity is honest-degrading: no BLE, no WiFi, no USB gadget in a
# VM — the S-scripts no-op those exactly as on boards without the hardware.
#
# Root login: root/admin over the LAN (serial ttyS0 + tty1 consoles), the
# portal login is admin/admin — identical to the rpi-universal target.
BR2_x86_64=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
# the pc board's hash overrides — carries the sha256 of the 6.12.47 kernel
# tarball (upstream dropped that pin from its own hash lists long ago)
BR2_GLOBAL_PATCH_DIR="board/pc/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
# machine is shared; keep the load polite
BR2_JLEVEL=2
BR2_TARGET_GENERIC_ISSUE="RNSBox - Reticulum router (PC/VM, x86_64)"
BR2_TARGET_GENERIC_ROOT_PASSWD="admin"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/pc/rnsbox-x86_64/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/pc/rnsbox-x86_64/post-image.sh"
# kernel 6.12 LTS (same base the buildroot pc board uses), built-in config
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.47"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_RNSBOX_PATH)/board/pc/rnsbox-x86_64/linux.config"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
# objtool compiles against host libelf (WIP: sole known build break, fixed here)
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
# kernel release suffix (uname -r -> 6.12.47-rnsbox), as on the boards
BR2_LINUX_KERNEL_LOCALVERSION="-rnsbox"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/pc/rnsbox-x86_64/busybox.fragment"
# HTTP tier (uhttpd serves the rnsbox-portal CGI binary)
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_JSON_C=y
BR2_PACKAGE_LIBUBOX=y
BR2_PACKAGE_UHTTPD=y
# per-board overlay (the portal package itself is in base.config)
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RNSBOX_PATH)/board/pc/rnsbox-x86_64/rootfs-overlay"
BR2_PACKAGE_ZLIB=y
# router data plane
BR2_PACKAGE_OPENSSH_CLIENT=y
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_UTIL_LINUX=y
# rnsd (Reticulum transport node) + python stack
BR2_PACKAGE_PYTHON3_UNICODEDATA=y
BR2_PACKAGE_NTP_NTPD=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON3_PIP=y
BR2_PACKAGE_PYTHON_RNS=y
# opt-in extras: LXMF propagation node, NomadNet node (as on the boards)
BR2_PACKAGE_PYTHON_LXMF=y
# boot: grub2 BIOS — boot.img/core.img go to the MBR + post-MBR gap
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_INSTALL_TOOLS=y
BR2_TARGET_ROOTFS_EXT2_SIZE="400M"
# BR2_TARGET_ROOTFS_TAR is not set
# portal is C++ — the toolchain needs g++ (run 37: g++ missing at rnsbox-portal build)
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# TTY console: zsh, served by the portal itself.
BR2_PACKAGE_ZSH=y
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/common/users.txt"
