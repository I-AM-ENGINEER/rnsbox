# RNSBox universal Raspberry Pi image — ONE aarch64 image for every 64-bit
# Pi: Zero 2 W, 3B/3B+/3A+/CM3, 4B/400/CM4/CM4S, 5/500/CM5 (ARMv6 Pis are
# out of scope; see docs/BOARD-universal-rpi.md). The kernel is a 4K-page
# superset: bcm2711_defconfig already carries every BCM2712 driver (rpi
# 6.12 keeps the two defconfigs identical apart from page size), our
# linux.fragment adds the router bits on top. config.txt selects the right
# firmware + tuning per model; all DTBs ship on the boot FAT.
BR2_aarch64=y
BR2_ARM_FPU_VFPV4=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_MUSL_STABLE=y
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_JLEVEL=4
BR2_ROOTFS_DEVICE_TABLE="system/device_table_dev.txt system/device_table.txt"
BR2_TARGET_GENERIC_HOSTNAME="rnsbox"
BR2_TARGET_GENERIC_ISSUE="RNSBox - Reticulum router (Raspberry Pi, 64-bit universal)"
# root login closed: the root password is locked ('*') at build time; the
# operator account is `admin` (locked too, until the user sets a password in
# the portal — see board/raspberrypi/rnsbox-0-2w/users.txt and
# docs/SSH-HARDENING.md).
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/raspberrypi/rnsbox-0-2w/users.txt"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/raspberrypi/rnsbox-0-2w/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/raspberrypi/rnsbox-0-2w/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/raspberrypi/rnsbox-0-2w/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# Every board the firmware can pick at boot: Zero 2 W (and its non-W twin),
# Pi 3B/3B+/CM3-class (bcm2710 prefix; 3A+ builds as bcm2837-* and the
# post-image script adds the bcm2710-rpi-3-a-plus alias the firmware asks
# for), Pi 4/400/CM4/CM4S (bcm2711) and Pi 5/500/CM5 incl. D0 stepping
# (bcm2712).
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2710-rpi-zero-2-w broadcom/bcm2710-rpi-zero-2 broadcom/bcm2710-rpi-3-b broadcom/bcm2710-rpi-3-b-plus broadcom/bcm2837-rpi-3-a-plus broadcom/bcm2711-rpi-4-b broadcom/bcm2711-rpi-400 broadcom/bcm2711-rpi-cm4 broadcom/bcm2711-rpi-cm4-io broadcom/bcm2711-rpi-cm4s broadcom/bcm2712-rpi-5-b broadcom/bcm2712-d-rpi-5-b broadcom/bcm2712d0-rpi-5-b broadcom/bcm2712-rpi-500 broadcom/bcm2712-rpi-cm5-cm4io broadcom/bcm2712-rpi-cm5-cm5io broadcom/bcm2712-rpi-cm5l-cm4io broadcom/bcm2712-rpi-cm5l-cm5io"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
# Pi 1-3 class firmware: full start.elf (fallback) + cut-down start_cd.elf
# (the [pi02]/[pi3] config.txt sections select the cut-down one; the full
# start.elf silently enforces a ~128 MB GPU floor on the Zero 2 W — ARM
# would see only 384 MB).
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI_CD=y
# Pi 4/400/CM4/CM4S: same pair in the 4th-gen flavour ([pi4] section).
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4_CD=y
# The Pi 5 family needs neither: its bootloader (SPI EEPROM) reads
# config.txt and loads kernel + DTB + overlays directly from the FAT.
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_RNSBOX_PATH)/board/raspberrypi/rnsbox-0-2w/config.txt"
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="400M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
# HTTP tier (uhttpd serves the rnsbox-portal CGI binary)
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_JSON_C=y
BR2_PACKAGE_LIBUBOX=y
BR2_PACKAGE_UHTTPD=y
# rnsbox-portal (C++/CGI admin UI) + per-board overlay
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RNSBOX_PATH)/board/raspberrypi/rnsbox-0-2w/rootfs-overlay"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/raspberrypi/rnsbox-0-2w/busybox.fragment"
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_RNSBOX_PORTAL=y
# router data plane
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_CLIENT=y
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_OPENRESOLV=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
# rnsd (Reticulum transport node) + python stack
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON3_UNICODEDATA=y
BR2_PACKAGE_PYTHON_PSUTIL=y
BR2_PACKAGE_NTP=y
BR2_PACKAGE_NTP_NTPD=y
BR2_PACKAGE_NTP_NTPDATE=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON3_PIP=y
BR2_PACKAGE_PYTHON_RNS=y
# RNodeInterface (USB serial RNode modems) imports pyserial in its constructor;
# without it rnsd panics at interface creation.
BR2_PACKAGE_PYTHON_SERIAL=y
# WiFi STA/AP/APSTA (onboard brcmfmac) + firmware — covers the 43430s
# (Zero 2 W), 43455 (3B+/3A+/4/400/CM4/5) and the per-model firmware names
# the kernel requests on each board.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XX=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_ACS=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_IW=y
# opt-in extras: LXMF propagation node, NomadNet node, rnsd auto-restart
BR2_PACKAGE_PYTHON_LXMF=y
BR2_PACKAGE_PYTHON_NOMADNET=y
# Bluetooth LE transport (Reticulum [[BLE Interface]]): BlueZ + D-Bus +
# bleak/dbus-fast (bleak selects dbus-fast), the vendored ble-reticulum
# classes (they select bluezero + dbus-python) and the Broadcom BT firmware
# the onboard controllers need. Onboard BT on the Zero 2 W hangs off the
# mini-uart (config.txt miniuart-bt); every other BT source is a USB dongle.
# Without any adapter the interface degrades into a logged no-op.
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
BR2_PACKAGE_BLUEZ5_UTILS_MONITOR=y
BR2_PACKAGE_PYTHON_BLEAK=y
BR2_PACKAGE_PYTHON_BLE_RETICULUM=y
BR2_PACKAGE_RNSBOX_BT_FIRMWARE=y
# kernel release suffix (uname -r -> 6.x.y-rnsbox)
BR2_LINUX_KERNEL_LOCALVERSION="-rnsbox"
