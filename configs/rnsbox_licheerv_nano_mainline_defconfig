# RNSBox Sipeed LicheeRV Nano B (Sophgo SG2002, C906 rv64gc) — MAINLINE flow.
# Same shape as rnsbox_milkv_duo_cv1800b_mainline_defconfig: buildroot
# 2026.02.3 userspace (riscv64 lp64d glibc) + mainline 7.3-rc7 with
# board/sg2002-mainline/linux-patches on top.  The single patch enables
# gmac0 + the MDIO mux so the SG2002 internal EPHY drives the RJ45 jack;
# the TMI7003C on the board is a fixed-output DCDC+LDO, not an Ethernet
# device (see board/sg2002-mainline/README.md).
#
# Boot blobs: vendor fip.bin (provenance-pinned, fip.bin.sha256) and a FIT
# with Image.gz + sg2002-licheerv-nano-b.dtb, assembled by
# board/sg2002-mainline/post-image.sh.
BR2_riscv=y
# rv64gc (C906; Bootlin toolchain + rust riscv64gc target require C)
BR2_RISCV_ISA_RVC=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_RISCV64_LP64D_GLIBC_STABLE=y
BR2_JLEVEL=3
BR2_TARGET_GENERIC_HOSTNAME="rnsbox"
BR2_TARGET_GENERIC_ISSUE="RNSBox - Reticulum router (LicheeRV Nano, mainline)"
BR2_ROOTFS_DEVICE_TABLE="system/device_table_dev.txt system/device_table.txt"
BR2_TARGET_GENERIC_ROOT_PASSWD="admin"
# Shared SoC-independent RNSBox overlay first, SG2002-specific bits last
# (the later overlay wins: tuned fstab + zram/fstrim policy).
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2000-mainline/rootfs-overlay $(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2002-mainline/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/common/slim-target.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2002-mainline/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="v7.3-rc7"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2002-mainline/linux-patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2002-mainline/linux.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="sophgo/sg2002-licheerv-nano-b"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_RNSBOX_PATH)/board/sg2000-mainline/busybox.fragment"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_PY_PYC=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON_PSUTIL=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_NTP=y
BR2_PACKAGE_NTP_NTPDATE=y
BR2_PACKAGE_OPENRESOLV=y
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
BR2_PACKAGE_HOST_DTC=y
BR2_PACKAGE_PYTHON_NOMADNET=y
BR2_PACKAGE_RNSBOX_PORTAL=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
BR2_PACKAGE_DBUS_PYTHON=y
BR2_PACKAGE_PYTHON_BLEAK=y
BR2_PACKAGE_PYTHON_DBUS_FAST=y
BR2_PACKAGE_RNSBOX_PYTHON_BLUEZERO=y
BR2_PACKAGE_PYTHON_BLE_RETICULUM=y
