From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Fri, 17 Oct 2026 03:05:00 +0300
Subject: [PATCH 33/33] headless: silence the vendor S00kmod/S07kmod2 insmod
 noise

The vendor kmod scripts hardcode insmod soph_*.ko lines for the
media/ISP module set that the headless strip deliberately does not
ship - every boot printed 20+ 'can't insert: No such file or
directory' lines (the earlier loadsystemko fix covered a different
consumer). S00kmod/S07kmod2 become documented no-ops: USB-eth and
platform ko load from /mnt/system/auto.sh, nothing else is expected
here.

---
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S00kmod b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S00kmod
old mode 100644
new mode 100755
index 4c5ff68..6b50a7f
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S00kmod
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S00kmod
@@ -1,30 +1,6 @@
 #!/bin/sh
-
-if [ "$1" = "start" ]
-then
-	. /etc/profile
-	printf "load kernel module: "
-	cd /mnt/system/ko/
-	insmod soph_sys.ko
-	insmod soph_base.ko
-	insmod soph_rtos_cmdqu.ko # optional for RTOS core
-	insmod soph_fast_image.ko # optional for RTOS core
-	insmod soph_mipi_rx.ko
-	insmod soph_snsr_i2c.ko
-	insmod soph_vi.ko
-	insmod soph_vpss.ko
-	insmod soph_dwa.ko
-	insmod soph_vo.ko
-#	insmod soph_mipi_tx.ko
-	insmod soph_rgn.ko
-	insmod soph_tpu.ko
-	insmod soph_vcodec.ko
-	insmod soph_jpeg.ko
-	insmod soph_vc_driver.ko MaxVencChnNum=9 MaxVdecChnNum=9
-	insmod soph_ive.ko
-	insmod soph_pwm.ko
-	insmod soph_saradc.ko
-#	insmod soph_wiegand.ko # uncomment it if want use wiegand
-	echo "OK"
-	exit 0
-fi
+# RNSBox headless: the vendor media/ISP ko set is intentionally not
+# shipped (the strip patch); USB-eth and platform ko load from
+# /mnt/system/auto.sh. Load nothing, keep the boot log clean.
+echo "OK"
+exit 0
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S07kmod2 b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S07kmod2
old mode 100644
new mode 100755
index 016101d..8eae5b5
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S07kmod2
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S07kmod2
@@ -1,14 +1,4 @@
 #!/bin/sh
-
-if [ "$1" = "start" ]
-then
-	. /etc/profile
-	printf "load kernel module: "
-	cd /mnt/system/ko/
-	insmod soph_wdt.ko
-	insmod soph_clock_cooling.ko
-	insmod soph_rtc.ko
-	insmod soph_mon.ko
-	echo "OK"
-	exit 0
-fi
+# RNSBox headless: see S00kmod - nothing to load here either.
+echo "OK"
+exit 0
2.43.0

