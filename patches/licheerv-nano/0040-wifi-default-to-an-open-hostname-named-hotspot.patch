From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Taixin Reverse <reverse@taixin.local>
Date: Sat, 17 Oct 2026 17:13:48 +0300
Subject: [PATCH 2/3] wifi: default to an open hostname-named hotspot after
 flashing

mode=off made every fresh image radio-silent until someone found the
portal tab. Default now: mode=ap, no PSK (open), SSID = the device
hostname (rnsbox-xxxxxx) via the S35wifi fallback, 192.168.42.1 with
NAT to the WAN. Portal changes still persist over this file.
---
 .../cvitek/SG200X/overlay/etc/init.d/S35wifi  |  5 +-
 .../SG200X/overlay/etc/rnsbox/wifi.conf       | 67 +++++--------------
 2 files changed, 20 insertions(+), 52 deletions(-)

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S35wifi b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S35wifi
index 14ca48d83..4ec79f436 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S35wifi
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S35wifi
@@ -241,7 +241,10 @@ start_ap() {
 	iface="$1"
 	ssid=$(cfg ap_ssid); psk=$(cfg ap_psk); chan=$(cfg ap_channel)
 	hidden=$(cfg ap_hidden); ap_ip=$(cfg ap_ip); htmode=$(cfg ap_htmode)
-	[ -z "$ssid" ] && { log "AP requested but ap_ssid empty; skipping"; return 0; }
+	if [ -z "$ssid" ]; then
+		ssid="$(hostname)"
+		log "ap_ssid empty - defaulting to the device hostname ($ssid)"
+	fi
 	[ -z "$chan" ] && chan=6
 	[ -z "$ap_ip" ] && ap_ip=192.168.42.1
 	[ -z "$htmode" ] && htmode=ht20
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/wifi.conf b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/wifi.conf
index ea3f7baa1..7f9de45c1 100644
--- a/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/wifi.conf
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/wifi.conf
@@ -1,62 +1,27 @@
-# RNSBox WiFi config — read at boot by /etc/init.d/S35wifi.
+# RNSBox WiFi config — read at boot by /etc/init.d/S35wifi, managed by
+# the rnsbox-portal WiFi tab.
 #
-# Only meaningful on the LicheeRV Nano-e **W** variant (AIC8800 chip). On
-# the non-W board there's no radio; S35wifi finds no wlan device and exits
-# cleanly, so shipping this file on both SKUs is harmless.
-#
-# mode:
-#   off       no WiFi (default)
-#   sta       client only (join a network on wlan0) — FULL dual-band, uses
-#             5 GHz when the upstream offers it (no AP to co-channel with)
-#   ap        hotspot only (wlan0 runs hostapd) — 2.4 GHz
-#   sta+ap    concurrent: wlan0 = STA, wlan1 = AP (AIC8800 single radio,
-#             time-multiplexed). The client is PINNED TO 2.4 GHz in this mode
-#             so it stays on the same channel as the 2.4 GHz hotspot — the one
-#             radio cannot straddle two bands. Trade-off: no 5 GHz upstream
-#             while the hotspot is on. A 5 GHz-ONLY upstream will not connect
-#             in sta+ap; use mode=sta (no hotspot) for a 5 GHz uplink.
-#
-# Managed by the rnsbox-portal WiFi tab. Apply hand-edits with:
+# Default after flashing: an OPEN hotspot (no password) named after the
+# device hostname (rnsbox-xxxxxx) on 192.168.42.1, NATted to the WAN.
+# Configure everything in the portal; apply hand edits with:
 #   /etc/init.d/S35wifi restart
+#
+# mode: off | sta | ap | sta+ap  (sta+ap pins the client to 2.4 GHz so the
+# single-radio AP stays co-channel; see the portal WiFi page for details)
 
-mode=off
+mode=ap
 
 # --- STA (client) ---
 sta_ssid=
 sta_psk=
-# sta_hidden=0      # 1 to scan for a hidden SSID (works on 2.4 GHz in sta+ap)
-# sta_country=00    # regulatory domain; 00=world
+sta_hidden=
+sta_country=
 
 # --- AP (hotspot) ---
-ap_ssid=RNSBox-AP
-ap_psk=changeme123
-# ap_channel: 1..13, or "auto" (hostapd ACS picks the least-congested 2.4GHz
-# channel; falls back to ch6 if the driver can't survey). In concurrent
-# sta+ap mode the AP always follows the STA channel regardless of this
-# (single radio) — the WiFi tab locks this field while concurrent.
+# ap_ssid empty -> the device hostname (rnsbox-xxxxxx).
+# ap_psk empty  -> OPEN network (no password). Set 8..63 chars for WPA2.
+ap_ssid=
+ap_psk=
 ap_channel=6
-# ap_htmode: ht20 (20 MHz, default) or ht40 (40 MHz — more throughput, uses
-# 2 of 3 channels). In concurrent sta+ap mode the AP inherits the STA's
-# actual channel AND width (so it runs HT40 when the client link is HT40),
-# falling back to HT20 if the HT40 AP fails to start. Locked in the UI while
-# concurrent.
 ap_htmode=ht20
-# ap_hidden=0
-ap_ip=192.168.42.1
-ap_dhcp_start=192.168.42.10
-ap_dhcp_end=192.168.42.100
-
-# --- TX power (radio-wide; applies to STA and AP) ---
-# tx_power:
-#   auto    chip maximum, independent of the regulatory database (the
-#           AIC8800 set_tx_power AUTOMATIC path requests 0x7f = the silicon
-#           per-rate ceiling). Default.
-#   <dBm>   integer 1..18 — cap power at this level (firmware still applies
-#           per-rate EVM backoff below it). Use to reduce heat/range.
-#
-# The AIC8800D80 OFDM ceiling is ~18 dBm (datasheet: 23 dBm 11b-CCK, 18 dBm
-# MCS7). All real data (11g/n/ac/ax) is OFDM, so 18 is the practical max;
-# the per-rate txpwr_lvl table in the firmware userconfig is EVM backoff,
-# not an artificial limit. Regdb never binds here (world regdom = 20 dBm on
-# 2.4 GHz, already above 18). Managed by the rnsbox-portal WiFi tab.
-tx_power=auto
+ap_hidden=
-- 
