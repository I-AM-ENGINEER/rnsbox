+++ b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/echobot.conf
@@ -0,0 +1,34 @@
+# Echo bot daemon config — read at boot by /etc/init.d/S87echobot and on every
+# start by /usr/bin/rnsbox-echobot. Edited by the portal's "Echo bot" tab;
+# changes apply on `S87echobot restart`.
+#
+# The echo bot is the box's built-in LXMF presence: it announces its LXMF
+# address (once a day by default) and echoes every message back to its sender,
+# so any LXMF client (NomadNet, Sideband, ...) can check the box is reachable
+# with zero setup. It attaches to rnsd's shared Reticulum instance and has its
+# own identity (persisted at /var/lib/rnsbox-echobot/identity.pem), so its
+# address and announced name never change across reboots or updates.
+#
+# Shipped ENABLED — unlike lxmd/nomadnet this is the out-of-the-box feature:
+# one announce a day, a small python process, no message store. The RAM floor
+# below turns "tight box" into "bot off", never "rnsd killed by OOM".
+
+enabled=yes
+
+# Seconds between announces. 86400 = once a day. The portal offers 1 h .. 7 d.
+interval=86400
+
+# Announced name. Empty uses the box's hostname (S10uuid's rnsbox-XXXXXX).
+# A 6-hex-character suffix (the first 3 bytes of the bot identity's hash,
+# stable for this box) is appended automatically and shown, not editable:
+# "echo bot rnsbox-57145f a1b2c3". A non-empty value overrides the hostname.
+name=
+
+# Announce right after start (so the box is visible again quickly after a
+# reboot, not a day later).
+announce_at_start=yes
+
+# Minimum free memory (MB, from /proc/meminfo MemAvailable) required before
+# S87echobot will start the daemon. Guards rnsd against OOM. The bot needs
+# less than lxmd (no message store), so its floor is lower.
+min_free_mb=40
