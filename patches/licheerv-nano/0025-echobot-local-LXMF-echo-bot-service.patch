@@ -0,0 +1,583 @@
+#!/usr/bin/python3
+# rnsbox-echobot — the RNSBox local LXMF echo bot.
+#
+# Announces one LXMF delivery destination on rnsd's shared Reticulum instance
+# and echoes every message it receives back to its sender — the box's
+# "reachable?" presence for any LXMF client (NomadNet, Sideband, ...),
+# testable out of the box. Started by /etc/init.d/S87echobot; configured by
+# /etc/rnsbox/echobot.conf (enabled, interval, name, announce_at_start).
+#
+# Own LXMRouter + own identity, like lxmd and nomadnet: every process on the
+# box holds its own LXMF delivery destination and they coexist over the ONE
+# shared Reticulum instance (rnsd, S82rnsd). The identity lives at
+# /var/lib/rnsbox-echobot/identity.pem on the persistent rootfs (created on
+# first start, never regenerated), so the bot's LXMF address — and the 6-hex
+# suffix of its announced name (the first 3 bytes of the identity hash) — are
+# stable across reboots and updates.
+#
+# Shared-instance race: at boot this script may run before rnsd has opened the
+# shared instance. Constructing RNS.Reticulum() then would silently start a
+# SECOND instance (no interfaces), and it could not be retried — RNS pins its
+# singleton before failing. So wait for the shared instance first, by polling
+# /proc/net/unix (@rns/<path> LISTEN) and /proc/net/tcp (127.0.0.1:37428
+# LISTEN) — the same test S85lxmd's rns_shared_up() makes — and build the one
+# RNS.Reticulum() only once the socket is there. If rnsd restarts later, the
+# client interface RNS gave us reconnects on its own.
+#
+# Forced announce: the portal runs `S87echobot announce`, which sends SIGUSR1;
+# the announce loop picks it up within its 1 s tick.
+#
+# Status for the portal: /var/lib/rnsbox-echobot/state.json (atomic rewrites),
+# read directly by the CGI, plus peers.tsv — one line per peer destination
+# heard or echoed to (per-peer RX/TX message and byte counters, delivery
+# success) for the portal's Traffic table. Announces are logged to stdout ->
+# syslog via the init script's FIFO ("LXMF announced <hash> as <name>"), so
+# `logread | grep echobot` shows the announce history.
+#
+# No propagation node: replies go DIRECT (or OPPORTUNISTIC when a ratchet is
+# known and no link exists — one packet instead of a link setup). Received
+# LXMF fields are NOT echoed (they can carry multi-megabyte file attachments;
+# an echo bot proves reachability, it must not amplify traffic). No inbound
+# stamp cost is set: requiring proof-of-work would make this box's CPU a
+# public work target.
+
+import json
+import os
+import queue
+import signal
+import sys
+import threading
+import time
+
+CONF_PATH = "/etc/rnsbox/echobot.conf"
+STATE_DIR = "/var/lib/rnsbox-echobot"
+IDENTITY_PATH = os.path.join(STATE_DIR, "identity.pem")
+STATE_PATH = os.path.join(STATE_DIR, "state.json")
+PEERS_PATH = os.path.join(STATE_DIR, "peers.tsv")
+RNS_CONFIGDIR = "/etc/reticulum"
+
+DEFAULT_NAME = "rnsbox echo bot"  # legacy literal; resolved to <hostname>
+DEFAULT_INTERVAL = 86400        # one announce per day
+MIN_INTERVAL = 600              # 10 min: an announce flood helps nobody
+MAX_INTERVAL = 30 * 86400       # 30 days
+PATH_WAIT_SECONDS = 15          # how long a reply waits for the sender's path
+
+APP_NAME = "lxmf"               # LXMF's APP_NAME; delivery = "lxmf.delivery"
+
+# Counters that survive restarts (the identity — and so the bot — does too);
+# everything identity/config-derived is rewritten on every start.
+PERSISTED_FIELDS = ("last_announce", "announce_count", "echo_ok", "echo_fail")
+
+
+def log(msg):
+    # stdout is a FIFO to logger (syslog, tag echobot[pid]) — unbuffered via
+    # PYTHONUNBUFFERED=1 from the init script.
+    try:
+        sys.stdout.write(time.strftime("%Y-%m-%d %H:%M:%S ") + msg + "\n")
+        sys.stdout.flush()
+    except Exception:
+        pass
+
+
+# ---------------------------------------------------------------- config ----
+
+def read_conf(path):
+    conf = {
+        "enabled": True,
+        "interval": DEFAULT_INTERVAL,
+        "name": DEFAULT_NAME,
+        "announce_at_start": True,
+    }
+    try:
+        with open(path, "r", encoding="utf-8", errors="replace") as f:
+            for raw in f:
+                line = raw.strip()
+                if not line or line.startswith("#") or "=" not in line:
+                    continue
+                key, val = line.split("=", 1)
+                key = key.strip().lower()
+                val = val.strip().strip('"').strip("'")
+                low = val.lower()
+                if key == "enabled":
+                    conf["enabled"] = low not in ("no", "0", "false", "off", "")
+                elif key == "interval":
+                    try:
+                        conf["interval"] = int(val)
+                    except ValueError:
+                        pass
+                elif key == "name" and val:
+                    conf["name"] = val[:64]
+                elif key == "announce_at_start":
+                    conf["announce_at_start"] = low not in ("no", "0", "false", "off", "")
+    except FileNotFoundError:
+        pass
+    except Exception as e:
+        log("could not read " + path + ": " + repr(e))
+    if conf["interval"] < MIN_INTERVAL:
+        conf["interval"] = MIN_INTERVAL
+    if conf["interval"] > MAX_INTERVAL:
+        conf["interval"] = MAX_INTERVAL
+    return conf
+
+
+def read_hostname():
+    try:
+        with open("/proc/sys/kernel/hostname", "r", encoding="utf-8") as f:
+            host = f.read().strip()
+    except OSError:
+        host = ""
+    return host if host and host != "localhost" else "rnsbox"
+
+
+def hostname_name():
+    # S10uuid renames the box to rnsbox-XXXXXX; the bot follows it. Service
+    # first, box second: "echo bot rnsbox-XXXXXX". Shipped configs used the
+    # literals "rnsbox echo bot" / "<hostname> echo bot" before this existed.
+    return ("echo bot " + read_hostname())[:64]
+
+
+def effective_name(conf):
+    name = conf["name"].strip()
+    if not name or name == DEFAULT_NAME or name == (read_hostname() + " echo bot"):
+        return hostname_name()
+    return name[:64]
+
+
+# ----------------------------------------------------------------- state ----
+
+class State:
+    # What the portal's Echo bot tab shows. Written atomically; the CGI reads
+    # it straight from disk on every page paint. RLock: announce bookkeeping
+    # runs while holding the lock and calls bump().
+    FIELDS = ("status", "detail", "lxmf_addr", "dest_hash", "suffix", "name_base",
+              "display_name", "interval", "started_at", "last_announce",
+              "announce_count", "echo_ok", "echo_fail")
+
+    def __init__(self):
+        self.lock = threading.RLock()
+        self.data = {k: (0 if k in PERSISTED_FIELDS or k in
+                         ("interval", "started_at") else
+                         ("starting" if k == "status" else ""))
+                     for k in self.FIELDS}
+        # Keep counters (and the last announce time) across restarts.
+        try:
+            with open(STATE_PATH, "r", encoding="utf-8") as f:
+                old = json.load(f)
+            for k in PERSISTED_FIELDS:
+                if isinstance(old.get(k), int) and old[k] >= 0:
+                    self.data[k] = old[k]
+        except Exception:
+            pass
+
+    def set(self, **kw):
+        with self.lock:
+            self.data.update(kw)
+            self.write()
+
+    def bump(self, key, **extra):
+        with self.lock:
+            self.data[key] = int(self.data.get(key, 0)) + 1
+            self.data.update(extra)
+            self.write()
+
+    def write(self):
+        tmp = STATE_PATH + ".tmp"
+        try:
+            with open(tmp, "w", encoding="utf-8") as f:
+                json.dump(self.data, f, indent=1)
+                f.write("\n")
+            os.replace(tmp, STATE_PATH)
+            os.chmod(STATE_PATH, 0o600)
+        except Exception as e:
+            log("could not write state.json: " + repr(e))
+
+
+# ------------------------------------------------- per-peer traffic ----------
+
+MAX_PEERS = 64          # rows in the portal's Traffic table
+FLUSH_EVERY = 5.0       # s between peers.tsv rewrites (announce-storm damper)
+
+
+class Peers:
+    # Per-destination traffic counters for the portal's Traffic table: one row
+    # per LXMF destination heard via announce or exchanged messages with.
+    # In-memory; flushed atomically to peers.tsv (newest first) at most every
+    # FLUSH_EVERY seconds and on clean stop, so an announce storm cannot hammer
+    # the flash. TSV columns: hash, name, rx_msgs, rx_bytes, tx_msgs, tx_bytes,
+    # tx_ok, tx_fail, last_seen. The name is sanitised to one tab-free ASCII
+    # line — the portal's splitter can stay dumb.
+
+    def __init__(self):
+        self.lock = threading.Lock()
+        self.peers = {}
+        self.dirty = False
+        self._next_flush = 0.0
+        try:
+            with open(PEERS_PATH, "r", encoding="utf-8", errors="replace") as f:
+                for line in f:
+                    parts = line.rstrip("\n").split("\t")
+                    if len(parts) != 9 or len(parts[0]) != 32:
+                        continue
+                    if any(c not in "0123456789abcdef" for c in parts[0]):
+                        continue
+                    try:
+                        nums = [int(x) for x in parts[2:]]
+                    except ValueError:
+                        continue
+                    if any(n < 0 for n in nums):
+                        continue
+                    self.peers[parts[0]] = dict(name=parts[1][:32],
+                                               rx_msgs=nums[0], rx_bytes=nums[1],
+                                               tx_msgs=nums[2], tx_bytes=nums[3],
+                                               tx_ok=nums[4], tx_fail=nums[5],
+                                               last_seen=nums[6])
+        except Exception:
+            pass
+
+    @staticmethod
+    def _clean_name(raw):
+        name = "".join(c if 0x20 <= ord(c) < 0x7f else " " for c in str(raw))
+        return name.replace("\t", " ").strip()[:32]
+
+    def update(self, hash_hex, name=None, **bumps):
+        with self.lock:
+            p = self.peers.get(hash_hex)
+            if p is None:
+                p = dict(name="", rx_msgs=0, rx_bytes=0, tx_msgs=0,
+                         tx_bytes=0, tx_ok=0, tx_fail=0, last_seen=0)
+                self.peers[hash_hex] = p
+            if name:
+                p["name"] = self._clean_name(name)
+            for k, d in bumps.items():
+                p[k] = int(p.get(k, 0)) + int(d)
+            p["last_seen"] = int(time.time())
+            if len(self.peers) > MAX_PEERS:
+                stale = sorted(self.peers, key=lambda h: self.peers[h]["last_seen"])
+                for h in stale[:len(self.peers) - MAX_PEERS]:
+                    self.peers.pop(h, None)
+            self.dirty = True
+
+    def heard(self, hash_hex, name):
+        # Announce path: only add a NEW row when the announce carried a usable
+        # name (binary app_data would otherwise pollute the table with noise);
+        # a name refresh for a known peer always goes through.
+        with self.lock:
+            known = hash_hex in self.peers
+        if name or known:
+            self.update(hash_hex, name=name)
+
+    def flush_if_due(self, force=False):
+        with self.lock:
+            if not self.dirty:
+                return
+            if not force and time.monotonic() < self._next_flush:
+                return
+            ordered = sorted(self.peers.items(),
+                             key=lambda kv: kv[1]["last_seen"], reverse=True)
+            body = "".join(
+                h + "\t" + p["name"] + "\t" +
+                "\t".join(str(p[k]) for k in ("rx_msgs", "rx_bytes", "tx_msgs",
+                                              "tx_bytes", "tx_ok", "tx_fail",
+                                              "last_seen")) + "\n"
+                for h, p in ordered)
+            self.dirty = False
+            self._next_flush = time.monotonic() + FLUSH_EVERY
+        tmp = PEERS_PATH + ".tmp"
+        try:
+            with open(tmp, "w", encoding="utf-8") as f:
+                f.write(body)
+            os.replace(tmp, PEERS_PATH)
+            os.chmod(PEERS_PATH, 0o600)
+        except Exception as e:
+            log("could not write peers.tsv: " + repr(e))
+
+
+# ------------------------------------------------- shared instance probe ----
+
+def config_shared_port():
+    # The shared instance's TCP port from /etc/reticulum/config (the shipped
+    # config uses the RNS default 37428; the portal's raw editor can change
+    # it, and the probe should follow).
+    port = 37428
+    try:
+        with open(os.path.join(RNS_CONFIGDIR, "config"), "r",
+                  encoding="utf-8", errors="replace") as f:
+            in_rns = False
+            for raw in f:
+                line = raw.split("#", 1)[0].strip()
+                if not line:
+                    continue
+                if line.startswith("["):
+                    in_rns = (line.lower().startswith("[reticulum]"))
+                    continue
+                if not in_rns or "=" not in line:
+                    continue
+                key, val = line.split("=", 1)
+                if key.strip().lower() == "shared_instance_port":
+                    try:
+                        port = int(val.strip())
+                    except ValueError:
+                        pass
+    except Exception:
+        pass
+    return port
+
+
+def shared_instance_up():
+    # True once rnsd's shared instance accepts clients. RNS on Linux listens
+    # on the abstract AF_UNIX socket @rns/<path> (flags 00010000 = listening,
+    # in /proc/net/unix; @rns/<path>/rpc is its RPC socket, not this), or on
+    # 127.0.0.1:<shared_instance_port> (state 0A = LISTEN) with
+    # shared_instance_type = tcp. Same test as S85lxmd/S46wanwatch
+    # rns_shared_up(); builtins only.
+    try:
+        with open("/proc/net/unix", "r") as f:
+            for line in f:
+                parts = line.split()
+                if len(parts) >= 7 and parts[3] == "00010000":
+                    path = parts[-1]
+                    if path.startswith("@rns/") and path.count("/") == 1:
+                        return True
+    except Exception:
+        pass
+    hexport = "%04X" % config_shared_port()
+    want = "0100007F:" + hexport
+    try:
+        with open("/proc/net/tcp", "r") as f:
+            for line in f:
+                parts = line.split()
+                if len(parts) >= 4 and parts[1] == want and parts[3] == "0A":
+                    return True
+    except Exception:
+        pass
+    return False
+
+
+# ------------------------------------------------------------------ bot -----
+
+def main():
+    conf = read_conf(CONF_PATH)
+    if not conf["enabled"]:
+        log("disabled in " + CONF_PATH + " (enabled=no); exiting")
+        return 0
+
+    os.makedirs(STATE_DIR, exist_ok=True)
+    state = State()
+    peers = Peers()
+    state.set(status="waiting", detail="waiting for rnsd's shared instance",
+              name_base=effective_name(conf), interval=conf["interval"],
+              started_at=int(time.time()))
+
+    # ---- wait for rnsd's shared instance (S82rnsd may still be starting) ----
+    waited = 0
+    while not shared_instance_up():
+        if waited % 60 == 0:
+            log("waiting for rnsd's shared instance (" + str(waited) + "s)")
+        time.sleep(1)
+        waited += 1
+    log("rnsd's shared instance is up (waited " + str(waited) + "s)")
+
+    import RNS
+    import LXMF
+
+    # Syslog should hold more than our own lines: paths, interface connects.
+    RNS.loglevel = RNS.LOG_INFO
+
+    # Attach to rnsd's shared instance — never a second transport stack.
+    RNS.Reticulum(configdir=RNS_CONFIGDIR)
+
+    # ---- identity: persistent, so address + name suffix never change -------
+    if os.path.isfile(IDENTITY_PATH) and os.path.getsize(IDENTITY_PATH) > 0:
+        identity = RNS.Identity(create_keys=False)
+        identity.load(IDENTITY_PATH)
+        log("identity loaded from " + IDENTITY_PATH)
+    else:
+        identity = RNS.Identity(create_keys=True)
+        tmp = IDENTITY_PATH + ".tmp"
+        with open(tmp, "wb") as f:
+            f.write(identity.get_private_key())
+        os.chmod(tmp, 0o600)
+        os.replace(tmp, IDENTITY_PATH)
+        log("new identity created at " + IDENTITY_PATH)
+
+    suffix = identity.hash[:3].hex()
+    display_name = (effective_name(conf) + " " + suffix).strip()
+    state.set(status="waiting", detail="attaching to the shared instance",
+              lxmf_addr=identity.hash.hex(), dest_hash="", suffix=suffix,
+              name_base=effective_name(conf), display_name=display_name,
+              interval=conf["interval"], started_at=int(time.time()))
+    log("LXMF address " + identity.hash.hex() + " (\"" + display_name + "\")")
+
+    # ---- LXMF router + delivery destination --------------------------------
+    router = LXMF.LXMRouter(identity=identity, storagepath=STATE_DIR)
+    delivery = router.register_delivery_identity(identity, display_name=display_name)
+    if delivery is None:
+        state.set(status="error", detail="could not register the delivery destination")
+        log("FATAL: could not register the LXMF delivery destination")
+        return 1
+
+    announce_wanted = threading.Event()
+    stop_wanted = threading.Event()
+    replies = queue.Queue()
+
+    def on_message(lxmessage):
+        # Runs on LXMF's receive path: enqueue and return immediately.
+        replies.put(lxmessage)
+
+    router.register_delivery_callback(on_message)
+
+    # Peer names for the Traffic table come from the announces the transport
+    # already hears (LXMF clients carry their display name in app_data).
+    def on_announce(*a):
+        # RNS >= 0.6.6 passes (destination_hash, announced_identity, app_data);
+        # ancient stacks prefixed an aspect — index from the end either way.
+        try:
+            destination_hash, app_data = a[-3], a[-1]
+            name = ""
+            if app_data:
+                try:
+                    name = bytes(app_data).decode("utf-8", "replace")
+                except Exception:
+                    name = ""
+            peers.heard(destination_hash.hex(), name.strip())
+        except Exception:
+            pass
+
+    try:
+        RNS.Transport.register_announce_handler(on_announce)
+    except Exception as e:
+        log("could not register the announce handler: " + repr(e))
+
+    def do_announce():
+        try:
+            router.announce(delivery.hash)
+        except Exception as e:
+            log("announce failed: " + repr(e))
+            return
+        with state.lock:
+            state.data["last_announce"] = int(time.time())
+            state.bump("announce_count")
+        log("LXMF announced " + delivery.hash.hex() + " as \"" + display_name + "\"")
+
+    def announce_loop():
+        # Announce at start, then every `interval` seconds (monotonic clock:
+        # a wall-clock step must not skip or double an announce), plus on
+        # SIGUSR1 (the portal's "Announce now"). Also drains the peers.tsv
+        # flush (rate-limited inside Peers).
+        if conf["announce_at_start"]:
+            time.sleep(1)   # let RNS finish bringing interfaces up
+            do_announce()
+        next_at = time.monotonic() + conf["interval"]
+        while not stop_wanted.is_set():
+            if announce_wanted.is_set():
+                announce_wanted.clear()
+                do_announce()
+                next_at = time.monotonic() + conf["interval"]
+            elif time.monotonic() >= next_at:
+                do_announce()
+                next_at = time.monotonic() + conf["interval"]
+            peers.flush_if_due()
+            time.sleep(1)
+
+    def echo_worker():
+        # Replies from a worker thread: waiting for the sender's path must
+        # never stall LXMF's delivery pipeline.
+        while not stop_wanted.is_set():
+            try:
+                msg = replies.get(timeout=1)
+            except queue.Empty:
+                continue
+            src = getattr(msg, "source_hash", None)
+            content = getattr(msg, "content", b"")
+            title = getattr(msg, "title", "") or ""
+            try:
+                content = content.decode("utf-8", errors="replace") if isinstance(content, bytes) else content
+            except Exception:
+                content = str(content)
+            if src is None:
+                state.bump("echo_fail")
+                continue
+            srchex = src.hex()
+            rx_bytes = len(content)
+            peers.update(srchex, rx_msgs=1, rx_bytes=rx_bytes)
+            log("received a message from " + srchex + " (" + str(rx_bytes) + " bytes); echoing back")
+            try:
+                dest_identity = RNS.Identity.recall(src)
+                if dest_identity is None:
+                    RNS.Transport.request_path(src)
+                    deadline = time.time() + PATH_WAIT_SECONDS
+                    while dest_identity is None and time.time() < deadline:
+                        time.sleep(0.2)
+                        dest_identity = RNS.Identity.recall(src)
+                if dest_identity is None:
+                    log("no path/identity for " + srchex + " — reply dropped")
+                    state.bump("echo_fail")
+                    continue
+
+                dest = RNS.Destination(dest_identity, RNS.Destination.OUT,
+                                       RNS.Destination.SINGLE, APP_NAME, "delivery")
+                # DIRECT by default; OPPORTUNISTIC when there is no link yet
+                # but a ratchet is known — one packet instead of a link setup.
+                method = LXMF.LXMessage.DIRECT
+                if (not router.delivery_link_available(src)
+                        and RNS.Identity.current_ratchet_id(src) is not None):
+                    method = LXMF.LXMessage.OPPORTUNISTIC
+
+                reply = LXMF.LXMessage(destination=dest, source=delivery,
+                                       content=content, title=title,
+                                       desired_method=method)
+
+                def on_delivered(lxm, s=src):
+                    log("echo delivered to " + s.hex())
+                    state.bump("echo_ok")
+                    peers.update(s.hex(), tx_ok=1)
+
+                def on_failed(lxm, s=src):
+                    log("echo to " + s.hex() + " failed")
+                    state.bump("echo_fail")
+                    peers.update(s.hex(), tx_fail=1)
+
+                reply.register_delivery_callback(on_delivered)
+                reply.register_failed_callback(on_failed)
+                router.handle_outbound(reply)
+                peers.update(srchex, tx_msgs=1,
+                             tx_bytes=len(content) + len(title or ""))
+            except Exception as e:
+                log("echo to " + srchex + " failed: " + repr(e))
+                state.bump("echo_fail")
+
+    def on_usr1(signum, frame):
+        announce_wanted.set()
+
+    def on_term(signum, frame):
+        stop_wanted.set()
+
+    signal.signal(signal.SIGUSR1, on_usr1)
+    signal.signal(signal.SIGTERM, on_term)
+    signal.signal(signal.SIGINT, on_term)
+
+    for t in (threading.Thread(target=announce_loop, daemon=True),
+              threading.Thread(target=echo_worker, daemon=True)):
+        t.start()
+
+    state.set(status="running", detail="announcing and echoing",
+              lxmf_addr=identity.hash.hex(), dest_hash=delivery.hash.hex(),
+              suffix=suffix, name_base=effective_name(conf), display_name=display_name,
+              interval=conf["interval"], started_at=int(time.time()))
+    log("echo bot running: address " + delivery.hash.hex() +
+        ", announce interval " + str(conf["interval"]) + "s")
+
+    # Main thread just waits; RNS's own threads carry the traffic.
+    try:
+        while not stop_wanted.is_set():
+            time.sleep(0.5)
+    finally:
+        peers.flush_if_due(force=True)
+        state.set(status="stopped", detail="stopped")
+        log("stopping")
+
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

