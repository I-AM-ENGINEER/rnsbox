From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Taixin Reverse <reverse@taixin.local>
Date: Sat, 17 Oct 2026 18:28:56 +0300
Subject: [PATCH] bluezero: build python-gobject (gi) so the GATT server exists

bluezero imports gi.repository.GLib; without PyGObject the driver
logs "Bluezero not available, peripheral mode disabled" and the box
never registers a GATT server or a real LE advertisement - phones
(Columba) can never discover it, only the box can attach outbound.
Buildroot gates gobject-introspection/python-gobject on glibc; the
rv64 rootfs is musl. Alpine ships PyGObject on musl, so drop the
gate and enable BR2_PACKAGE_PYTHON_GOBJECT in the SG200X defconfigs.
---
 buildroot/configs/cvitek_SG200X_32bit_defconfig        | 1 +
 buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig | 1 +
 buildroot/package/gobject-introspection/Config.in      | 6 ++----
 buildroot/package/python-gobject/Config.in             | 1 -
 4 files changed, 4 insertions(+), 5 deletions(-)

diff --git a/buildroot/configs/cvitek_SG200X_32bit_defconfig b/buildroot/configs/cvitek_SG200X_32bit_defconfig
index 8ad3389e6..3b05df78b 100644
--- a/buildroot/configs/cvitek_SG200X_32bit_defconfig
+++ b/buildroot/configs/cvitek_SG200X_32bit_defconfig
@@ -403,3 +403,4 @@ BR2_TARGET_TZ_ZONELIST="default"
 BR2_TARGET_LOCALTIME="Etc/UTC"
 BR2_PACKAGE_SUDO=y
 BR2_PACKAGE_ZSH=y
+BR2_PACKAGE_PYTHON_GOBJECT=y
diff --git a/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig b/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig
index c17c1bbcc..0f9a22fab 100644
--- a/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig
+++ b/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig
@@ -4769,3 +4769,4 @@ BR2_PACKAGE_WIRELESS_REGDB=y
 BR2_PRIMARY_SITE="https://mirror.nju.edu.cn/buildroot"
 BR2_PACKAGE_SUDO=y
 BR2_PACKAGE_ZSH=y
+BR2_PACKAGE_PYTHON_GOBJECT=y
diff --git a/buildroot/package/gobject-introspection/Config.in b/buildroot/package/gobject-introspection/Config.in
index 42250eb77..422c458fb 100644
--- a/buildroot/package/gobject-introspection/Config.in
+++ b/buildroot/package/gobject-introspection/Config.in
@@ -14,7 +14,6 @@ config BR2_PACKAGE_GOBJECT_INTROSPECTION
 	# can be verified.
 	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_4_9
 	depends on BR2_HOST_GCC_AT_LEAST_8 # host-qemu
-	depends on BR2_TOOLCHAIN_USES_GLIBC
 	# gobject-introspection does not require python3 to run on the
 	# target; however, because the tools run in a qemu wrapper, a
 	# cross-compiled python3 must be installed to staging. As there
@@ -42,9 +41,8 @@ comment "gobject-introspection needs python3"
 	depends on !BR2_PACKAGE_PYTHON3
 	depends on BR2_PACKAGE_GOBJECT_INTROSPECTION_ARCH_SUPPORTS
 
-comment "gobject-introspection needs a glibc toolchain, gcc >= 4.9, host gcc >= 8"
+comment "gobject-introspection needs gcc >= 4.9, host gcc >= 8"
 	depends on BR2_USE_MMU
 	depends on BR2_PACKAGE_GOBJECT_INTROSPECTION_ARCH_SUPPORTS
-	depends on !BR2_TOOLCHAIN_USES_GLIBC || \
-		!BR2_TOOLCHAIN_GCC_AT_LEAST_4_9 || \
+	depends on !BR2_TOOLCHAIN_GCC_AT_LEAST_4_9 || \
 		!BR2_HOST_GCC_AT_LEAST_8
diff --git a/buildroot/package/python-gobject/Config.in b/buildroot/package/python-gobject/Config.in
index 335453563..aa7ca47b1 100644
--- a/buildroot/package/python-gobject/Config.in
+++ b/buildroot/package/python-gobject/Config.in
@@ -4,7 +4,6 @@ config BR2_PACKAGE_PYTHON_GOBJECT
 	depends on BR2_PACKAGE_GOBJECT_INTROSPECTION_ARCH_SUPPORTS # gobject-introspection
 	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_4_9 # gobject-introspection
 	depends on BR2_HOST_GCC_AT_LEAST_8 # gobject-introspection -> host-qemu
-	depends on BR2_TOOLCHAIN_USES_GLIBC # gobject-introspection
 	select BR2_PACKAGE_GOBJECT_INTROSPECTION
 	select BR2_PACKAGE_LIBGLIB2
 	help
-- 
2.43.0

