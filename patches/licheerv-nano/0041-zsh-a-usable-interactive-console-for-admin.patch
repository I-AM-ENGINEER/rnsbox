From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Taixin Reverse <reverse@taixin.local>
Date: Sat, 17 Oct 2026 17:13:48 +0300
Subject: [PATCH 3/3] zsh: a usable interactive console for admin

Ship zsh, a colored prompt/history .zshrc in the skeleton, and make
the admin account (users table) log in with it. Root keeps /bin/sh.
---
 .../board/cvitek/SG200X/overlay/etc/skel/.zshrc      | 12 ++++++++++++
 buildroot/configs/cvitek_SG200X_32bit_defconfig      |  1 +
 .../configs/cvitek_SG200X_musl_riscv64_defconfig     |  1 +
 3 files changed, 14 insertions(+)
 create mode 100644 buildroot/board/cvitek/SG200X/overlay/etc/skel/.zshrc

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/skel/.zshrc b/buildroot/board/cvitek/SG200X/overlay/etc/skel/.zshrc
new file mode 100644
index 000000000..68b144240
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/skel/.zshrc
@@ -0,0 +1,12 @@
+# RNSBox interactive shell defaults
+HISTFILE=$HOME/.zsh_history
+HISTSIZE=2000
+SAVEHIST=2000
+setopt share_history hist_ignore_all_dups hist_reduce_blanks
+autoload -Uz colors && colors
+PROMPT="%F{green}%n@%m%f:%F{blue}%~%f$ "
+RPROMPT="%F{yellow}%D{%H:%M}%f"
+alias ls="ls --color=auto"
+alias ll="ls -alF --color=auto"
+alias l="ls -la --color=auto"
+alias grep="grep --color=auto"
diff --git a/buildroot/configs/cvitek_SG200X_32bit_defconfig b/buildroot/configs/cvitek_SG200X_32bit_defconfig
index bee67a9a4..8ad3389e6 100644
--- a/buildroot/configs/cvitek_SG200X_32bit_defconfig
+++ b/buildroot/configs/cvitek_SG200X_32bit_defconfig
@@ -402,3 +402,4 @@ BR2_TARGET_TZ_INFO=y
 BR2_TARGET_TZ_ZONELIST="default"
 BR2_TARGET_LOCALTIME="Etc/UTC"
 BR2_PACKAGE_SUDO=y
+BR2_PACKAGE_ZSH=y
diff --git a/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig b/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig
index 48ed512cb..c17c1bbcc 100644
--- a/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig
+++ b/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig
@@ -4768,3 +4768,4 @@ BR2_PACKAGE_WIRELESS_REGDB=y
 # still falls back to the upstream sites automatically.
 BR2_PRIMARY_SITE="https://mirror.nju.edu.cn/buildroot"
 BR2_PACKAGE_SUDO=y
+BR2_PACKAGE_ZSH=y
