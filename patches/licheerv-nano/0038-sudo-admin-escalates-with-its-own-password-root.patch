From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Taixin Reverse <reverse@taixin.local>
Date: Sat, 17 Oct 2026 16:39:48 +0300
Subject: [PATCH] sudo: admin escalates with its own password; root SSH stays
 closed

The image policy was no-root-over-SSH but there was no legitimate
elevation path at all - no sudo binary, no sudoers - so any post-boot
operation that needs root (devmem for the radio registers, module
reload, init script restarts) was impossible over SSH. Ship sudo and
a static sudoers granting the admin account (the one the portal
manages) ALL=(ALL) ALL; PermitRootLogin stays no. BR2_PACKAGE_SUDO=y
goes into all three SG200X buildroot defconfigs; build.sh enforces
the sudoers 0440 mode at build time (git cannot carry that mode).
---
 buildroot/board/cvitek/SG200X/overlay/etc/sudoers      | 8 ++++++++
 buildroot/configs/cvitek_SG200X_32bit_defconfig        | 1 +
 buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig | 1 +
 3 files changed, 10 insertions(+)
 create mode 100644 buildroot/board/cvitek/SG200X/overlay/etc/sudoers

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/sudoers b/buildroot/board/cvitek/SG200X/overlay/etc/sudoers
new file mode 100644
index 000000000..66b3b1a34
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/sudoers
@@ -0,0 +1,8 @@
+# RNSBox: root SSH login is closed by design. The admin account (its
+# password is managed in the portal / at SSH-enable time) escalates
+# with sudo using its own login password.
+Defaults env_reset
+Defaults env_keep += "PYTHONUNBUFFERED"
+root ALL=(ALL) ALL
+admin ALL=(ALL) ALL
+%wheel ALL=(ALL) ALL
diff --git a/buildroot/configs/cvitek_SG200X_32bit_defconfig b/buildroot/configs/cvitek_SG200X_32bit_defconfig
index ffa8fc067..bee67a9a4 100644
--- a/buildroot/configs/cvitek_SG200X_32bit_defconfig
+++ b/buildroot/configs/cvitek_SG200X_32bit_defconfig
@@ -401,3 +401,4 @@ BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(TOPDIR)/board/cvitek/SG200X/busybox
 BR2_TARGET_TZ_INFO=y
 BR2_TARGET_TZ_ZONELIST="default"
 BR2_TARGET_LOCALTIME="Etc/UTC"
+BR2_PACKAGE_SUDO=y
diff --git a/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig b/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig
index c0f454371..48ed512cb 100644
--- a/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig
+++ b/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig
@@ -4767,3 +4767,4 @@ BR2_PACKAGE_WIRELESS_REGDB=y
 # can be unreliable). NJU mirrors the full buildroot sources tree; buildroot
 # still falls back to the upstream sites automatically.
 BR2_PRIMARY_SITE="https://mirror.nju.edu.cn/buildroot"
+BR2_PACKAGE_SUDO=y
-- 
