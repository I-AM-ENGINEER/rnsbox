From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Taixin Reverse <reverse@taixin.local>
Date: Sat, 17 Oct 2026 17:46:42 +0300
Subject: [PATCH] wifi: default hotspot password "reticulum" instead of an open
 network

An open AP on first boot is an instant hole: the box is deployed before
anyone opens the portal. Ship WPA2 with the documented default
password "reticulum" (the operator is told to change it on first
configuration). ap_psk is the normal portal-managed field, so this is
only the factory default.
---
 .../board/cvitek/SG200X/overlay/etc/rnsbox/wifi.conf  | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/wifi.conf b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/wifi.conf
index 7f9de45c1..fce9aa2ea 100644
--- a/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/wifi.conf
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/wifi.conf
@@ -1,8 +1,9 @@
 # RNSBox WiFi config — read at boot by /etc/init.d/S35wifi, managed by
 # the rnsbox-portal WiFi tab.
 #
-# Default after flashing: an OPEN hotspot (no password) named after the
-# device hostname (rnsbox-xxxxxx) on 192.168.42.1, NATted to the WAN.
+# Default after flashing: a WPA2 hotspot named after the device hostname
+# (rnsbox-xxxxxx), password "reticulum", on 192.168.42.1, NATted to
+# the WAN. Change it in the portal before the box leaves the bench.
 # Configure everything in the portal; apply hand edits with:
 #   /etc/init.d/S35wifi restart
 #
@@ -19,9 +20,11 @@ sta_country=
 
 # --- AP (hotspot) ---
 # ap_ssid empty -> the device hostname (rnsbox-xxxxxx).
-# ap_psk empty  -> OPEN network (no password). Set 8..63 chars for WPA2.
+# ap_psk: WPA2 passphrase (8..63 chars). The default "reticulum"
+# keeps a freshly flashed, not-yet-configured box off the open air;
+# change it in the portal. Empty would mean an OPEN network.
 ap_ssid=
-ap_psk=
+ap_psk=reticulum
 ap_channel=6
 ap_htmode=ht20
 ap_hidden=
