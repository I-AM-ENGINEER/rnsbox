From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: agent <agent@local>
Date: Thu, 15 Oct 2026 22:24:18 +0300
Subject: [PATCH 3/3] autoupdater: wire rnsbox-sysupdate into cron + buildroot

- S84cron: hourly rnsbox-sysupdate tick (reconcile + jittered schedule),
  gated on enabled= in /etc/rnsbox/update.conf
- defconfig: BR2_PACKAGE_RNSBOX_UPDATE=y (the synced shared package)
---
 .../cvitek/SG200X/overlay/etc/init.d/S84cron    | 17 +++++++++++++++++
 .../cvitek_SG200X_musl_riscv64_defconfig        |  1 +
 2 files changed, 18 insertions(+)

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S84cron b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S84cron
index 77fc3db..ab0226e 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S84cron
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S84cron
@@ -21,12 +21,25 @@ cfg() {
 	  | sed -E 's/[[:space:]]*$//'
 }
 
+# read a key from a flat key=value conf file other than $CONF (cfg2 FILE KEY)
+cfg2() {
+	grep -E "^[[:space:]]*$2[[:space:]]*=" "$1" 2>/dev/null | tail -1 \
+	  | sed -E "s/^[^=]*=[[:space:]]*//" | sed -E 's/[[:space:]]*#.*$//' \
+	  | sed -E 's/[[:space:]]*$//'
+}
+
 gen_crontab() {
 	mkdir -p "$CRONDIR"
 	days=$(cfg rnsd_restart_days)
 	case "$days" in ''|*[!0-9]*) days=0 ;; esac
 	uc=$(cfg update_check)
 	case "$uc" in no|No|NO|0|false|off) uc=no ;; *) uc=yes ;; esac
+	# A/B system-update tick: rnsbox-sysupdate reconciles a pending slot flip,
+	# then honours the 7-14 day jittered schedule (next_check stored in
+	# update.conf by the worker). enabled=no there (or the portal Updates tab
+	# master switch) takes it out of the crontab entirely.
+	sysupd=$(cfg2 /etc/rnsbox/update.conf enabled)
+	[ "$sysupd" = no ] || sysupd=yes
 	{
 		echo "# Auto-generated by S84cron from $CONF — do not hand-edit."
 		echo "# (edit /etc/rnsbox/cron.conf or use the portal Reticulum tab)"
@@ -39,6 +52,10 @@ gen_crontab() {
 			# daily at 05:00: notify-only check for a newer rnsd (offline-safe)
 			echo "0 5 * * * /usr/sbin/rnsbox-update-check >> $LOG 2>&1"
 		fi
+		if [ "$sysupd" = yes ] && [ -x /usr/sbin/rnsbox-sysupdate ]; then
+			# hourly at :43 — A/B system-update tick (reconcile + schedule)
+			echo "43 * * * * /usr/sbin/rnsbox-sysupdate tick >> $LOG 2>&1"
+		fi
 	} > "$CRONTAB"
 	chmod 600 "$CRONTAB"
 	[ "$days" -ge 1 ] 2>/dev/null && echo "S84cron: rnsd auto-restart every $days day(s) at 04:00" \
diff --git a/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig b/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig
index 7634161..1b28736 100644
--- a/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig
+++ b/buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig
@@ -4724,6 +4724,7 @@ BR2_PACKAGE_PYTHON_RNS=y
 BR2_PACKAGE_PYTHON_LXMF=y
 BR2_PACKAGE_PYTHON_NOMADNET=y
 BR2_PACKAGE_RNSBOX_PORTAL=y
+BR2_PACKAGE_RNSBOX_UPDATE=y
 
 # === RNSBox W variant: AIC8800 WiFi userspace stack ===
 # Firmware blobs (lxowalle repo) install to /usr/lib/firmware/aic8800_sdio/,
-- 
