From 10a117534384dc564df841cac536d0ecf32d71ef Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Sat, 17 Oct 2026 00:00:00 +0300
Subject: [PATCH] rnsd: clear the outage flag on every successful start

The portal's rnsd DOWN badge reads /run/rnsd-down-since, which only
wanwatch's 10 s tick cleared. A portal-initiated restart (or a dead
wanwatch) left the flag behind: the portal kept showing "rnsd DOWN n
min" next to a live pid. S82rnsd now clears the flag on every
successful start (boot, wanwatch kick, portal Restart) and wanwatch
logs the recovery instead of clearing silently.
---
 .../board/cvitek/SG200X/overlay/etc/init.d/S46wanwatch      | 6 +++++-
 buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd    | 6 ++++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S46wanwatch b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S46wanwatch
index 56b124c..e17ab5a 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S46wanwatch
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S46wanwatch
@@ -64,7 +64,11 @@ loop() {
 			countable=1
 		fi
 		if [ -z "$countable" ] 		   || { [ -f "$RNSD_PIDFILE" ] && kill -0 "$(cat "$RNSD_PIDFILE")" 2>/dev/null; } 		   || pidof -x rnsd >/dev/null 2>&1; then
-			rm -f /run/rnsd-down-since
+			if [ -f /run/rnsd-down-since ]; then
+				since=$(cat /run/rnsd-down-since 2>/dev/null)
+				log "rnsd back up — outage streak since ${since:-?}s cleared"
+				rm -f /run/rnsd-down-since
+			fi
 		else
 			since=
 			{ read -r since </run/rnsd-down-since; } 2>/dev/null
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd
index e691f0f..523734f 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd
@@ -50,6 +50,12 @@ start() {
 	echo "$PID" > "$PIDFILE"
 	sleep 0.3
 	if kill -0 "$PID" 2>/dev/null; then
+		# A successful start is THE authoritative end of any outage: clear
+		# the wanwatch down-streak flag so the portal never shows a stale
+		# "rnsd DOWN" badge next to a live pid (previously only wanwatch's
+		# next 10 s tick cleared it — which a dead wanwatch never did, and
+		# a portal-initiated restart left the flag behind entirely).
+		rm -f /run/rnsd-down-since
 		echo "OK (pid $PID)"
 	else
 		echo "FAIL (see $LOG)"
-- 
