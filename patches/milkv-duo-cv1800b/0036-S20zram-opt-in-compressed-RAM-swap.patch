From 31f608481901bb94816f95798b65aaa3afb1e962 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Thu, 15 Oct 2026 22:00:40 +0300
Subject: [PATCH] S20zram: compressed-RAM swap, auto-enabled below 256MB

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S20zram b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S20zram
new file mode 100755
index 0000000..b1bb09054d43
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S20zram
@@ -0,0 +1,86 @@
+#!/bin/sh
+# S20zram — compressed-RAM swap (zram), the ONLY legal swap on RNSBox:
+# swap on the SD card is forbidden (it kills the card). The zram device is
+# built into the cv1800b kernel (ZSMALLOC+ZRAM+CRYPTO_LZ4); on the 256/512MB
+# mars boards the same script is a no-op unless enabled (no zram in their
+# kernel, swapon fails cleanly, we exit 0).
+#
+# Default: AUTO — always ON for boards with less than 256MB of RAM (owner
+# decision: the 64MB board ships with the compressed-RAM cushion out of the
+# box), OFF on 256MB+. Explicit override in /etc/rnsbox/zram.conf:
+#   enabled=yes   force on
+#   enabled=no    force off
+#
+# Sizing: 25% of MemTotal, capped 16..32MB — enough to absorb the rnsd RSS
+# import spike without letting a leaking daemon chew the whole DRAM.
+
+CONF=/etc/rnsbox/zram.conf
+ZDEV=/dev/zram0
+SWAPPINESS=100
+
+cfg() {
+	grep -E "^[[:space:]]*$1[[:space:]]*=" "$CONF" 2>/dev/null | tail -1 \
+	  | sed -E "s/^[^=]*=[[:space:]]*//" | tr -d '"'
+}
+
+# resolve the enable decision: yes/no. Explicit config wins; AUTO (unset)
+# means on below 256MB of RAM, off otherwise.
+want_zram() {
+	mode="$(cfg enabled)"
+	case "$mode" in
+		yes|true|1|on)  echo yes; return ;;
+		no|false|0|off) echo no;  return ;;
+	esac
+	MEM_KB="$(awk '/MemTotal/{print $2}' /proc/meminfo)"
+	if [ -n "$MEM_KB" ] && [ "$MEM_KB" -lt 262144 ]; then
+		echo yes
+	else
+		echo no
+	fi
+}
+
+start() {
+	case "$(want_zram)" in
+		yes) ;;
+		*) echo "S20zram: disabled (auto: 256MB+ RAM; override in /etc/rnsbox/zram.conf)"; exit 0 ;;
+	esac
+
+	if ! [ -e "$ZDEV" ]; then
+		echo "S20zram: no $ZDEV (kernel lacks zram) - skipping"
+		exit 0
+	fi
+
+	SIZE_MB="$(cfg size_mb)"
+	[ -n "$SIZE_MB" ] || SIZE_MB=$(( $(awk '/MemTotal/{print int($2/1024/4)}' /proc/meminfo) ))
+	[ "$SIZE_MB" -ge 16 ] || SIZE_MB=16
+	[ "$SIZE_MB" -le 32 ] || SIZE_MB=32
+
+	if swapon -s 2>/dev/null | grep -q "$ZDEV"; then
+		echo "S20zram: already on"
+		exit 0
+	fi
+
+	echo "S20zram: ${SIZE_MB}MB lz4 zram swap"
+	echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null
+	echo $((SIZE_MB*1024*1024)) > /sys/block/zram0/disksize || {
+		echo "S20zram: cannot set disksize"; exit 1; }
+	mkswap "$ZDEV" >/dev/null 2>&1 || { echo "S20zram: mkswap failed"; exit 1; }
+	swapon -p 10 "$ZDEV" || { echo "S20zram: swapon failed"; exit 1; }
+	# zram-only swap wants aggressive early page-out: moving a cold page to
+	# compressed RAM costs CPU but frees real pages; there is no SD to wear.
+	sysctl -q -w vm.swappiness=$SWAPPINESS >/dev/null 2>&1
+}
+
+stop() {
+	if swapon -s 2>/dev/null | grep -q "$ZDEV"; then
+		swapoff "$ZDEV"
+		echo "reset" > /sys/block/zram0/reset 2>/dev/null
+	fi
+}
+
+case "${1:-start}" in
+	start)   start ;;
+	stop)    stop ;;
+	restart) stop; start ;;
+	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
+esac
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/zram.conf b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/zram.conf
new file mode 100644
index 0000000..9f8f7ab7c425
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/zram.conf
@@ -0,0 +1,8 @@
+# zram swap (compressed RAM) - the only legal swap on RNSBox.
+# SD swap is forbidden: it wears the card out.
+# Default: AUTO - on for boards with less than 256MB of RAM (the 64MB board
+# ships with the cushion out of the box), off on 256MB+. Override:
+#   enabled=yes   force on (any board)
+#   enabled=no    force off
+#enabled=auto
+# size_mb: omitted = 25% of MemTotal, clamped 16..32
-- 
