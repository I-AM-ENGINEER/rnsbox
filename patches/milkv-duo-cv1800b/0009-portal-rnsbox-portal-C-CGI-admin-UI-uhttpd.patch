+<h2>Network</h2>
+<p class="muted">WAN: <strong>__WAN__</strong> &middot; LAN: <strong>usb0</strong> &middot; default gateway: <strong>__GATEWAY__</strong></p>
+
+<section class="card">
+  <h3>WAN uplink</h3>
+  <p class="muted">Which interface reaches the internet, and how it gets its
+  address. NAT masquerade + the default route follow this choice.
+  <strong>wlan0</strong> requires the WiFi client to be connected (WiFi tab →
+  mode <em>sta</em> or <em>sta+ap</em>) and is always DHCP-addressed by the WiFi
+  stack — the static fields below apply to <strong>eth0</strong> only.</p>
+  <form method="post" action="__BASE__/network/wan">
+    <label>Interface
+      <select name="wan">
+        <option value="eth0"  __SEL_ETH0__>eth0 — wired Ethernet</option>
+        <option value="wlan0" __SEL_WLAN0__>wlan0 — WiFi client</option>
+      </select>
+    </label>
+    <label>Addressing
+      <select name="wan_mode" id="wan_mode" onchange="wanModeToggle()">
+        <option value="dhcp"   __SEL_DHCP__>DHCP (automatic)</option>
+        <option value="static" __SEL_STATIC__>Static IP</option>
+      </select>
+    </label>
+    <div id="wan_static" style="__WAN_STATIC_DISPLAY__">
+      <label>IP address
+        <input type="text" name="wan_address" value="__WAN_ADDRESS__" placeholder="192.168.1.50">
+      </label>
+      <label>Netmask (CIDR prefix, 1–32)
+        <input type="number" name="wan_prefix" min="1" max="32" value="__WAN_PREFIX__" placeholder="24">
+      </label>
+      <label>Gateway
+        <input type="text" name="wan_gateway" value="__WAN_GATEWAY__" placeholder="192.168.1.1">
+      </label>
+      <label>DNS servers (space- or comma-separated)
+        <input type="text" name="wan_dns" value="__WAN_DNS__" placeholder="1.1.1.1 8.8.8.8">
+      </label>
+    </div>
+    <button type="submit" class="btn-primary">Set WAN</button>
+  </form>
+  <script>
+    function wanModeToggle(){
+      var m = document.getElementById('wan_mode').value;
+      document.getElementById('wan_static').style.display = (m === 'static') ? '' : 'none';
+    }
+  </script>
+</section>
+
+<section class="card">
+  <h3>Port forwards (WAN → LAN)</h3>
+  <p class="muted">Inbound TCP/UDP traffic arriving on the WAN port is DNAT'd to the LAN host:port. The matching FORWARD rule is added automatically.</p>
+  <table class="data">
+    <thead>
+      <tr><th>Proto</th><th>WAN port</th><th>LAN target</th><th>Comment</th><th></th></tr>
+    </thead>
+    <tbody>
+      __FORWARDS_ROWS__
+    </tbody>
+  </table>
+
+  <form method="post" action="__BASE__/network/portforward/add" class="row-form">
+    <select name="proto" required>
+      <option value="tcp">TCP</option>
+      <option value="udp">UDP</option>
+    </select>
+    <input name="wan_port" type="number" min="1" max="65535" placeholder="WAN port" required>
+    <input name="lan_ip" type="text" placeholder="LAN IP (e.g. 10.42.0.10)" required>
+    <input name="lan_port" type="number" min="1" max="65535" placeholder="LAN port" required>
+    <input name="comment" type="text" placeholder="comment (optional)">
+    <button type="submit" class="btn-primary">Add</button>
+  </form>
+</section>
+
+<section class="card">
+  <h3>Open ports (services on this router exposed on WAN)</h3>
+  <p class="muted">Allows inbound connections on the WAN to services bound on this device. <strong>SSH (22)</strong> and the <strong>web UI (80)</strong> are open by default &mdash; remove them to close WAN access (the LAN/<code>usb0</code> side always stays open). Add rnsd's TCPServerInterface port (4242) here for external Reticulum peers.</p>
+  <table class="data">
+    <thead>
+      <tr><th>Proto</th><th>Port</th><th>Comment</th><th></th></tr>
+    </thead>
+    <tbody>
+      __OPENPORTS_ROWS__
+    </tbody>
+  </table>
+
+  <form method="post" action="__BASE__/network/openport/add" class="row-form">
+    <select name="proto" required>
+      <option value="tcp">TCP</option>
+      <option value="udp">UDP</option>
+    </select>
+    <input name="port" type="number" min="1" max="65535" placeholder="Port" required>
+    <input name="comment" type="text" placeholder="comment (optional)">
+    <button type="submit" class="btn-primary">Add</button>
+  </form>
+</section>
+
+<section class="card">
+  <h3>LAN clients (DHCP leases)</h3>
+  <table class="data">
+    <thead>
+      <tr><th>IP</th><th>MAC</th><th>Name</th><th>Expires (epoch)</th></tr>
+    </thead>
+    <tbody>
+      __LEASES_ROWS__
+    </tbody>
+  </table>
+</section>
+
+<section class="card">
+  <h3>All interfaces</h3>
+  <table class="data">
+    <thead>
+      <tr><th>Iface</th><th>State</th><th>Address</th><th>MAC</th><th>MTU</th><th>RX / TX</th></tr>
+    </thead>
+    <tbody>
+      __IFACES_ROWS__
+    </tbody>
+  </table>
+</section>
diff --git a/buildroot/package/rnsbox-portal/src/cgi/pages/wifi.html b/buildroot/package/rnsbox-portal/src/cgi/pages/wifi.html
new file mode 100644
index 000000000..fddb1daee
--- /dev/null
+++ b/buildroot/package/rnsbox-portal/src/cgi/pages/wifi.html
@@ -0,0 +1,129 @@
+<h2>WiFi</h2>
+
+<section class="card">
+  <h3>Status</h3>
+  <table class="kv">
+    <tr><th>Mode</th><td><span class="badge">__STATUS_MODE__</span></td></tr>
+    <tr><th>Client (STA)</th><td>
+      __STA_CELL__
+    </td></tr>
+    <tr><th>Hotspot (AP)</th><td>
+      __AP_CELL__
+    </td></tr>
+    <tr><th>TX power</th><td>
+      __TXPOWER_CELL__
+    </td></tr>
+  </table>
+  <form method="post" action="__BASE__/wifi/mode" class="row-form">
+    <select name="mode">
+      <option value="off" __SEL_MODE_OFF__>off</option>
+      <option value="sta" __SEL_MODE_STA__>sta</option>
+      <option value="ap" __SEL_MODE_AP__>ap</option>
+      <option value="sta+ap" __SEL_MODE_STAAP__>sta+ap</option>
+    </select>
+    <button type="submit" class="btn">Set mode</button>
+  </form>
+</section>
+
+<section class="card">
+  <h3>Join a network (client)</h3>
+  __CONCURRENT_NOTE__
+  <button type="button" class="btn" onclick="doScan()">Scan</button>
+  <span id="scanmsg" class="muted"></span>
+  <table class="data" id="scantbl" style="margin-top:8px; display:none">
+    <thead><tr><th>SSID</th><th>Signal</th><th>Ch</th><th>Band</th><th>Security</th><th></th></tr></thead>
+    <tbody></tbody>
+  </table>
+  <form method="post" action="__BASE__/wifi/connect" class="row-form" style="margin-top:10px">
+    <input name="ssid" id="ssid" type="text" placeholder="SSID" value="__STA_SSID__" required>
+    <input name="psk" id="sta_psk" type="password" placeholder="password (blank = open)">
+    <button type="button" class="btn" onclick="togglePw('sta_psk', this)">Show</button>
+    <button type="submit" class="btn-primary">Connect</button>
+  </form>
+</section>
+
+<section class="card">
+  <h3>Hotspot (access point)</h3>
+  <p class="muted">Runs concurrently with the client connection (AIC8800
+  single radio, time-shared). AP clients are NAT'd to the WAN and get DHCP
+  from the AP subnet in <code>/etc/rnsbox/wifi.conf</code>.</p>
+  <form method="post" action="__BASE__/wifi/ap">
+    <label><input type="checkbox" name="ap_enable" __AP_ENABLE_CHECKED__> Enable hotspot</label>
+    <label>SSID <input type="text" name="ap_ssid" value="__AP_SSID__"></label>
+    <label>Password (≥8 chars)
+      <input type="password" id="ap_psk" name="ap_psk" value="__AP_PSK__">
+      <button type="button" class="btn" onclick="togglePw('ap_psk', this)">Show</button>
+    </label>
+    <label>Channel__AP_CHANNEL_LOCK__
+      <select name="ap_channel" __AP_CHANNEL_DISABLED__>
+        __AP_CHANNEL_OPTIONS__
+      </select>
+    </label>
+    <label>Width__AP_WIDTH_LOCK__
+      <select name="ap_htmode" __AP_HTMODE_DISABLED__>
+        <option value="ht20" __SEL_HT20__>20 MHz (HT20)</option>
+        <option value="ht40" __SEL_HT40__>40 MHz (HT40)</option>
+      </select>
+    </label>
+    <button type="submit" class="btn-primary">Apply hotspot</button>
+  </form>
+  <p class="muted" style="margin-top:8px">In concurrent <em>sta+ap</em> mode the
+  client is pinned to <strong>2.4&nbsp;GHz</strong> and the hotspot inherits the
+  client's exact channel <em>and</em> width (single radio — they must share one
+  channel), so it runs at 40 MHz whenever the client link is 40 MHz. If the
+  client isn't connected yet, the hotspot starts on the channel below and
+  re-syncs to the client's channel once it joins. <em>auto</em> channel and a
+  manually chosen 40 MHz apply only in AP-only mode; if the radio can't honor
+  them the hotspot falls back to a 20 MHz channel.</p>
+</section>
+
+<section class="card">
+  <h3>TX power</h3>
+  <p class="muted">Radio-wide — applies to both client and hotspot (single
+  radio). <strong>auto</strong> = chip maximum, independent of the regulatory
+  database. A number caps power; firmware still applies per-rate EVM backoff
+  below it. The AIC8800D80 OFDM ceiling is ~18&nbsp;dBm (datasheet: 23&nbsp;dBm
+  11b-CCK, 18&nbsp;dBm MCS7), so values above ~18 only affect legacy 11b, not
+  data-rate throughput. Set lower to cut heat/range.</p>
+  <form method="post" action="__BASE__/wifi/txpower" class="row-form">
+    <select name="tx_power">
+      __TXPOWER_OPTIONS__
+    </select>
+    <button type="submit" class="btn-primary">Set TX power</button>
+  </form>
+</section>
+
+<script>
+// True when the box is in concurrent sta+ap mode: the client is 2.4 GHz-only,
+// so 5 GHz scan results are shown but not selectable.
+var CONCURRENT = __CONCURRENT_JS__;
+// Show/hide a password field. Flips the input type and the button label.
+function togglePw(id, btn){
+  var el = document.getElementById(id);
+  if (!el) return;
+  if (el.type === 'password'){ el.type = 'text';  btn.textContent = 'Hide'; }
+  else                       { el.type = 'password'; btn.textContent = 'Show'; }
+}
+function doScan(){
+  var msg=document.getElementById('scanmsg'); msg.textContent='scanning…';
+  fetch('__BASE__/wifi/scan').then(r=>r.json()).then(function(nets){
+    var tbl=document.getElementById('scantbl'), tb=tbl.querySelector('tbody');
+    tb.innerHTML='';
+    if(!nets.length){ msg.textContent='no networks found'; return; }
+    msg.textContent=nets.length+' found'; tbl.style.display='';
+    nets.forEach(function(n){
+      var tr=document.createElement('tr');
+      var band=n.band?(n.band+' GHz'):'';
+      var block5=CONCURRENT && n.band==='5';   // 5 GHz not joinable while concurrent
+      var btn=block5
+        ? '<span class="muted" title="2.4 GHz only in concurrent mode">5&nbsp;GHz</span>'
+        : '<button type="button" class="btn">Use</button>';
+      tr.innerHTML='<td>'+(n.ssid||'(hidden)')+'</td><td>'+n.signal+' dBm</td><td>'+
+        (n.channel||'')+'</td><td>'+band+'</td><td>'+n.security+'</td><td>'+btn+'</td>';
+      if(block5){ tr.style.opacity='0.45'; }
+      else { tr.querySelector('button').onclick=function(){ document.getElementById('ssid').value=n.ssid; }; }
+      tb.appendChild(tr);
+    });
+  }).catch(function(){ msg.textContent='scan failed'; });
+}
+</script>
\ No newline at end of file
diff --git a/buildroot/package/rnsbox-portal/src/cgi/render.cpp b/buildroot/package/rnsbox-portal/src/cgi/render.cpp
new file mode 100644
index 000000000..44d1a6cdf
--- /dev/null
+++ b/buildroot/package/rnsbox-portal/src/cgi/render.cpp
@@ -0,0 +1,99 @@
+// render.cpp — see render.h.
+#include "render.h"
+#include "web.h"
+#include "session.h"
+#include "util.h"
+#include <cstdlib>
+
+namespace {
+
+std::string pages_dir() {
+    const char* d = getenv("RNSBOX_PAGES");
+    return d && *d ? std::string(d) : std::string("/usr/share/rnsbox-portal/pages");
+}
+
+// Percent-encode everything but the unreserved set — for the flash cookie value.
+std::string pct(const std::string& s) {
+    static const char* hex = "0123456789ABCDEF";
+    std::string o;
+    o.reserve(s.size());
+    for (unsigned char c : s) {
+        if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+            (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~') {
+            o += (char)c;
+        } else {
+            o += '%'; o += hex[c >> 4]; o += hex[c & 0xF];
+        }
+    }
+    return o;
+}
+
+std::string all(std::string s, const std::string& from, const std::string& to) {
+    return web::replace_all(std::move(s), from, to);
+}
+
+// Read + clear the one-shot flash cookie; returns the rendered <div> (or "").
+std::string take_flash(const http::Request& req, http::Response& res) {
+    std::string v = req.cookie("rns_flash");
+    if (v.empty()) return "";
+    // Clear it so a refresh doesn't show it twice.
+    res.set_cookie("rns_flash=; Path=/; Max-Age=0; SameSite=Lax; HttpOnly");
+    size_t colon = v.find(':');
+    std::string cat = colon == std::string::npos ? std::string("success") : v.substr(0, colon);
+    std::string msg = colon == std::string::npos ? std::string() : http::url_decode(v.substr(colon + 1));
+    if (cat != "success" && cat != "error" && cat != "warn") cat = "success";
+    return "<div class=\"flash " + cat + "\">" + render::esc(msg) + "</div>";
+}
+
+}  // namespace
+
+namespace render {
+
+std::string esc(const std::string& s) { return http::html_escape(s); }
+
+std::string page_file(const char* name) {
+    return util::read_file(pages_dir() + "/" + name + ".html", 256 * 1024);
+}
+
+std::string layout(const http::Request& req, http::Response& res,
+                   const std::string& title, const char* active,
+                   const std::string& content) {
+    std::string host = util::trim(util::read_file("/proc/sys/kernel/hostname", 128));
+    session::Info s = session::check(req.cookie(session::COOKIE_NAME));
+
+    std::string h = page_file("base");
+    h = all(std::move(h), "__BASE__", web::base());
+    h = all(std::move(h), "__TITLE__", esc(title));
+    h = all(std::move(h), "__HOSTNAME__", esc(host));
+    h = all(std::move(h), "__USER__", esc(s.user));
+    // Active-nav: exactly one id gets "active", the rest collapse to "".
+    static const char* ids[] = {"dashboard", "network", "wifi", "reticulum", "settings", "donate"};
+    for (const char* id : ids) {
+        std::string tok = std::string("__ACT_") + id + "__";
+        h = all(std::move(h), tok, (active && std::string(active) == id) ? "active" : "");
+    }
+    h = all(std::move(h), "__FLASH__", take_flash(req, res));
+    h = all(std::move(h), "__CONTENT__", content);
+    return h;
+}
+
+std::string login_layout(const http::Request& req, http::Response& res,
+                         const std::string& content) {
+    std::string host = util::trim(util::read_file("/proc/sys/kernel/hostname", 128));
+    std::string h = page_file("login_base");
+    h = all(std::move(h), "__BASE__", web::base());
+    h = all(std::move(h), "__HOSTNAME__", esc(host));
+    h = all(std::move(h), "__FLASH__", take_flash(req, res));
+    h = all(std::move(h), "__CONTENT__", content);
+    return h;
+}
+
+void redirect_flash(http::Response& res, const std::string& location,
+                    const char* category, const std::string& msg) {
+    std::string cat = category ? category : "success";
+    res.set_cookie("rns_flash=" + cat + ":" + pct(msg) +
+                   "; Path=/; Max-Age=60; SameSite=Lax; HttpOnly");
+    res.redirect(location);
+}
+
+}  // namespace render
diff --git a/buildroot/package/rnsbox-portal/src/cgi/render.h b/buildroot/package/rnsbox-portal/src/cgi/render.h
new file mode 100644
index 000000000..db6499521
--- /dev/null
+++ b/buildroot/package/rnsbox-portal/src/cgi/render.h
@@ -0,0 +1,43 @@
+// render.h — server-side page rendering: base chrome, flash messages, PRG.
+//
+// The portal renders full HTML server-side (like the old Flask/Jinja app),
+// NOT a JSON-dumping shell. Page bodies live as .html files under PAGES_DIR
+// with __PLACEHOLDER__ tokens; a route handler builds the dynamic fragments
+// (table rows, selected options, values) and wraps the result in the shared
+// chrome via layout(). POST handlers use redirect_flash() (POST-redirect-GET)
+// so a refresh never re-submits, exactly as the Flask app did.
+#ifndef RNSBOX_RENDER_H
+#define RNSBOX_RENDER_H
+
+#include "http.h"
+#include <string>
+
+namespace render {
+
+// HTML-escape (alias of http::html_escape) — the workhorse for injecting data.
+std::string esc(const std::string& s);
+
+// Read a page template file: <PAGES_DIR>/<name>.html (env RNSBOX_PAGES overrides
+// the default /usr/share/rnsbox-portal/pages). Empty string if missing.
+std::string page_file(const char* name);
+
+// Wrap `content` in the base chrome (topbar + sidebar + footer). `active` is the
+// sidebar id to highlight: "dashboard" | "network" | "wifi" | "reticulum" |
+// "settings" | "donate". Consumes + clears the one-shot flash cookie (rendering
+// it above the content) and sets the clearing Set-Cookie on `res`. `title` and
+// the session user are HTML-escaped.
+std::string layout(const http::Request& req, http::Response& res,
+                   const std::string& title, const char* active,
+                   const std::string& content);
+
+// Bare login-screen chrome (no sidebar). Also renders + clears the flash.
+std::string login_layout(const http::Request& req, http::Response& res,
+                          const std::string& content);
+
+// POST-redirect-GET with a one-shot flash. `category` is "success"|"error"|
+// "warn"; `msg` is shown once on the next page. Sets the flash cookie + 302.
+void redirect_flash(http::Response& res, const std::string& location,
+                    const char* category, const std::string& msg);
+
+}  // namespace render
+#endif
