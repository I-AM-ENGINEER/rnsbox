-	printf "Starting %s: " "$NAME"
-	"$DAEMON" >>"$LOG" 2>&1 &
-	PID=$!
-	echo "$PID" > "$PIDFILE"
+	printf "Starting uhttpd (portal): "
+	# -t/-T 200: the Reticulum tab's "Update rnsd" apply shells to pip (in-place
+	# package update + rnsd restart) and can run well past uhttpd's 60 s default
+	# script timeout; raise both the script and network idle timeouts so the
+	# async apply isn't killed mid-flight (the browser shows a spinner meanwhile).
+	uhttpd -p 0.0.0.0:80 -h "$DOCROOT" -x /cgi-bin -I index.html -t 200 -T 200
