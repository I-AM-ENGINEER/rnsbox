-	if kill -0 "$PID" 2>/dev/null; then
-		echo "OK (pid $PID)"
-	else
-		echo "FAIL (see $LOG)"
-		rm -f "$PIDFILE"
-		return 1
-	fi
+	if pidof uhttpd >/dev/null 2>&1; then echo "OK (pid $(pidof uhttpd))"; else echo "FAIL"; return 1; fi
 }
 
