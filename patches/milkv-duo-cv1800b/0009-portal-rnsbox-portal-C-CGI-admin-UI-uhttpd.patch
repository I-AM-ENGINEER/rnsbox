-	printf "Stopping %s: " "$NAME"
-	if [ -f "$PIDFILE" ]; then
-		kill "$(cat $PIDFILE)" 2>/dev/null
-		rm -f "$PIDFILE"
-		echo "OK"
-	else
-		echo "(not running)"
-	fi
