From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Fri, 17 Oct 2026 00:45:00 +0300
Subject: [PATCH] boards_scan: ship a default configuration in the FIT

Live-board follow-up to the bootm patch: with the #config suffix gone,
u-boot 2021.10 (no CONFIG_MULTI_DTB_FIT here) resolves a bare
"bootm ${uImage_addr}" ONLY through the "default" property of the
/configurations node - and boards_scan never wrote one, so the boot
still died at the very last step ("Could not find configuration node")
even with a perfectly readable SD and a valid FIT.

Emit default = "<first config>" alongside the config entries in both
generators (single-board and whole-family).
---
diff --git a/build/scripts/boards_scan.py b/build/scripts/boards_scan.py

--- a/build/scripts/boards_scan.py
+++ b/build/scripts/boards_scan.py
@@ -481,8 +481,13 @@ def print_usage():
                 )
 
 
+# RNSBox: ship a default configuration. u-boot 2021.10 without
+# CONFIG_MULTI_DTB_FIT resolves a bare "bootm <fit>" ONLY through the
+# "default" property of /configurations - without it the boot dies with
+# "Could not find configuration node" even though the FIT is fine.
 config_list_tmpl = """
     configurations {{
+        default = "{default_config}";
         {config}
     }};
 """
@@ -541,6 +546,9 @@ def gen_single_board_its(chip, board, skip_ramdisk=False):
     its_path = os.path.join(build_helper.BUILD_OUTPUT_DIR, "multi.its.tmp")
 
     cfg_tmpl = config_noramdisk_tmpl if skip_ramdisk else config_tmpl
+    its_str["default_config"] = "config-{chip}_{board}".format(
+        chip=chip, board=board
+    )
     its_str["fdt"] = fdt_tmpl.format(
         chip=chip, board=board, hash_algo=get_hash_algo(board)
     )
@@ -591,6 +599,9 @@ def gen_board_its(input_arch, skip_ramdisk=False):
                 board_list.append(Arch(chip, br_name))
 
     cfg_tmpl = config_noramdisk_tmpl if skip_ramdisk else config_tmpl
+    its_str["default_config"] = "config-{chip}_{board}".format(
+        chip=board_list[0][0], board=board_list[0][1]
+    )
     its_str["fdt"] = "\n".join(
         fdt_tmpl.format(chip=chip, board=board, hash_algo=get_hash_algo(board))
         for chip, board in board_list
2.43.0

