From e2b608264f7ad30654bb5947e1a9a114ee59b233 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Thu, 15 Oct 2026 23:09:19 +0300
Subject: [PATCH] rnsd: PYTHONOPTIMIZE=2 - ~0.7MB off the import peak on 64MB

---
 .../board/cvitek/SG200X/overlay/etc/init.d/S82rnsd    | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd
index e691f0f..5ebb178 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd
@@ -45,7 +45,16 @@ start() {
 	# --config points at our config dir; rnsd auto-creates files inside.
 	# -s detaches to its own process group; we still pidfile-track so
 	# the watchdog (S46wanwatch) can detect it cleanly.
-	"$DAEMON" --config "$CFG_DIR" >>"$LOG" 2>&1 &
+	#
+	# PYTHONOPTIMIZE=2 (ram-optimization): strips docstrings and asserts
+	# from the interpreted RNS stack. Paired A/B (identical guest, only
+	# the env differs): interpreter HWM 50156 -> 49312 kB, rnsd entry
+	# 50512 -> 49856 kB under qemu-user; ~0.7 MB off the peak on the
+	# 64MB board where the rnsd import spike is the budget driver.
+	# RNS uses __doc__ once and its 50 asserts are internal sanity
+	# checks, not user-input validation - acceptable trade, see
+	# local_docs/ram-footprint-64mb.md.
+	PYTHONOPTIMIZE=2 "$DAEMON" --config "$CFG_DIR" >>"$LOG" 2>&1 &
 	PID=$!
 	echo "$PID" > "$PIDFILE"
 	sleep 0.3
-- 
2.43.0

