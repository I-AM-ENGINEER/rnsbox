From 7050dea6e6105311b2a25de49e04399998107937 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Thu, 15 Oct 2026 21:42:34 +0300
Subject: [PATCH] fstab: cap every tmpfs mount - default half-RAM limits OOM a
 64MB board

---
 buildroot/board/cvitek/SG200X/overlay/etc/fstab | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/fstab b/buildroot/board/cvitek/SG200X/overlay/etc/fstab
index c0f0c8e..5b56f3c 100644
--- a/buildroot/board/cvitek/SG200X/overlay/etc/fstab
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/fstab
@@ -9,9 +9,13 @@ devpts		/dev/pts	devpts	defaults,gid=5,mode=620,ptmxmode=0666	0	0
 sysfs		/sys		sysfs	defaults				0	0
 
 # Memory-backed mounts — kill SD writes from the chatty paths.
-tmpfs		/dev/shm	tmpfs	mode=0777				0	0
-tmpfs		/tmp		tmpfs	mode=1777				0	0
-tmpfs		/run		tmpfs	mode=0755,nosuid,nodev			0	0
+# Every tmpfs is size-capped: a default tmpfs claims up to 50% of RAM, and
+# on the 64MB board a runaway writer in /tmp would OOM the box. 16MB /tmp
+# still fits a pip wheel (pip itself unpacks to the rootfs via TMPDIR since
+# the in-place update feature); /run holds pidfiles+state, /dev/shm is idle.
+tmpfs		/dev/shm	tmpfs	mode=0777,size=2M			0	0
+tmpfs		/tmp		tmpfs	mode=1777,size=16M			0	0
+tmpfs		/run		tmpfs	mode=0755,nosuid,nodev,size=4M		0	0
 tmpfs		/var/log	tmpfs	mode=0755,size=4M			0	0
 tmpfs		/var/lock	tmpfs	mode=1777,size=512k			0	0
 tmpfs		/var/cache	tmpfs	mode=0755,size=512k			0	0
-- 
2.43.0

