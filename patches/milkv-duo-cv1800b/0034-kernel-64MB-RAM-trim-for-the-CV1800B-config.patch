Date: Thu, 15 Oct 2026 21:33:29 +0300
Subject: [PATCH] kernel: 64MB RAM trim for the CV1800B config (+zram,
 -legacy-netfilter)

---
 .../linux/cv1800b_sophpi_duo_sd_defconfig     | 262 ++++++++++--------
 1 file changed, 143 insertions(+), 119 deletions(-)

diff --git a/build/boards/cv180x/cv1800b_sophpi_duo_sd/linux/cv1800b_sophpi_duo_sd_defconfig b/build/boards/cv180x/cv1800b_sophpi_duo_sd/linux/cv1800b_sophpi_duo_sd_defconfig
index 6d4a965..6585b70 100644
--- a/build/boards/cv180x/cv1800b_sophpi_duo_sd/linux/cv1800b_sophpi_duo_sd_defconfig
+++ b/build/boards/cv180x/cv1800b_sophpi_duo_sd/linux/cv1800b_sophpi_duo_sd_defconfig
@@ -1,20 +1,37 @@
 # RNSBox kernel config for the CV1800B boards (Milk-V Duo 64M et al.).
-# Derived line-for-line from the family RNSBox SG200X config (sg2000_duomodule01)
-# so one kernel recipe serves the whole CVITEK RV64 family; only the chip
-# selection differs - the CV180X-vs-CV181X arch choice is a hard Kconfig
-# choice, so phobos (cv180x) and mars (sg200x) need one Image each. DTBs,
-# drivers and everything else stay identical. CV1800B note at CONFIG_SWAP:
-# 64MB DRAM has no headroom for python RSS spikes; swap-on-SD is the
-# documented escape hatch (docs/BOARD-cvitek-universal-rv64.md).
+# Derived from the family RNSBox SG200X config (sg2000_duomodule01) so one
+# kernel recipe serves the CVITEK RV64 family; only the chip selection
+# differs (ARCH_CV180X-vs-CV181X is a hard Kconfig choice: phobos vs mars
+# need one Image each). DTBs, drivers and everything else stay identical.
+#
+# 64MB-specific RAM trim (ram-optimization). The CV1800B has 64MB DDR2 and
+# no headroom, so unlike the family config this one additionally drops:
+#   KALLSYMS, IKCONFIG(+PROC)      - debug/trace niceties, resident RAM
+#   SQUASHFS, UBIFS                - RNSBox boots ext4 from SD; no NAND/squash
+#   CFG80211                       - Milk-V Duo 64M has no WiFi chip; W-variant
+#                                    boards are mars/sg200x and keep their config
+#   legacy iptables + x_tables     - /etc/iptables.conf ships EMPTY; the only
+#                                    firewall is nftables (S60routing/nftgen);
+#                                    kept: NF_TABLES_IPV4 + NFT_CT/COUNTER/
+#                                    LIMIT/MASQ/NAT - exactly what nftgen emits
+#   conntrack/nat helpers          - AMANDA/H323/IRC/... ALGs are unused
+#   NET_SCHED + FQ + FQ_CODEL      - no qdisc is ever configured
+#   THERMAL_{NETLINK,WRITABLE_TRIPS,EMULATION}, ELF_CORE/COREDUMP,
+#   MODULE_FORCE_LOAD, LOG_BUF_SHIFT 15->13
+# Image: 7042560 -> 5504512 bytes (-1.5MB resident RAM, -21.8%).
+#
+# zram: ZSMALLOC+ZRAM+CRYPTO_LZ4 built in as the only legal swap on a 64MB
+# board (SWAP ON SD IS FORBIDDEN - it kills the card). No swap is activated
+# by any boot script; zram swap is opt-in via /etc/init.d/S85zram.
 CONFIG_CC_OPTIMIZE_FOR_SIZE=y
 CONFIG_SYSVIPC=y
 CONFIG_POSIX_MQUEUE=y
 CONFIG_NO_HZ_IDLE=y
 CONFIG_HIGH_RES_TIMERS=y
 CONFIG_PREEMPT=y
-CONFIG_IKCONFIG=y
-CONFIG_IKCONFIG_PROC=y
-CONFIG_LOG_BUF_SHIFT=15
+# CONFIG_IKCONFIG is not set
+# CONFIG_IKCONFIG_PROC is not set
+CONFIG_LOG_BUF_SHIFT=13
 CONFIG_BLK_DEV_INITRD=y
 # CONFIG_SYSFS_SYSCALL is not set
 # CONFIG_FHANDLE is not set
@@ -36,13 +53,13 @@ CONFIG_POWER_RESET=y
 CONFIG_COMPAT_32BIT_TIME=y
 CONFIG_STRICT_KERNEL_RWX=n
 CONFIG_MODULES=y
-CONFIG_MODULE_FORCE_LOAD=y
+# CONFIG_MODULE_FORCE_LOAD is not set
 CONFIG_MODULE_UNLOAD=y
 # CONFIG_BLK_DEV_BSG is not set
 # CONFIG_MQ_IOSCHED_DEADLINE is not set
 # CONFIG_MQ_IOSCHED_KYBER is not set
-CONFIG_ELF_CORE=y
-CONFIG_COREDUMP=y
+# CONFIG_ELF_CORE is not set
+# CONFIG_COREDUMP is not set
 CONFIG_PROC_SYSCTL=y
 CONFIG_CMA=y
 CONFIG_NET=y
@@ -57,7 +74,7 @@ CONFIG_INET=y
 # fdrv fails modpost with undefined cfg80211_* symbols. Built-in also removes
 # load-order fragility (cfg80211 always present before aic8800 insmod).
 # No mac80211 (firmware does the MAC).
-CONFIG_CFG80211=y
+# CONFIG_CFG80211 is not set
 CONFIG_RFKILL=y
 CONFIG_UEVENT_HELPER=y
 CONFIG_DEVTMPFS=y
