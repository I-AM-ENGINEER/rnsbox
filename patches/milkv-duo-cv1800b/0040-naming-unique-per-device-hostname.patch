From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Taixin Reverse <reverse@taixin.local>
Date: Sat, 17 Oct 2026 16:26:29 +0300
Subject: [PATCH] naming: unique per-device hostname (rnsbox-xxxxxx)

Port of the sg2000 naming fix (no S37bluetooth on this series: no
BLE patch). The image shipped a static /boot/hostname=rnsbox, which
pinned every board to the generic name; the vendor eFuse route is
useless (zero-length /device_key_legacy -> one code for everyone),
so the code is 6 hex chars from /dev/urandom, generated at first
boot and persisted to /boot/hostname. Also fixes the /boot/eth.mac
vs /boot/ethmac mismatch and derives the eth MAC from the code.
---
 .../cvitek/SG200X/overlay/etc/init.d/S10uuid  | 31 ++++++++++++++++---
 1 file changed, 26 insertions(+), 5 deletions(-)

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S10uuid b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S10uuid
index 53afed049..b86aa412c 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S10uuid
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S10uuid
@@ -13,17 +13,35 @@ hex2mac() {
 
 if [ "${1}" = start ]
 then
-	prefix=licheervnano
+	prefix=rnsbox
 	if [ -e /boot/hostname.prefix ]
 	then
 		prefix=$(cat /boot/hostname.prefix)
 	fi
 	old_hostname=$(cat /etc/hostname)
-	new_hostname=${prefix}-$(sha512sum /device_key_legacy | head -c 4)
+	# 6 hex chars from /dev/urandom, generated ONCE at first boot and
+	# persisted to /boot/hostname. The vendor eFuse route is useless on
+	# these boards: /device_key_legacy is zero-length, so its sha512
+	# (cf83e1...) - and the eth MAC derived from it - are identical for
+	# every board. The persisted name survives updates and stays unique
+	# per flashed board; the echobot identity and the BLE adapter name
+	# (S37bluetooth) both take the hostname, so one code names the node
+	# everywhere.
+	new_hostname=${prefix}-$(head -c 3 /dev/urandom | od -An -tx1 | tr -d ' \n')
 
+	# /boot/hostname is the persistent override. The image ships the
+	# generic default "rnsbox" there: treat that as "not customized
+	# yet" and write the generated name back.
+	_persisted=""
 	if [ -e /boot/hostname ]
 	then
-		new_hostname=$(cat /boot/hostname)
+		_persisted=$(cat /boot/hostname)
+	fi
+	if [ -n "${_persisted}" ] && [ "${_persisted}" != "rnsbox" ]
+	then
+		new_hostname=${_persisted}
+	else
+		echo ${new_hostname} > /boot/hostname
 	fi
 
 	if [ "${old_hostname}" != "${new_hostname}" ]
@@ -36,9 +54,12 @@ then
 
 	if [ -e /boot/eth.mac ]
 	then
-		new_ethmac=$(cat /boot/ethmac)
+		new_ethmac=$(cat /boot/eth.mac)
 	else
-		new_ethmac=$(hex2mac 48da356f$(sha512sum /device_key_legacy  | head -c 4))
+		# last 4 hex of the persisted name code: unique per board now
+		# (was: sha512 of the empty device key -> one MAC for everyone)
+		_code=${new_hostname##*-}
+		new_ethmac=$(hex2mac 48da356f$(printf '%s' "$_code" | tail -c 4))
 	fi
 
 	ifconfig eth0 down
-- 
2.43.0

