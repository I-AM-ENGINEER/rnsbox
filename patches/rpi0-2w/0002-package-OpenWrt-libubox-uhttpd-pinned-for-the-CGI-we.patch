From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Thu, 24 Sep 2026 23:01:38 +0300
Subject: [PATCH 02/13] package: OpenWrt libubox + uhttpd (pinned), for the CGI
 web tier
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

uhttpd is pinned to 15346de8d3ba422002496526ee24c62a3601ab8c — the exact
source the S81router flag behaviour was verified against on the LicheeRV
build. No TLS/Lua/ubus: the portal is plain HTTP on the gadget LAN.
---
 configs/rnsbox_rpi0_2w_64_defconfig |  5 ++++
 package/libubox/Config.in           | 14 +++--------
 package/libubox/libubox.hash        |  4 +--
 package/libubox/libubox.mk          | 20 ++++-----------
 package/uhttpd/Config.in            | 18 +++----------
 package/uhttpd/uhttpd.hash          |  5 ++--
 package/uhttpd/uhttpd.mk            | 39 ++++++-----------------------
 7 files changed, 29 insertions(+), 76 deletions(-)

diff --git a/configs/rnsbox_rpi0_2w_64_defconfig b/configs/rnsbox_rpi0_2w_64_defconfig
index b5939444..4f0e5e4f 100644
--- a/configs/rnsbox_rpi0_2w_64_defconfig
+++ b/configs/rnsbox_rpi0_2w_64_defconfig
@@ -35,3 +35,8 @@ BR2_PACKAGE_HOST_DOSFSTOOLS=y
 BR2_PACKAGE_HOST_GENIMAGE=y
 BR2_PACKAGE_HOST_KMOD_XZ=y
 BR2_PACKAGE_HOST_MTOOLS=y
+# HTTP tier (uhttpd serves the rnsbox-portal CGI binary)
+BR2_PACKAGE_OPENSSL=y
+BR2_PACKAGE_JSON_C=y
+BR2_PACKAGE_LIBUBOX=y
+BR2_PACKAGE_UHTTPD=y
diff --git a/package/libubox/Config.in b/package/libubox/Config.in
index 09d63367..35fcf154 100644
--- a/package/libubox/Config.in
+++ b/package/libubox/Config.in
@@ -1,16 +1,8 @@
 config BR2_PACKAGE_LIBUBOX
 	bool "libubox"
-	depends on !BR2_STATIC_LIBS
-	depends on BR2_TOOLCHAIN_HAS_SYNC_4 # json-c
 	select BR2_PACKAGE_JSON_C
 	help
-	  This library originates from the OpenWrt project to
-	  handle the configuration file infrastructure, but can
-	  also be used for the same purposes in projects other
-	  than OpenWrt.
+	  OpenWrt's basic utility library (avl, list, blob, blobmsg, ustream,
+	  uloop) — required by uhttpd.
 
-	  https://openwrt.org/docs/techref/libubox
-
-comment "libubox needs a toolchain w/ dynamic library"
-	depends on BR2_STATIC_LIBS
-	depends on BR2_TOOLCHAIN_HAS_SYNC_4
+	  https://git.openwrt.org/?p=project/libubox.git
diff --git a/package/libubox/libubox.hash b/package/libubox/libubox.hash
index 127abf43..16cd1f2d 100644
--- a/package/libubox/libubox.hash
+++ b/package/libubox/libubox.hash
@@ -1,2 +1,2 @@
-# Locally calculated
-sha256  c4432d4f902bd0a2974d3fe76620bbb5e04b9d52e55701829aa12507651bc4d9  libubox-ecddb31dc34d89be5c9dc4595a4c58070eb090e4-git4.tar.gz
+# computed from https://github.com/openwrt/libubox/archive/e7608b69283d919d031d13cc8e21692503f5dbea.tar.gz
+sha256  44ab7873726cc25b8813a096ed8760cb569e2ac3567302e400923be1f6bbdfc0  libubox-e7608b69283d919d031d13cc8e21692503f5dbea.tar.gz
diff --git a/package/libubox/libubox.mk b/package/libubox/libubox.mk
index 87107202..bb0a9190 100644
--- a/package/libubox/libubox.mk
+++ b/package/libubox/libubox.mk
@@ -1,23 +1,13 @@
 ################################################################################
 #
-# libubox
+# libubox — OpenWrt utility library (ustream/uloop/blobmsg)
 #
 ################################################################################
-
-LIBUBOX_VERSION = ecddb31dc34d89be5c9dc4595a4c58070eb090e4
-LIBUBOX_SITE = https://git.openwrt.org/project/libubox.git
-LIBUBOX_SITE_METHOD = git
-LIBUBOX_LICENSE = ISC, BSD-3-Clause
+LIBUBOX_VERSION = e7608b69283d919d031d13cc8e21692503f5dbea
+LIBUBOX_SITE = $(call github,openwrt,libubox,$(LIBUBOX_VERSION))
+LIBUBOX_LICENSE = ISC
 LIBUBOX_INSTALL_STAGING = YES
 LIBUBOX_DEPENDENCIES = json-c
-
-ifeq ($(BR2_USE_MMU)$(BR2_PACKAGE_LUA_5_1),yy)
-LIBUBOX_DEPENDENCIES += lua
-LIBUBOX_CONF_OPTS += -DBUILD_LUA=ON \
-	-DLUAPATH=/usr/lib/lua/5.1 \
-	-DLUA_CFLAGS=-I$(STAGING_DIR)/usr/include
-else
-LIBUBOX_CONF_OPTS += -DBUILD_LUA=OFF
-endif
+LIBUBOX_CONF_OPTS = -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DBUILD_LUA=OFF -DBUILD_EXAMPLES=OFF
 
 $(eval $(cmake-package))
diff --git a/package/uhttpd/Config.in b/package/uhttpd/Config.in
index 30101f98..8010d4a9 100644
--- a/package/uhttpd/Config.in
+++ b/package/uhttpd/Config.in
@@ -1,19 +1,9 @@
 config BR2_PACKAGE_UHTTPD
 	bool "uhttpd"
-	depends on !BR2_STATIC_LIBS # dlopen()
-	depends on BR2_TOOLCHAIN_HAS_SYNC_4 # json-c, libubox -> json-c
-	depends on BR2_USE_MMU # fork()
 	select BR2_PACKAGE_LIBUBOX
-	select BR2_PACKAGE_JSON_C
-	select BR2_PACKAGE_LIBXCRYPT if BR2_TOOLCHAIN_USES_GLIBC
 	help
-	  uHTTPd is a tiny single threaded HTTP server with TLS, CGI
-	  and Lua support. It is intended as a drop-in replacement for
-	  the Busybox HTTP daemon.
+	  OpenWrt's embedded HTTP server: small event loop, built-in CGI
+	  (exec per request — the RNSBox portal model). This build has no
+	  TLS/Lua/ubus support; the portal is plain HTTP on the LAN.
 
-	  https://wiki.openwrt.org/doc/howto/http.uhttpd
-
-comment "uhttpd needs a toolchain w/ dynamic library"
-	depends on BR2_TOOLCHAIN_HAS_SYNC_4
-	depends on BR2_USE_MMU
-	depends on BR2_STATIC_LIBS
+	  https://git.openwrt.org/?p=project/uhttpd.git
diff --git a/package/uhttpd/uhttpd.hash b/package/uhttpd/uhttpd.hash
index e84d2dc3..eeacfe13 100644
--- a/package/uhttpd/uhttpd.hash
+++ b/package/uhttpd/uhttpd.hash
@@ -1,3 +1,2 @@
-# Locally calculated
-sha256  397aa4bccc4acb06031270d4a549fb266fec3950a88fe3523f0d7de74caff010  uhttpd-15346de8d3ba422002496526ee24c62a3601ab8c-git4.tar.gz
-sha256  ce1803f83f776cc88661e303fede0e5ff52faf1d9f74508fadbecf7705b4c84d  uhttpd.h
+# computed from https://github.com/openwrt/uhttpd/archive/15346de8d3ba422002496526ee24c62a3601ab8c.tar.gz
+sha256  7d0eb18a504a513b6652508a463aa85f03af3e53cd45b3114a25030f131b1bc5  uhttpd-15346de8d3ba422002496526ee24c62a3601ab8c.tar.gz
diff --git a/package/uhttpd/uhttpd.mk b/package/uhttpd/uhttpd.mk
index f4fcccfa..74deed93 100644
--- a/package/uhttpd/uhttpd.mk
+++ b/package/uhttpd/uhttpd.mk
@@ -1,39 +1,16 @@
 ################################################################################
 #
-# uhttpd
+# uhttpd — OpenWrt's embedded web server (CGI tier for rnsbox-portal)
+#
+# Pinned to the commit the RNSBox init scripts' flags were verified against
+# (see S81router).
 #
 ################################################################################
-
 UHTTPD_VERSION = 15346de8d3ba422002496526ee24c62a3601ab8c
-UHTTPD_SITE = https://git.openwrt.org/project/uhttpd.git
-UHTTPD_SITE_METHOD = git
+UHTTPD_SITE = $(call github,openwrt,uhttpd,$(UHTTPD_VERSION))
 UHTTPD_LICENSE = ISC
-UHTTPD_LICENSE_FILES = uhttpd.h
-UHTTPD_DEPENDENCIES = libubox json-c
-
-ifeq ($(BR2_PACKAGE_LIBXCRYPT),y)
-UHTTPD_DEPENDENCIES += libxcrypt
-endif
-
-ifeq ($(BR2_PACKAGE_LUA_5_1),y)
-UHTTPD_DEPENDENCIES += lua
-UHTTPD_CONF_OPTS += -DLUA_SUPPORT=ON
-else
-UHTTPD_CONF_OPTS += -DLUA_SUPPORT=OFF
-endif
-
-ifeq ($(BR2_PACKAGE_USTREAM_SSL),y)
-UHTTPD_DEPENDENCIES += ustream-ssl
-UHTTPD_CONF_OPTS += -DTLS_SUPPORT=ON
-else
-UHTTPD_CONF_OPTS += -DTLS_SUPPORT=OFF
-endif
-
-ifeq ($(BR2_PACKAGE_UBUS),y)
-UHTTPD_DEPENDENCIES += ubus
-UHTTPD_CONF_OPTS += -DUBUS_SUPPORT=ON
-else
-UHTTPD_CONF_OPTS += -DUBUS_SUPPORT=OFF
-endif
+UHTTPD_LICENSE_FILES = uhttpd.c
+UHTTPD_DEPENDENCIES = libubox
+UHTTPD_CONF_OPTS = -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DLUA_SUPPORT=OFF -DUBUS_SUPPORT=OFF -DTLS_SUPPORT=OFF
 
 $(eval $(cmake-package))
