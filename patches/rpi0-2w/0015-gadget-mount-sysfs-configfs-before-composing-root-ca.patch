From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Sat, 26 Sep 2026 03:49:09 +0300
Subject: [PATCH 15/16] gadget: mount sysfs+configfs before composing (root
 cause of the dead USB device)

/sys was never mounted at rcS time (only devtmpfs automounts; the fstab
had lost the sysfs line) - S10usbdev then created plain ext4 directories
under the unmounted /sys instead of configfs objects, every os_desc
write failed, the gadget never bound, and the bare dwc2 pullup left the
host with a device that never answers descriptors (Windows Code 43,
VID_0000). Fix at every layer: fstab sysfs line restored; S10usbdev
mounts and VERIFIES sysfs+configfs itself before touching usb_gadget.
---
 .../rnsbox-0-2w/rootfs-overlay/etc/fstab      |  1 +
 .../rootfs-overlay/etc/init.d/S10usbdev       | 22 +++++++++++++++++--
 2 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/fstab b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/fstab
index c1c8fb17..6d6b49b6 100644
--- a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/fstab
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/fstab
@@ -4,6 +4,7 @@
 /dev/root	/		ext4	rw,noauto,noatime			0	1
 /dev/mmcblk0p1	/boot		vfat	defaults,noatime			0	0
 proc		/proc		proc	defaults				0	0
+sysfs		/sys		sysfs	defaults				0	0
 devpts		/dev/pts	devpts	defaults,gid=5,mode=620,ptmxmode=0666	0	0
 tmpfs		/dev/shm	tmpfs	mode=0777				0	0
 tmpfs		/tmp		tmpfs	mode=1777				0	0
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S10usbdev b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S10usbdev
index b56e2b3d..3b11ea04 100755
--- a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S10usbdev
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S10usbdev
@@ -38,10 +38,22 @@ start() {
 		return 0
 	fi
 
-	# configfs + composite framework (built-in on RNSBox kernels, but be
-	# tolerant of a modular build)
+	# sysfs + configfs + composite framework. Mount them OURSELVES and verify:
+	# early in boot /sys may not be mounted yet (only devtmpfs automounts) -
+	# creating gadget dirs into an unmounted /sys would write plain ext4
+	# directories and silently break the gadget (host sees a dead device).
+	mountpoint -q /sys 2>/dev/null || mount -t sysfs sys /sys 2>>"$LOG"
+	if ! mountpoint -q /sys 2>/dev/null; then
+		echo "S10usbdev: cannot mount sysfs" >&2
+		return 1
+	fi
+	mkdir -p /sys/kernel/config 2>/dev/null || true
 	mountpoint -q /sys/kernel/config 2>/dev/null || \
 		mount -t configfs none /sys/kernel/config 2>>"$LOG"
+	if ! mountpoint -q /sys/kernel/config 2>/dev/null; then
+		echo "S10usbdev: cannot mount configfs" >&2
+		return 1
+	fi
 	modprobe libcomposite 2>/dev/null || true
 
 	mkdir -p "$GADGET" 2>>"$LOG" || {
@@ -65,6 +77,12 @@ start() {
 		mkdir -p "$GADGET/functions/ncm.usb0"
 		ln -sfn "$GADGET/functions/ncm.usb0" "$GADGET/configs/c.1/ncm.usb0"
 
+		# Device-side MAC via configfs BEFORE the UDC bind: rewriting the
+		# MAC of an already-enumerated function upsets some hosts.
+		if [ -s /boot/usb.ncm.mac ]; then
+			cat /boot/usb.ncm.mac > "$GADGET/functions/ncm.usb0/dev_addr" 2>>"$LOG" || 				echo "S10usbdev: could not set ncm dev_addr pre-bind" >>"$LOG"
+		fi
+
 		# Device-side MAC: set via configfs BEFORE the UDC bind so the
 		# function never changes identity after enumeration (rewriting the
 		# MAC of a live function upsets some hosts - Code 43).
