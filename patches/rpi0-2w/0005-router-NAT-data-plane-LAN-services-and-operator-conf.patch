diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/wan.conf b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/wan.conf
new file mode 100644
index 00000000..b3adb5bf
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/wan.conf
@@ -0,0 +1,25 @@
+# WAN uplink config — managed by the rnsbox-portal Network tab.
+#
+# Flat key=value. Parsed by the shell init scripts (S30eth addresses the
+# wired WAN; S60routing picks the NAT iface).
+#
+# interface:  which iface acts as WAN (default route + NAT masquerade attach here)
+#   wlan0   - onboard WiFi client (default on this board; addressed by
+#             S35wifi/dhcpcd, not S30eth)
+#   eth0    - USB-Ethernet adapter, if one is plugged in (addressed by S30eth)
+#
+# mode:  how a wired eth0 WAN gets its IPv4 address
+#   dhcp    - lease from the upstream router (default)
+#   static  - use the address/prefix/gateway/dns fields below
+#
+# Static fields (only read when mode=static, only applied to eth0):
+#   address   IPv4 address,         e.g. 192.168.1.50
+#   prefix    netmask as CIDR bits, e.g. 24  (255.255.255.0)
+#   gateway   upstream gateway,     e.g. 192.168.1.1
+#   dns       space-separated DNS servers, e.g. 1.1.1.1 8.8.8.8
+#
+# Changes take effect after `/etc/init.d/S30eth restart` +
+# `/etc/init.d/S60routing restart` (the portal does both on save), or a reboot.
+
+interface=wlan0
+mode=dhcp
