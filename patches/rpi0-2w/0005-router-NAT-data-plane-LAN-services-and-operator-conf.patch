diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/dhcpcd.conf b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/dhcpcd.conf
new file mode 100644
index 00000000..880f344f
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/dhcpcd.conf
@@ -0,0 +1,40 @@
+# dhcpcd config for the RNSBox router.
+#
+# Goal: a single persistent dhcpcd that owns eth0 (WAN) only, never touches
+# usb0 (LAN, dnsmasq territory), IPv4 only, and never falls back to
+# IPv4LL/APIPA — we'd rather have no IP than a 169.254.x.x address that
+# the kernel will helpfully install a default route through.
+
+hostname
+clientid
+
+# `persistent` keeps the daemon resident across NOCARRIER, so when the
+# Ethernet cable is plugged in (or finally provides enough power for a
+# stable link) we get a lease automatically without re-launching anything.
+persistent
+
+option rapid_commit
+option domain_name_servers, domain_name, domain_search
+option classless_static_routes
+require dhcp_server_identifier
+slaac private
+
+# We have no IPv6 upstream by default; matches the kernel sysctls and
+# the nftables rules. (Reticulum doesn't need it.)
+noipv6
+noipv6rs
+
+# No 169.254 fallback. dhcpcd's APIPA route would otherwise become the
+# default route on link-down, which is exactly the bug we hit on the
+# predecessor board.
+noipv4ll
+
+# Allowed WAN interfaces. /etc/init.d/S30eth invokes dhcpcd with the
+# chosen iface name explicitly; the allowinterfaces list still gates
+# which devices dhcpcd will ever touch. Listing both eth0 + wlan0
+# means a runtime WAN switch (edit /etc/rnsbox/wan.conf, restart
+# S30eth) works without re-editing this file.
+#
+# usb0 = LAN side, dnsmasq's territory.
+allowinterfaces eth0 wlan0
+denyinterfaces lo usb0
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/dnsmasq.conf b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/dnsmasq.conf
new file mode 100644
index 00000000..b952b8f5
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/dnsmasq.conf
@@ -0,0 +1,20 @@
+# NOTE: this file is REGENERATED AT BOOT by /etc/init.d/S60routing
+# based on /etc/rnsbox/wan.conf. Manual edits below the "AUTOGEN MARKER"
+# line are clobbered every boot.
+#
+# To change the WAN interface, edit /etc/rnsbox/wan.conf and run
+#   /etc/init.d/S60routing restart
+
+# Shared (interface-agnostic) settings.
+filter-AAAA
+cache-size=1000
+no-hosts
+# bind-dynamic = bind per-interface as they come up, not wildcard-at-start.
+# Lets the autogen section below reference usb0 even if it appears late.
+bind-dynamic
+# DNS upstream follows /etc/resolv.conf (dhcpcd manages it via openresolv).
+
+# Friendly hostnames for the portal regardless of which LAN the client is on.
+address=/rnsbox.local/setup.rnsbox/setup.lan/router.rnsbox/10.42.0.1
+
+# --- AUTOGEN MARKER --- per-LAN scopes appended at boot below ---
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S02resizefs b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S02resizefs
new file mode 100755
index 00000000..7e9f4a54
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S02resizefs
@@ -0,0 +1,44 @@
+#!/bin/sh
+# S02resizefs — grow the rootfs partition + ext4 to fill the whole SD card
+# on first boot (the shipped image is sized for the lite build; a DVD-class
+# card has more space). No-op when there is already <32 MiB of unallocated
+# space after the partition.
+DISK=/dev/mmcblk0
+PART=${DISK}p2
+
+[ -e "/sys/block/mmcblk0/mmcblk0p2/size" ] || exit 0
+disk_sec=$(cat /sys/block/mmcblk0/size 2>/dev/null)
+part_sec=$(cat /sys/block/mmcblk0/mmcblk0p2/size 2>/dev/null)
+part_start=$(cat /sys/block/mmcblk0/mmcblk0p2/start 2>/dev/null)
+[ -n "$disk_sec" ] && [ -n "$part_sec" ] && [ -n "$part_start" ] || exit 0
+
+free_sec=$(( disk_sec - part_start - part_sec ))
+if [ "$free_sec" -lt 65536 ]; then
+	# <32 MiB free — nothing worth growing (or already grown)
+	exit 0
+fi
+
+printf "S02resizefs: growing rootfs by %s MiB: " "$(( free_sec / 2048 ))"
+# Delete + recreate partition 2 with the same start, spanning to the end of
+# the card (leave the last 4 MiB untouched for alignment safety). busybox
+# fdisk accepts the same scripted stdin sequence as util-linux fdisk.
+{
+	echo d          # delete a partition
+	echo 2          #   -> partition 2
+	echo n          # new partition
+	echo p          #   -> primary
+	echo 2          #   -> number 2
+	echo "$part_start"  #   -> same first sector
+	echo            #   -> last sector = default (end of disk)
+	echo t          # change type
+	echo 2
+	echo 83         #   -> Linux
+	echo w          # write
+} | fdisk "$DISK" >/dev/null 2>&1 || { echo "fdisk failed"; exit 0; }
+
+# Make the kernel re-read the (larger) partition table, then grow the FS
+# online. If partx is unavailable, resize2fs still sees the old size and
+# no-ops harmlessly; a reboot completes the growth.
+partx -u "$DISK" 2>/dev/null || echo 1 > /sys/block/mmcblk0/device/rescan 2>/dev/null
+sleep 1
+resize2fs "$PART" >/dev/null 2>&1 && echo "OK" || echo "deferred to next boot"
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S30eth b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S30eth
new file mode 100755
index 00000000..600953cc
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S30eth
@@ -0,0 +1,90 @@
+#!/bin/sh
+# S30eth — bring up a WIRED WAN interface (eth0, a USB-Ethernet adapter on
+# this board) with either a DHCP lease or a static address, per
+# /etc/rnsbox/wan.conf.
+#
+# wlan0 (the onboard WiFi, the default WAN here) is NOT handled here: it is
+# owned by S35wifi (wpa_supplicant association) + dhcpcd. When wan.conf
+# selects wlan0 this script is a clean no-op.
+#
+# DHCP path: busybox udhcpc (its default.script writes the lease addr/route +
+#   /etc/resolv.conf). Backgrounded; persists, retries on late carrier.
+# Static path: `ip` assigns addr/route directly and we write resolv.conf
+#   ourselves (dnsmasq + the box's own resolver follow it).
+. /etc/profile
+
+WAN_CONF=/etc/rnsbox/wan.conf
+RESOLV=/etc/resolv.conf
+
+cfg() {
+	# value for key $1 from wan.conf (strip comments/space); empty if absent
+	grep -E "^[[:space:]]*$1[[:space:]]*=" "$WAN_CONF" 2>/dev/null | tail -1 \
+	  | sed -E "s/^[^=]*=[[:space:]]*//" | sed -E 's/[[:space:]]*#.*$//' \
+	  | sed -E 's/[[:space:]]*$//'
+}
+
+WAN_IF=$(cfg interface); [ -z "$WAN_IF" ] && WAN_IF=wlan0
+
+start_dhcp() {
+	# -t tries, -T timeout, -A wait-before-retry, -b background after lease fail
+	(udhcpc -i eth0 -t 10 -T 1 -A 5 -b -p /run/udhcpc.eth0.pid) &
+	echo "dhcp"
+}
+
+start_static() {
+	addr=$(cfg address); prefix=$(cfg prefix); gw=$(cfg gateway); dns=$(cfg dns)
+	[ -z "$prefix" ] && prefix=24
+	if [ -z "$addr" ]; then
+		echo "static requested but address empty — falling back to dhcp"
+		start_dhcp
+		return
+	fi
+	ip addr flush dev eth0 2>/dev/null
+	ip addr add "$addr/$prefix" dev eth0 2>/dev/null
+	ip link set eth0 up 2>/dev/null
+	if [ -n "$gw" ]; then
+		ip route del default 2>/dev/null
+		ip route add default via "$gw" dev eth0 2>/dev/null
+	fi
+	# Write resolv.conf for the static DNS servers. /etc/resolv.conf is a
+	# symlink into /tmp; rewrite the target so dnsmasq (upstream) + the box's
+	# own resolver pick the static servers up. Tag the lines so a later DHCP
+	# run on another iface can distinguish them.
+	if [ -n "$dns" ]; then
+		: > "$RESOLV"
+		for s in $dns; do echo "nameserver $s  # eth0-static" >> "$RESOLV"; done
+	fi
+	echo "static $addr/$prefix gw=${gw:-none} dns=${dns:-none}"
+}
+
+start() {
+	printf "start WAN (%s): " "$WAN_IF"
+	if [ "$WAN_IF" != "eth0" ]; then
+		echo "skipped (wan interface is $WAN_IF — owned by S35wifi/dhcpcd)"
+		return 0
+	fi
+	if [ ! -e /sys/class/net/eth0 ]; then
+		echo "skipped (no eth0 — no USB-Ethernet adapter present)"
+		return 0
+	fi
+	mode=$(cfg mode); [ -z "$mode" ] && mode=dhcp
+	case "$mode" in
+		static) start_static ;;
+		*)      start_dhcp ;;
+	esac
+}
+
+stop() {
+	if [ -f /run/udhcpc.eth0.pid ]; then
+		kill "$(cat /run/udhcpc.eth0.pid)" 2>/dev/null
+		rm -f /run/udhcpc.eth0.pid
+	fi
+	ip addr flush dev eth0 2>/dev/null
+}
+
+case "${1:-start}" in
+	start)   start ;;
+	stop)    stop ;;
+	restart) stop; start ;;
+	*)       echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
+esac
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S60routing b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S60routing
new file mode 100755
index 00000000..8c6a1ec5
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S60routing
@@ -0,0 +1,167 @@
+#!/bin/sh
+# S60routing — kernel routing knobs + regenerate nftables.conf and the
+# per-LAN dnsmasq scope, then apply.
+#
+# Runs after S30gadget_nic (usb0), S30eth (eth0 lease) and S35wifi (so an
+# AP iface, if any, already exists and can be folded into the LAN side).
+# Re-runnable as `restart` whenever the portal edits the rnsbox configs.
+#
+# nftables ruleset comes from `python3 -m rnsbox_portal.nftgen` (single
+# source of truth shared with the Flask UI). Pre-validate with `nft -c -f`
+# (validate-before-swap discipline) before atomically swapping the live config so a bad
+# generated rule can't lock us out.
+
+WAN_CONF=/etc/rnsbox/wan.conf
+NFT_FILE=/etc/nftables.conf
+DNSMASQ_FILE=/etc/dnsmasq.conf
+NFTGEN="/usr/sbin/rnsbox-portal nftgen"
+
+USB0_LAN_IP=10.42.0.1
+USB0_LAN_DHCP_START=10.42.0.10
+USB0_LAN_DHCP_END=10.42.0.20
+AUTOGEN_DNSMASQ="# --- AUTOGEN MARKER --- per-LAN scopes appended at boot below ---"
+
+# RNSBox W variant: S35wifi writes the AP iface name to /run/wifi-ap-iface
+# when a hotspot is up. Fold it into the LAN side so it gets NAT + a DHCP
+# scope automatically. WiFi subnet read from /etc/rnsbox/wifi.conf.
+WIFI_CONF=/etc/rnsbox/wifi.conf
+wifi_cfg() {
+	grep -E "^[[:space:]]*$1[[:space:]]*=" "$WIFI_CONF" 2>/dev/null | tail -1 \
+	  | sed -E "s/^[^=]*=[[:space:]]*//" | sed -E 's/[[:space:]]*#.*$//' \
+	  | sed -E 's/[[:space:]]*$//'
+}
+
+read_wan() {
+	# wan.conf is now key=value (interface=eth0). Prefer the interface= key;
+	# fall back to a legacy bare "eth0"/"wlan0" line if no key is present.
+	WAN=$(grep -E '^[[:space:]]*interface[[:space:]]*=' "$WAN_CONF" 2>/dev/null \
+	  | tail -1 | sed -E 's/^[^=]*=[[:space:]]*//' | sed -E 's/[[:space:]]*#.*$//' \
+	  | tr -d '[:space:]')
+	[ -z "$WAN" ] && WAN=$(grep -vE '^[[:space:]]*#|^[[:space:]]*$|=' "$WAN_CONF" 2>/dev/null | head -1 | tr -d '[:space:]')
+	case "$WAN" in eth0|wlan0) ;; *) WAN=wlan0 ;; esac
+}
+
+read_lan() {
+	LAN_IFACES="usb0"
+	AP_IF=""
+	if [ -r /run/wifi-ap-iface ]; then
+		AP_IF=$(cat /run/wifi-ap-iface 2>/dev/null | tr -d '[:space:]')
+		[ -n "$AP_IF" ] && [ -e "/sys/class/net/$AP_IF" ] && LAN_IFACES="usb0,$AP_IF"
+	fi
+}
+
+regen_nftables() {
+	TMP=$(mktemp /tmp/nftables.conf.XXXXXX) || return 1
+	if ! $NFTGEN --wan "$WAN" --lan "$LAN_IFACES" > "$TMP" 2>/var/log/nftgen.err; then
+		echo "S60routing: nftgen failed (see /var/log/nftgen.err); keeping previous $NFT_FILE"
+		rm -f "$TMP"
+		return 1
+	fi
+	if ! nft -c -f "$TMP" >>/var/log/nftgen.err 2>&1; then
+		echo "S60routing: generated ruleset failed nft -c validation; keeping previous $NFT_FILE"
+		rm -f "$TMP"
+		return 1
+	fi
+	mv "$TMP" "$NFT_FILE"
+	chmod 0644 "$NFT_FILE"
+}
+
+regen_dnsmasq() {
+	if grep -q "$AUTOGEN_DNSMASQ" "$DNSMASQ_FILE" 2>/dev/null; then
+		sed -i "/$AUTOGEN_DNSMASQ/q" "$DNSMASQ_FILE"
+	fi
+	{
+		echo
+		echo "# WAN=$WAN (DHCP not served here — eth0 receives a lease, doesn't serve one)"
+		echo "no-dhcp-interface=$WAN"
+		echo
+		echo "# usb0 LAN"
+		echo "interface=usb0"
+		echo "dhcp-range=set:usb0,$USB0_LAN_DHCP_START,$USB0_LAN_DHCP_END,255.255.255.0,12h"
+		echo "dhcp-option=tag:usb0,3,$USB0_LAN_IP"
+		echo "dhcp-option=tag:usb0,6,$USB0_LAN_IP"
+		# RNSBox W variant: AP hotspot scope (only when S35wifi has an AP up).
+		if [ -n "$AP_IF" ] && [ -e "/sys/class/net/$AP_IF" ]; then
+			AP_IP=$(wifi_cfg ap_ip); [ -z "$AP_IP" ] && AP_IP=192.168.42.1
+			AP_DS=$(wifi_cfg ap_dhcp_start); [ -z "$AP_DS" ] && AP_DS=192.168.42.10
+			AP_DE=$(wifi_cfg ap_dhcp_end); [ -z "$AP_DE" ] && AP_DE=192.168.42.100
+			echo
+			echo "# $AP_IF WiFi AP LAN"
+			echo "interface=$AP_IF"
+			echo "dhcp-range=set:$AP_IF,$AP_DS,$AP_DE,255.255.255.0,12h"
+			echo "dhcp-option=tag:$AP_IF,3,$AP_IP"
+			echo "dhcp-option=tag:$AP_IF,6,$AP_IP"
+		fi
+	} >> "$DNSMASQ_FILE"
+}
+
+start() {
+	read_wan
+	read_lan
+	echo "S60routing: WAN=$WAN LAN=$LAN_IFACES"
+
+	# --- routing knobs ---
+	echo 1 > /proc/sys/net/ipv4/ip_forward
+	echo 0 > /proc/sys/net/ipv4/conf/all/rp_filter
+	echo 0 > /proc/sys/net/ipv4/conf/default/rp_filter
+	echo 0 > /proc/sys/net/ipv4/conf/all/accept_redirects
+	echo 0 > /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || true
+	# route_localnet on the WAN iface: lets a port forward whose target is a
+	# loopback address (127.0.0.0/8 — e.g. a service that binds only to
+	# 127.0.0.1) actually be delivered. Without it, a packet DNAT'd to 127.x
+	# arriving on a real iface is dropped as a martian before INPUT. Forwards
+	# to the box's real LAN IP (10.42.0.1) don't need this; loopback ones do.
+	# Safe: INPUT's drop policy + the "ct status dnat" gate mean only flows
+	# our own prerouting DNAT created can reach a local service this way.
+	echo 1 > "/proc/sys/net/ipv4/conf/$WAN/route_localnet" 2>/dev/null || true
+
+	# --- throughput tuning ---
+	for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
+		[ -w "$g" ] && echo performance > "$g" 2>/dev/null
+	done
+	echo 4194304 > /proc/sys/net/core/rmem_max
+	echo 4194304 > /proc/sys/net/core/wmem_max
+	echo 1048576 > /proc/sys/net/core/rmem_default
+	echo 1048576 > /proc/sys/net/core/wmem_default
+	echo "4096 1048576 4194304" > /proc/sys/net/ipv4/tcp_rmem
+	echo "4096 524288 4194304"  > /proc/sys/net/ipv4/tcp_wmem
+	echo 4000 > /proc/sys/net/core/netdev_max_backlog
+	echo 600 > /proc/sys/net/core/netdev_budget 2>/dev/null
+	echo 8000 > /proc/sys/net/core/netdev_budget_usecs 2>/dev/null
+	echo 0 > /proc/sys/net/ipv4/tcp_slow_start_after_idle 2>/dev/null
+	echo 15 > /proc/sys/net/ipv4/tcp_fin_timeout 2>/dev/null
+	echo 1 > /proc/sys/net/ipv4/tcp_tw_reuse 2>/dev/null
+	echo 3 > /proc/sys/net/ipv4/tcp_fastopen 2>/dev/null
+	if grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null; then
+		echo bbr > /proc/sys/net/ipv4/tcp_congestion_control
+	fi
+	[ -d /sys/module/sch_fq ] || modprobe sch_fq 2>/dev/null
+	echo fq > /proc/sys/net/core/default_qdisc 2>/dev/null
+
+	# --- regenerate + apply ---
+	regen_dnsmasq
+	regen_nftables
+
+	nft flush ruleset 2>/dev/null
+	if [ -r "$NFT_FILE" ]; then
+		nft -f "$NFT_FILE"
+	fi
+
+	if [ -x /etc/init.d/S80dnsmasq ]; then
+		/etc/init.d/S80dnsmasq restart >/dev/null 2>&1 || true
+	elif pidof dnsmasq >/dev/null 2>&1; then
+		killall -HUP dnsmasq 2>/dev/null || true
+	fi
+}
+
+stop() {
+	nft flush ruleset 2>/dev/null || true
+	echo 0 > /proc/sys/net/ipv4/ip_forward
+}
+
+case "${1:-start}" in
+	start)   start ;;
+	stop)    stop ;;
+	restart) stop; start ;;
+	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
+esac
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/nftables.conf b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/nftables.conf
new file mode 100644
index 00000000..bd8139e1
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/nftables.conf
@@ -0,0 +1,46 @@
+# /etc/nftables.conf — REGENERATED AT BOOT by /etc/init.d/S60routing.
+#
+# This static fallback is only used if S60routing's call to
+# `python3 -m rnsbox_portal.nftgen` fails (defensive: keeps SSH + NAT
+# working even if the portal package is broken). The fallback intentionally
+# has NO port forwards and NO non-SSH WAN-exposed services.
+#
+# Re-render the live config (after editing /etc/rnsbox/*.conf) via:
+#   /etc/init.d/S60routing restart
+#
+# Topology assumption: WAN=eth0, LAN=usb0. If WAN is different the
+# fallback won't masquerade correctly — boot S60routing to regenerate.
+
+flush ruleset
+
+table inet filter {
+	chain input {
+		type filter hook input priority filter; policy drop;
+		ct state invalid drop
+		ct state established,related accept
+		iifname "lo" accept
+		icmp type echo-request limit rate 10/second accept
+		icmpv6 type { echo-request, nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert } accept
+		# LAN: full surface (HTTP UI, SSH, DHCP, DNS, etc.)
+		iifname "usb0" accept
+		# WAN: SSH only by default
+		iifname "wlan0" tcp dport 22 accept
+	}
+	chain forward {
+		type filter hook forward priority filter; policy drop;
+		ct state invalid drop
+		ct state established,related accept
+		iifname "usb0" oifname "wlan0" accept
+	}
+	chain output { type filter hook output priority filter; policy accept; }
+}
+
+table ip nat {
+	chain prerouting {
+		type nat hook prerouting priority dstnat; policy accept;
+	}
+	chain postrouting {
+		type nat hook postrouting priority srcnat; policy accept;
+		oifname "wlan0" masquerade
+	}
+}
