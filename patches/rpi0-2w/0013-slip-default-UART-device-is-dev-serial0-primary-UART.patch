From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Fri, 25 Sep 2026 06:42:41 +0300
Subject: [PATCH 13/17] slip: default UART device is /dev/serial0 (primary-UART
 alias)

With this kernel generation the PL011 can enumerate as ttyAMA1 (the
mini-uart taking AMA0), so the bare ttyAMA0 name is not stable.
/dev/serial0 is the canonical primary-UART alias and always maps to the
PL011 on GPIO14/15 with Bluetooth disabled.
---
 .../raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S31slip | 2 +-
 .../rnsbox-0-2w/rootfs-overlay/etc/rnsbox/slip.conf           | 4 ++--
 package/rnsbox-portal/src/cgi/helpers/halow.py                | 2 +-
 package/rnsbox-portal/src/cgi/pages/reticulum.html            | 2 +-
 package/rnsbox-portal/src/cgi/store.cpp                       | 2 +-
 package/rnsbox-portal/src/cgi/store.h                         | 2 +-
 6 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S31slip b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S31slip
index 0ff80e75..129554dc 100755
--- a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S31slip
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S31slip
@@ -23,7 +23,7 @@ start() {
 	enabled=$(cfg enabled)
 	case "$enabled" in yes|true|1|on) ;; *) echo "S31slip: disabled"; return 0 ;; esac
 
-	device=$(cfg device);     [ -n "$device" ]   || device=/dev/ttyAMA0
+	device=$(cfg device);     [ -n "$device" ]   || device=/dev/serial0
 	baud=$(cfg baud);         [ -n "$baud" ]     || baud=2000000
 	local_ip=$(cfg local_ip); [ -n "$local_ip" ] || local_ip=192.168.7.1
 	peer_ip=$(cfg peer_ip);   [ -n "$peer_ip" ]  || peer_ip=192.168.7.2
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/slip.conf b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/slip.conf
index d2f1b255..3dad10aa 100644
--- a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/slip.conf
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/slip.conf
@@ -12,7 +12,7 @@
 #
 # Wiring (Pi Zero 2 W): the hardware UART (PL011) on GPIO14 (TX, physical
 # pin 8) / GPIO15 (RX, pin 10), 3.3 V, common ground — device =
-# /dev/ttyAMA0. Bluetooth is disabled and the kernel console kept off the
+# /dev/serial0. Bluetooth is disabled and the kernel console kept off the
 # UART by this image, so the port is fully free for this link.
 #
 # baud MUST match the modem's SLIP baud. The modem's default 2000000 is
@@ -22,7 +22,7 @@
 # 192.168.7.2 device / 192.168.7.1 host).
 
 enabled=no
-device=/dev/ttyAMA0
+device=/dev/serial0
 baud=2000000
 local_ip=192.168.7.1
 peer_ip=192.168.7.2
diff --git a/package/rnsbox-portal/src/cgi/helpers/halow.py b/package/rnsbox-portal/src/cgi/helpers/halow.py
index 7cb99dbc..0d0fdfe1 100644
--- a/package/rnsbox-portal/src/cgi/helpers/halow.py
+++ b/package/rnsbox-portal/src/cgi/helpers/halow.py
@@ -14,7 +14,7 @@ SLIP_CONF = "/etc/rnsbox/slip.conf"
 
 
 def read_slip():
-    cfg = {"enabled": "no", "device": "/dev/ttyAMA0", "baud": "2000000",
+    cfg = {"enabled": "no", "device": "/dev/serial0", "baud": "2000000",
            "local_ip": "192.168.7.1", "peer_ip": "192.168.7.2"}
     try:
         with open(SLIP_CONF) as f:
diff --git a/package/rnsbox-portal/src/cgi/pages/reticulum.html b/package/rnsbox-portal/src/cgi/pages/reticulum.html
index 1d90af53..2cc0ca1f 100644
--- a/package/rnsbox-portal/src/cgi/pages/reticulum.html
+++ b/package/rnsbox-portal/src/cgi/pages/reticulum.html
@@ -73,7 +73,7 @@
     <button type="submit" class="btn-primary" style="margin-top:10px">Save &amp; apply</button>
     <p class="muted">Wire the hardware UART (<code>GPIO14</code> TX = physical pin 8,
     <code>GPIO15</code> RX = pin 10, 3.3&nbsp;V) to the modem, cross TX&harr;RX, common ground &mdash;
-    device <code>/dev/ttyAMA0</code>. Bluetooth is disabled and the serial console kept off the
+    device <code>/dev/serial0</code>. Bluetooth is disabled and the serial console kept off the
     UART so the port is free. <strong>Baud must match the modem</strong> &mdash; 2&nbsp;Mbaud (the
     modem default; the PL011 handles it) is pre-filled. The IPs must match the modem&rsquo;s SLIP
     config (defaults <code>192.168.7.2</code> modem / <code>192.168.7.1</code> box).</p>
diff --git a/package/rnsbox-portal/src/cgi/store.cpp b/package/rnsbox-portal/src/cgi/store.cpp
index 0187aaa4..d21f943e 100644
--- a/package/rnsbox-portal/src/cgi/store.cpp
+++ b/package/rnsbox-portal/src/cgi/store.cpp
@@ -353,7 +353,7 @@ SlipConfig read_slip() {
 
 bool write_slip(const SlipConfig& c, std::string& err) {
     std::string en = cron_truthy(c.enabled) ? "yes" : "no";
-    std::string dev = c.device.empty() ? "/dev/ttyAMA0" : c.device;
+    std::string dev = c.device.empty() ? "/dev/serial0" : c.device;
     if (!valid_tty(dev)) { err = "bad device path"; return false; }
     int baud = atoi(c.baud.c_str());
     if (baud < 1 || baud > 4000000) { err = "baud out of range (1-4000000)"; return false; }
diff --git a/package/rnsbox-portal/src/cgi/store.h b/package/rnsbox-portal/src/cgi/store.h
index 5948f1b5..dbfe87c4 100644
--- a/package/rnsbox-portal/src/cgi/store.h
+++ b/package/rnsbox-portal/src/cgi/store.h
@@ -71,7 +71,7 @@ std::vector<std::string> write_ntp_servers(const std::vector<std::string>& serve
 // --- SLIP link to an external HaLow (RNode) modem ---
 struct SlipConfig {
     std::string enabled = "no";
-    std::string device = "/dev/ttyAMA0";
+    std::string device = "/dev/serial0";
     std::string baud = "2000000";
     std::string local_ip = "192.168.7.1";
     std::string peer_ip = "192.168.7.2";
