diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S83nomadnet b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S83nomadnet
new file mode 100755
index 00000000..238a0257
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S83nomadnet
@@ -0,0 +1,101 @@
+#!/bin/sh
+# S83nomadnet — Nomadnet daemon (LXMF propagation node + nomadnet pages
+# server). Shipped DISABLED by default — most RNSBox owners only want
+# rnsd (S82rnsd). Enable by flipping `enabled=no` -> `enabled=yes` in
+# /etc/rnsbox/nomadnet.conf, then run this script with `start`.
+#
+# Like S82rnsd, gates on /run/clock-synced. Nomadnet stamps every LXMF
+# message + announce with wall-clock time; a 1970 clock makes peers
+# reject everything we send.
+
+NAME=nomadnet
+DAEMON=/usr/bin/nomadnet
+CONF=/etc/rnsbox/nomadnet.conf
+PIDFILE=/var/run/$NAME.pid
+LOG=/var/log/$NAME.log
+DEFAULT_CONFIGDIR=/var/lib/nomadnetwork
+
+[ -x "$DAEMON" ] || exit 0
+
+# --- read the enable flag (single key=value lines, no shell sourcing) ---
+read_conf() {
+	enabled="no"
+	configdir="$DEFAULT_CONFIGDIR"
+	if [ -r "$CONF" ]; then
+		v=$(grep -E '^[[:space:]]*enabled[[:space:]]*=' "$CONF" 2>/dev/null \
+		      | tail -1 | sed -E 's/^[[:space:]]*enabled[[:space:]]*=[[:space:]]*//' \
+		      | tr -d '"' | tr -d "'" | tr '[:upper:]' '[:lower:]' \
+		      | awk '{print $1}')
+		case "$v" in yes|true|1|on) enabled="yes" ;; esac
+		c=$(grep -E '^[[:space:]]*configdir[[:space:]]*=' "$CONF" 2>/dev/null \
+		      | tail -1 | sed -E 's/^[[:space:]]*configdir[[:space:]]*=[[:space:]]*//' \
+		      | tr -d '"' | tr -d "'" | awk '{print $1}')
+		[ -n "$c" ] && configdir="$c"
+	fi
+}
+
+start() {
+	read_conf
+	if [ "$enabled" != "yes" ]; then
+		echo "S83nomadnet: disabled in $CONF (enabled=$enabled); skipping"
+		echo "             flip to 'enabled=yes' to start at boot"
+		return 0
+	fi
+
+	mkdir -p /var/log /var/run "$configdir"
+
+	if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
+		echo "S83nomadnet: already running (pid $(cat $PIDFILE))"
+		return 0
+	fi
+
+	if [ ! -f /run/clock-synced ]; then
+		echo "S83nomadnet: refusing to start - /run/clock-synced absent"
+		echo "             (S45ntpsync did not succeed; check WAN link)"
+		return 1
+	fi
+
+	printf "Starting %s: " "$NAME"
+	"$DAEMON" --daemon --configdir "$configdir" >>"$LOG" 2>&1 &
+	PID=$!
+	echo "$PID" > "$PIDFILE"
+	sleep 0.3
+	if kill -0 "$PID" 2>/dev/null; then
+		echo "OK (pid $PID, configdir $configdir)"
+	else
+		echo "FAIL (see $LOG)"
+		rm -f "$PIDFILE"
+		return 1
+	fi
+}
+
+stop() {
+	printf "Stopping %s: " "$NAME"
+	if [ -f "$PIDFILE" ]; then
+		kill "$(cat $PIDFILE)" 2>/dev/null
+		for _ in 1 2 3 4 5; do
+			[ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null || break
+			sleep 1
+		done
+		rm -f "$PIDFILE"
+		echo "OK"
+	else
+		echo "(not running)"
+	fi
+}
+
+case "${1:-start}" in
+	start)   start ;;
+	stop)    stop ;;
+	restart) stop; sleep 1; start ;;
+	status)
+		read_conf
+		echo "enabled in conf: $enabled"
+		if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
+			echo "running:         pid $(cat $PIDFILE)"
+		else
+			echo "running:         no"
+		fi
+		;;
+	*) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
+esac
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S84cron b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S84cron
new file mode 100755
index 00000000..77fc3db2
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S84cron
@@ -0,0 +1,88 @@
+#!/bin/sh
+# S84cron — regenerate the root crontab from /etc/rnsbox/cron.conf and start
+# busybox crond. Runs after S82rnsd (so rnsd is up before any restart job).
+#
+# Why regenerate at boot: busybox crond reads /var/spool/cron/crontabs/root,
+# and /var/spool -> /tmp is tmpfs (wiped each boot). The persistent source of
+# truth is /etc/rnsbox/cron.conf; this script materializes it into the spool.
+#
+# Currently the only scheduled task is the optional rnsd auto-restart
+# (memory hygiene): rnsd_restart_days=N restarts rnsd every N days at 04:00.
+# N=0 (default) means no crontab entry — crond still runs but has nothing to do.
+
+CONF=/etc/rnsbox/cron.conf
+CRONDIR=/var/spool/cron/crontabs
+CRONTAB="$CRONDIR/root"
+LOG=/var/log/cron.log
+
+cfg() {
+	grep -E "^[[:space:]]*$1[[:space:]]*=" "$CONF" 2>/dev/null | tail -1 \
+	  | sed -E "s/^[^=]*=[[:space:]]*//" | sed -E 's/[[:space:]]*#.*$//' \
+	  | sed -E 's/[[:space:]]*$//'
+}
+
+gen_crontab() {
+	mkdir -p "$CRONDIR"
+	days=$(cfg rnsd_restart_days)
+	case "$days" in ''|*[!0-9]*) days=0 ;; esac
+	uc=$(cfg update_check)
+	case "$uc" in no|No|NO|0|false|off) uc=no ;; *) uc=yes ;; esac
+	{
+		echo "# Auto-generated by S84cron from $CONF — do not hand-edit."
+		echo "# (edit /etc/rnsbox/cron.conf or use the portal Reticulum tab)"
+		if [ "$days" -ge 1 ] 2>/dev/null && [ "$days" -le 7 ]; then
+			# min hour day-of-month month day-of-week  command
+			# every N days at 04:00
+			echo "0 4 */$days * * /etc/init.d/S82rnsd restart >> $LOG 2>&1"
+		fi
+		if [ "$uc" = yes ]; then
+			# daily at 05:00: notify-only check for a newer rnsd (offline-safe)
+			echo "0 5 * * * /usr/sbin/rnsbox-update-check >> $LOG 2>&1"
+		fi
+	} > "$CRONTAB"
+	chmod 600 "$CRONTAB"
+	[ "$days" -ge 1 ] 2>/dev/null && echo "S84cron: rnsd auto-restart every $days day(s) at 04:00" \
+	                              || echo "S84cron: rnsd auto-restart disabled"
+	[ "$uc" = yes ] && echo "S84cron: daily rnsd update check enabled" \
+	                || echo "S84cron: rnsd update check disabled"
+}
+
+start() {
+	gen_crontab
+	# -b = background; -c = crontab dir (parent of crontabs/). Start only if
+	# not already running.
+	if ! pidof crond >/dev/null 2>&1; then
+		crond -b -c "$CRONDIR" 2>>"$LOG"
+	fi
+	# Best-effort update check shortly after boot (once the clock is synced and
+	# WAN may be up). Backgrounded so it never blocks boot; quiet when offline.
+	# ($uc was set by gen_crontab above.)
+	if [ "$uc" = yes ]; then
+		( sleep 30; [ -f /run/clock-synced ] && /usr/sbin/rnsbox-update-check ) >>"$LOG" 2>&1 &
+	fi
+}
+
+stop() {
+	killall crond 2>/dev/null
+}
+
+# `reload` = regenerate the crontab and signal crond to re-read, without a full
+# restart. The portal calls this after changing the schedule.
+reload() {
+	gen_crontab
+	if pidof crond >/dev/null 2>&1; then
+		# busybox crond re-reads when the crontab mtime changes; gen_crontab
+		# rewrote it, so a HUP or just leaving it is enough. HUP to be prompt.
+		killall -HUP crond 2>/dev/null || true
+	else
+		crond -b -c "$CRONDIR" 2>>"$LOG"
+	fi
+}
+
+case "${1:-start}" in
+	start)   start ;;
+	stop)    stop ;;
+	restart) stop; sleep 1; start ;;
+	reload)  reload ;;
+	*) echo "Usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
+esac
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S85lxmd b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S85lxmd
new file mode 100755
index 00000000..3e4d7f5d
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S85lxmd
@@ -0,0 +1,127 @@
+#!/bin/sh
+# S85lxmd — dedicated LXMF Propagation Node (lxmd), shipped DISABLED by default.
+#
+# lxmd is the lightweight, headless propagation node (store-and-forward relay
+# for offline peers) — the frugal alternative to NomadNet's built-in one (no
+# pages server, no TUI). Enable by setting `enabled=yes` in
+# /etc/rnsbox/lxmd.conf, then reboot or run this script with `start`.
+#
+# Runs AFTER S82rnsd so it attaches to rnsd's *shared* Reticulum instance
+# (--rnsconfig /etc/reticulum) instead of starting a second transport stack —
+# critical on a 245 MB box. Gates on /run/clock-synced (LXMF stamps stored
+# messages + announces with wall-clock time) AND on a free-RAM floor, so a
+# tight box can't OOM-kill rnsd by starting lxmd.
+
+NAME=lxmd
+DAEMON=/usr/bin/lxmd
+CONF=/etc/rnsbox/lxmd.conf
+LXMD_CONFIGDIR=/etc/lxmd
+RNS_CONFIGDIR=/etc/reticulum
+PIDFILE=/var/run/$NAME.pid
+LOG=/var/log/$NAME.log
+
+[ -x "$DAEMON" ] || exit 0
+
+# --- read the enable flag + RAM floor (flat key=value, no shell sourcing) ---
+read_conf() {
+	enabled="no"
+	min_free_mb=60
+	if [ -r "$CONF" ]; then
+		v=$(grep -E '^[[:space:]]*enabled[[:space:]]*=' "$CONF" 2>/dev/null \
+		      | tail -1 | sed -E 's/^[[:space:]]*enabled[[:space:]]*=[[:space:]]*//' \
+		      | tr -d '"' | tr -d "'" | tr '[:upper:]' '[:lower:]' | awk '{print $1}')
+		case "$v" in yes|true|1|on) enabled="yes" ;; esac
+		m=$(grep -E '^[[:space:]]*min_free_mb[[:space:]]*=' "$CONF" 2>/dev/null \
+		      | tail -1 | sed -E 's/^[[:space:]]*min_free_mb[[:space:]]*=[[:space:]]*//' \
+		      | tr -d '"' | tr -d "'" | awk '{print $1}')
+		case "$m" in ''|*[!0-9]*) ;; *) min_free_mb="$m" ;; esac
+	fi
+}
+
+mem_available_mb() {
+	awk '/^MemAvailable:/{print int($2/1024); found=1} END{if(!found) print 0}' /proc/meminfo 2>/dev/null
+}
+
+start() {
+	read_conf
+	if [ "$enabled" != "yes" ]; then
+		echo "S85lxmd: disabled in $CONF (enabled=$enabled); skipping"
+		echo "         set 'enabled=yes' to run an LXMF propagation node"
+		return 0
+	fi
+
+	if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
+		echo "S85lxmd: already running (pid $(cat $PIDFILE))"
+		return 0
+	fi
+
+	if [ ! -f /run/clock-synced ]; then
+		echo "S85lxmd: refusing to start - /run/clock-synced absent"
+		echo "         (LXMF needs a real clock to stamp stored messages)"
+		return 1
+	fi
+
+	# Attach to rnsd's shared instance — don't start a second transport stack.
+	if [ -z "$(pidof rnsd)" ]; then
+		echo "S85lxmd: refusing to start - rnsd (S82rnsd) is not running"
+		echo "         lxmd shares rnsd's Reticulum instance; start rnsd first"
+		return 1
+	fi
+
+	# RAM floor: protect rnsd (the core service) from an OOM kill.
+	avail=$(mem_available_mb)
+	if [ "$avail" -lt "$min_free_mb" ]; then
+		echo "S85lxmd: refusing to start - only ${avail} MB free (< min_free_mb=${min_free_mb})"
+		echo "         free RAM first (e.g. 'S81router stop' to stop the web UI)"
+		echo "         or lower min_free_mb in $CONF if you know your budget"
+		return 1
+	fi
+
+	mkdir -p /var/log /var/run "$LXMD_CONFIGDIR"
+
+	printf "Starting %s: " "$NAME"
+	# -p = propagation node; --rnsconfig points at rnsd's shared instance.
+	# No -s: log to the size-capped /var/log tmpfs instead of the rootfs.
+	"$DAEMON" -p --rnsconfig "$RNS_CONFIGDIR" --config "$LXMD_CONFIGDIR" >>"$LOG" 2>&1 &
+	PID=$!
+	echo "$PID" > "$PIDFILE"
+	sleep 0.5
+	if kill -0 "$PID" 2>/dev/null; then
+		echo "OK (pid $PID, ${avail} MB free, shared instance)"
+	else
+		echo "FAIL (see $LOG)"
+		rm -f "$PIDFILE"
+		return 1
+	fi
+}
+
+stop() {
+	printf "Stopping %s: " "$NAME"
+	if [ -f "$PIDFILE" ]; then
+		kill "$(cat $PIDFILE)" 2>/dev/null
+		for _ in 1 2 3 4 5; do
+			[ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null || break
+			sleep 1
+		done
+		rm -f "$PIDFILE"
+		echo "OK"
+	else
+		echo "(not running)"
+	fi
+}
+
+case "${1:-start}" in
+	start)   start ;;
+	stop)    stop ;;
+	restart) stop; sleep 1; start ;;
+	status)
+		read_conf
+		echo "enabled in conf: $enabled  (min_free_mb=$min_free_mb, free now $(mem_available_mb) MB)"
+		if [ -f "$PIDFILE" ] && kill -0 "$(cat $PIDFILE)" 2>/dev/null; then
+			echo "running:         pid $(cat $PIDFILE)"
+		else
+			echo "running:         no"
+		fi
+		;;
+	*) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
+esac
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/lxmd/config b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/lxmd/config
new file mode 100644
index 00000000..e91573e2
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/lxmd/config
@@ -0,0 +1,30 @@
+# RNSBox lxmd config — a dedicated LXMF Propagation Node.
+# Gated by /etc/rnsbox/lxmd.conf (whether S85lxmd starts lxmd at all); this
+# file tunes the node itself. Run `lxmd --exampleconfig` for every option.
+
+[propagation]
+
+# Run as a propagation node (S85lxmd also passes -p, so this is belt-and-braces).
+enable_node = yes
+
+# Name announced to the network.
+node_name = RNSBox Propagation Node
+
+# Announce every 6 hours, and once at startup.
+announce_interval = 360
+announce_at_start = yes
+
+# Peer automatically with nearby propagation nodes.
+autopeer = yes
+autopeer_maxdepth = 6
+
+# Message-store cap in MB, on the rootfs. Kept small for the 256 MB / SD-card
+# box (upstream default is 500). LXMF evicts old/large messages first when full.
+message_storage_limit = 64
+
+[lxmf]
+display_name = RNSBox
+
+[logging]
+# 0=critical .. 4=debug. 3=info; lower to 2 to keep the log quiet.
+loglevel = 3
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/cron.conf b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/cron.conf
new file mode 100644
index 00000000..8ab56eb9
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/cron.conf
@@ -0,0 +1,20 @@
+# RNSBox scheduled tasks — managed by the rnsbox-portal Reticulum tab.
+#
+# rnsd_restart_days:
+#   0   disabled (default) — no automatic restart; the operator decides.
+#   N   restart rnsd every N days (N = 1..7) at 04:00, via cron, as a memory
+#       hygiene measure. rnsd's RAM use is announce-cache growth, not a leak,
+#       but a periodic restart bounds the long-run envelope on the 245 MB box.
+#
+# Applied by /etc/init.d/S84cron at boot (it regenerates the root crontab and
+# starts crond) and live by the portal when you change it in the UI.
+
+rnsd_restart_days=0
+
+# update_check:
+#   yes  (default) once a day, and shortly after boot, check PyPI for a newer
+#        rnsd (Reticulum) release and show a notice in the portal. Notify-only:
+#        it never changes the installed package or any config, and fails
+#        quietly when the box is offline.
+#   no   disable the periodic update check.
+update_check=yes
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/lxmd.conf b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/lxmd.conf
new file mode 100644
index 00000000..69780902
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/lxmd.conf
@@ -0,0 +1,29 @@
+# lxmd daemon config — read at boot by /etc/init.d/S85lxmd.
+#
+# lxmd runs a *dedicated* LXMF Propagation Node: a store-and-forward relay that
+# holds LXMF messages for peers who are offline and delivers them when they sync
+# back. It is the lightweight, headless alternative to NomadNet's built-in
+# propagation node (no pages server, no TUI) — the right choice when a
+# propagation node is ALL you want.
+#
+# Shipped DISABLED by default. To enable: set `enabled=yes` below, then reboot
+# or run `/etc/init.d/S85lxmd start`. The propagation node's own settings
+# (message store size, node name, peering) live in /etc/lxmd/config.
+#
+# *** RAM CAUTION — read this ***
+# The LicheeRV Nano-e has only 256 MB. rnsd + the web portal already use most of
+# it. lxmd is another Python process (~30-50 MB of private RAM on top of rnsd).
+# It attaches to rnsd's *shared* Reticulum instance, so it does NOT start a
+# second transport stack — but the interpreter + LXMF state still cost memory.
+# To protect rnsd from being OOM-killed, S85lxmd REFUSES to start when free
+# memory is below `min_free_mb`. If it refuses, free some RAM first — e.g. stop
+# the web UI with `S81router stop` — or lower min_free_mb if you know your
+# headroom. Do NOT also run NomadNet's propagation node (S83nomadnet): that is
+# two propagation nodes for no benefit and roughly double the RAM.
+
+enabled=no
+
+# Minimum free memory (MB, read from /proc/meminfo MemAvailable) required before
+# S85lxmd will start lxmd. Guards rnsd against OOM. Lower only if you understand
+# your RAM budget.
+min_free_mb=60
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/nomadnet.conf b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/nomadnet.conf
new file mode 100644
index 00000000..170da45e
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/nomadnet.conf
@@ -0,0 +1,20 @@
+# Nomadnet daemon config — read at boot by /etc/init.d/S83nomadnet.
+#
+# Nomadnet is the Reticulum-based LXMF propagation node + page server
+# ("pages" = gopher-like browsable content over the mesh). It's shipped
+# with the image but NOT started at boot by default — most RNSBox owners
+# just want rnsd (transport), and adding nomadnet pulls another ~30 MB
+# of Python state at runtime plus listens on extra Reticulum destinations.
+#
+# To enable: change `enabled=no` to `enabled=yes` below, then either
+# reboot or run:
+#   /etc/init.d/S83nomadnet start
+#
+# Content lives under `configdir` (default /var/lib/nomadnetwork).
+# Edit page sources in $configdir/storage/pages/ — see
+# https://github.com/markqvist/NomadNet for the page format.
+
+enabled=no
+
+# Optional overrides (uncomment to use):
+#configdir=/var/lib/nomadnetwork
diff --git a/configs/rnsbox_rpi0_2w_64_defconfig b/configs/rnsbox_rpi0_2w_64_defconfig
index f230eb78..cc67d092 100644
--- a/configs/rnsbox_rpi0_2w_64_defconfig
