From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Sat, 26 Sep 2026 03:58:00 +0300
Subject: [PATCH 16/16] gadget: absolute os_desc symlink target; fstab: drop
 the /var/lock tmpfs line

configfs resolves symlink targets from the string given - a relative
'configs/c.1' from cwd=/ does not resolve; use the absolute in-configfs
path. /var/lock is a skeleton symlink into /run (already tmpfs), so the
extra tmpfs line just failed at every mount -a.
---
 board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/fstab          | 1 -
 .../raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S10usbdev | 2 +-
 2 files changed, 1 insertion(+), 2 deletions(-)

diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/fstab b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/fstab
index 6d6b49b6..90c251d1 100644
--- a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/fstab
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/fstab
@@ -10,5 +10,4 @@ tmpfs		/dev/shm	tmpfs	mode=0777				0	0
 tmpfs		/tmp		tmpfs	mode=1777				0	0
 tmpfs		/run		tmpfs	mode=0755,nosuid,nodev			0	0
 tmpfs		/var/log	tmpfs	mode=0755,size=4M			0	0
-tmpfs		/var/lock	tmpfs	mode=1777,size=512k			0	0
 tmpfs		/var/cache	tmpfs	mode=0755,size=512k			0	0
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S10usbdev b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S10usbdev
index 3b11ea04..a4d56a32 100755
--- a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S10usbdev
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S10usbdev
@@ -94,7 +94,7 @@ start() {
 		echo 1       > "$GADGET/os_desc/use"
 		echo 0xcd    > "$GADGET/os_desc/b_vendor_code"
 		echo MSFT100 > "$GADGET/os_desc/qw_sign"
-		ln -sfn configs/c.1 "$GADGET/os_desc/c.1"
+		ln -sfn "$GADGET/configs/c.1" "$GADGET/os_desc/c.1"
 		echo WINNCM  > "$GADGET/functions/ncm.usb0/os_desc/interface.ncm/compatible_id"
 	fi
 
