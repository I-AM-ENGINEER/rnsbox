From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Thu, 24 Sep 2026 23:17:47 +0300
Subject: [PATCH 09/16] slip: optional SLIP-over-UART link to an external HaLow
 (RNode) modem

Same SLIP data path as the LicheeRV build (stty sets the line speed,
util-linux ldattach pins N_SLIP, sl0 point-to-point to the modem), with
the board's UART reality flipped in its favour: the PL011 handles the
modem's native 2 Mbaud, so no 1.5 Mbaud compromise and no baud change on
the modem. The UART (GPIO14/15, /dev/ttyAMA0) is dedicated - Bluetooth is
disabled and no getty holds the port.
---
 .../rootfs-overlay/etc/init.d/S31slip         | 81 +++++++++++++++++++
 .../rootfs-overlay/etc/rnsbox/slip.conf       | 28 +++++++
 2 files changed, 109 insertions(+)
 create mode 100755 board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S31slip
 create mode 100644 board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/slip.conf

diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S31slip b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S31slip
new file mode 100755
index 00000000..0ff80e75
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S31slip
@@ -0,0 +1,81 @@
+#!/bin/sh
+# S31slip - optional SLIP-over-UART link to an external WiFi-HaLow (RNode)
+# modem. Reads /etc/rnsbox/slip.conf; when enabled, attaches the SLIP line
+# discipline to the configured UART (ldattach) and brings up a point-to-point
+# sl0 interface to the modem. rnsd then reaches the modem as a normal
+# Reticulum interface via a TCPClientInterface to peer_ip:4242 (added to
+# /etc/reticulum/config by the operator).
+#
+# OFF by default. Harmless no-op when disabled, when the UART device is
+# absent, or when the modem simply isn't wired (sl0 just never comes up).
+
+CONF=/etc/rnsbox/slip.conf
+LOG=/var/log/slip.log
+
+# read one key=value from the conf (single value, no shell sourcing)
+cfg() {
+	sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$CONF" 2>/dev/null \
+	  | tail -1 | tr -d '"' | tr -d "'" | awk '{print $1}'
+}
+
+start() {
+	[ -r "$CONF" ] || { echo "S31slip: no $CONF; skipping"; return 0; }
+	enabled=$(cfg enabled)
+	case "$enabled" in yes|true|1|on) ;; *) echo "S31slip: disabled"; return 0 ;; esac
+
+	device=$(cfg device);     [ -n "$device" ]   || device=/dev/ttyAMA0
+	baud=$(cfg baud);         [ -n "$baud" ]     || baud=2000000
+	local_ip=$(cfg local_ip); [ -n "$local_ip" ] || local_ip=192.168.7.1
+	peer_ip=$(cfg peer_ip);   [ -n "$peer_ip" ]  || peer_ip=192.168.7.2
+
+	if [ ! -e "$device" ]; then
+		echo "S31slip: $device not present; skipping"
+		return 1
+	fi
+
+	printf "Starting SLIP (%s @ %s baud) -> sl0: " "$device" "$baud"
+	# Set the line speed with busybox stty (it maps a decimal baud to the right
+	# Bxxxx constant). util-linux ldattach's own `-s <baud>` can NOT do this on
+	# a musl target - musl's cfsetspeed rejects a raw decimal and ldattach's
+	# BOTHER fallback is compiled out - so we set the speed here and attach
+	# without -s. ldattach's cfmakeraw preserves the speed bits.
+	if ! stty -F "$device" "$baud" raw -echo >>"$LOG" 2>&1; then
+		echo "FAIL (stty could not set $baud on $device; see $LOG)"
+		return 1
+	fi
+	# ldattach daemonizes and holds the tty open, keeping N_SLIP loaded so the
+	# kernel slip driver's sl0 netdev stays registered.
+	ldattach SLIP "$device" >>"$LOG" 2>&1
+
+	i=0
+	while [ $i -lt 20 ]; do
+		ip link show sl0 >/dev/null 2>&1 && break
+		i=$((i + 1)); sleep 0.2
+	done
+	if ! ip link show sl0 >/dev/null 2>&1; then
+		echo "FAIL (sl0 not created)"
+		killall ldattach 2>/dev/null
+		return 1
+	fi
+
+	# point-to-point: our end = local_ip, the modem = peer_ip. A host route to
+	# peer_ip goes out sl0; nothing else is affected (no default route change).
+	ip addr flush dev sl0 2>/dev/null
+	ip addr add "$local_ip" peer "$peer_ip" dev sl0 2>/dev/null
+	ip link set sl0 up 2>/dev/null
+	echo "OK ($local_ip -> $peer_ip)"
+}
+
+stop() {
+	killall ldattach 2>/dev/null
+	ip link set sl0 down 2>/dev/null
+	ip addr flush dev sl0 2>/dev/null
+	echo "S31slip: stopped"
+}
+
+case "${1:-start}" in
+	start)          start ;;
+	stop)           stop ;;
+	restart|reload) stop; sleep 1; start ;;
+	*) echo "Usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
+esac
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/slip.conf b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/slip.conf
new file mode 100644
index 00000000..d2f1b255
--- /dev/null
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/rnsbox/slip.conf
@@ -0,0 +1,28 @@
+# SLIP-over-UART link to an external WiFi-HaLow (RNode) modem.
+#
+# Optional, OFF by default. When enabled, S31slip attaches the SLIP line
+# discipline to the UART and brings up a point-to-point interface (sl0) to
+# the modem. rnsd then reaches the modem as a normal Reticulum interface by
+# adding, in /etc/reticulum/config:
+#
+#     [[HaLow]]
+#       type = TCPClientInterface
+#       target_host = 192.168.7.2      # = peer_ip below
+#       target_port = 4242
+#
+# Wiring (Pi Zero 2 W): the hardware UART (PL011) on GPIO14 (TX, physical
+# pin 8) / GPIO15 (RX, pin 10), 3.3 V, common ground — device =
+# /dev/ttyAMA0. Bluetooth is disabled and the kernel console kept off the
+# UART by this image, so the port is fully free for this link.
+#
+# baud MUST match the modem's SLIP baud. The modem's default 2000000 is
+# preconfigured here — the PL011 has plenty of headroom (up to 3 Mbaud),
+# so unlike the Nano-e there is no need to slow the modem down.
+# local_ip/peer_ip must match the modem's SLIP config (defaults
+# 192.168.7.2 device / 192.168.7.1 host).
+
+enabled=no
+device=/dev/ttyAMA0
+baud=2000000
+local_ip=192.168.7.1
+peer_ip=192.168.7.2
