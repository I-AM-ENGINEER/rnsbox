From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Sat, 26 Sep 2026 03:01:27 +0300
Subject: [PATCH 14/16] gadget: set NCM MAC pre-bind via configfs; correct
 fragment symbol names

Windows Code 43 (device descriptor failed) on first hardware boot: the
device-side MAC was rewritten after enumeration (S30gadget_nic ip link set
on a bound function) and the kernel fragment used USB_CONFIGFS_F_NCM /
_F_MASS_STORAGE, which do not exist in this kernel (USB_CONFIGFS_NCM /
_MASS_STORAGE do; bcm2711_defconfig had them anyway). Pin dev_addr from
/boot/usb.ncm.mac before the UDC bind and use the canonical os_desc
relative symlink.
---
 board/raspberrypi/rnsbox-0-2w/linux.fragment         |  4 ++--
 .../rnsbox-0-2w/rootfs-overlay/etc/init.d/S10usbdev  |  9 ++++++++-
 .../rootfs-overlay/etc/init.d/S30gadget_nic          | 12 +++---------
 3 files changed, 13 insertions(+), 12 deletions(-)

diff --git a/board/raspberrypi/rnsbox-0-2w/linux.fragment b/board/raspberrypi/rnsbox-0-2w/linux.fragment
index f074d7fa..67e21273 100644
--- a/board/raspberrypi/rnsbox-0-2w/linux.fragment
+++ b/board/raspberrypi/rnsbox-0-2w/linux.fragment
@@ -6,8 +6,8 @@ CONFIG_USB_DWC2=y
 CONFIG_USB_DWC2_DUAL_ROLE=y
 CONFIG_USB_GADGET=y
 CONFIG_USB_CONFIGFS=y
-CONFIG_USB_CONFIGFS_F_NCM=y
-CONFIG_USB_CONFIGFS_F_MASS_STORAGE=y
+CONFIG_USB_CONFIGFS_NCM=y
+CONFIG_USB_CONFIGFS_MASS_STORAGE=y
 CONFIG_USB_GADGET_VBUS_DRAW=500
 CONFIG_USB_GADGET_STORAGE_NUM_BUFFERS=4
 
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S10usbdev b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S10usbdev
index d3bed2c3..b56e2b3d 100755
--- a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S10usbdev
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S10usbdev
@@ -65,11 +65,18 @@ start() {
 		mkdir -p "$GADGET/functions/ncm.usb0"
 		ln -sfn "$GADGET/functions/ncm.usb0" "$GADGET/configs/c.1/ncm.usb0"
 
+		# Device-side MAC: set via configfs BEFORE the UDC bind so the
+		# function never changes identity after enumeration (rewriting the
+		# MAC of a live function upsets some hosts - Code 43).
+		if [ -s /boot/usb.ncm.mac ]; then
+			cat /boot/usb.ncm.mac > "$GADGET/functions/ncm.usb0/dev_addr" 2>/dev/null || 				echo "S10usbdev: could not set ncm dev_addr (pre-bound MAC will be random)" >>"$LOG"
+		fi
+
 		# MS-OS descriptor: auto-bind Windows' in-box usbncm.sys driver.
 		echo 1       > "$GADGET/os_desc/use"
 		echo 0xcd    > "$GADGET/os_desc/b_vendor_code"
 		echo MSFT100 > "$GADGET/os_desc/qw_sign"
-		ln -sfn "$GADGET/configs/c.1" "$GADGET/os_desc/c.1"
+		ln -sfn configs/c.1 "$GADGET/os_desc/c.1"
 		echo WINNCM  > "$GADGET/functions/ncm.usb0/os_desc/interface.ncm/compatible_id"
 	fi
 
diff --git a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S30gadget_nic b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S30gadget_nic
index 45d3d757..ceea5e54 100755
--- a/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S30gadget_nic
+++ b/board/raspberrypi/rnsbox-0-2w/rootfs-overlay/etc/init.d/S30gadget_nic
@@ -34,15 +34,9 @@ start() {
 		return 1
 	fi
 
-	# Pin the device-side MAC if /boot/usb.ncm.mac was shipped; else derive
-	# one from the board serial (stable per-device).
-	if [ -e /boot/usb.ncm.mac ]; then
-		new_mac=$(cat /boot/usb.ncm.mac)
-	else
-		ser=$(tr -d '\0' < /proc/device-tree/serial-number 2>/dev/null | tail -c 8 | tail -c 4)
-		new_mac=$(hex2mac "021d6b01${ser:-0000}")
-	fi
-	[ -n "$new_mac" ] && ip link set usb0 address "$new_mac" 2>/dev/null
+	# NOTE: the device-side MAC is pinned by S10usbdev via configfs
+	# (functions/ncm.usb0/dev_addr) BEFORE the gadget is bound - changing it
+	# here would rewrite the identity of an already-enumerated function.
 
 	ip link set usb0 up
 	ip addr add "$USB0_IPV4" dev usb0 2>/dev/null || true
