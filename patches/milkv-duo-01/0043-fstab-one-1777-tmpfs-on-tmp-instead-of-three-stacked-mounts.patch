From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Sat, 17 Oct 2026 03:31:39 +0300
Subject: [PATCH 5/5] fstab: one 1777 tmpfs on /tmp instead of three stacked
 /var/* mounts

The buildroot skeleton ships /var/log, /var/cache, /var/spool and
/var/tmp as symlinks to ../tmp, so the old separate /var/* tmpfs
entries never made separate mounts: mount(8) followed the symlinks
and stacked THREE anonymous tmpfs mounts onto /tmp. The last one
won - /tmp on the shipped image was 512k mode=0755: the admin
account could not write /tmp at all, and everything logged through
/var/log sat on that same tiny read-only-ish layer.

The /var/lock entry never applied at all: it resolves to
../run/lock, which inittab's si4 creates only AFTER mount -a ran.

Replace the four lines with one 8M mode=1777 nosuid,nodev mount on
/tmp; every /var symlink lands on it. 8M comfortably covers the
tmpfs-resident logs (messages, wanwatch, rnsd, ntp) plus real /tmp
use.
---
 buildroot/board/cvitek/SG200X/overlay/etc/fstab | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/fstab b/buildroot/board/cvitek/SG200X/overlay/etc/fstab
index c0f0c8e38..fa3fa0d14 100644
--- a/buildroot/board/cvitek/SG200X/overlay/etc/fstab
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/fstab
@@ -9,9 +9,17 @@ devpts		/dev/pts	devpts	defaults,gid=5,mode=620,ptmxmode=0666	0	0
 sysfs		/sys		sysfs	defaults				0	0
 
 # Memory-backed mounts — kill SD writes from the chatty paths.
+#
+# ONE tmpfs for /tmp only. The buildroot skeleton ships /var/log,
+# /var/cache, /var/spool, /var/tmp as symlinks to ../tmp, so the
+# previous separate /var/* tmpfs lines stacked THREE anonymous mounts
+# onto /tmp (mount(8) follows the symlink): the last one won and /tmp
+# became 512k mode=0755 — admin could not write /tmp at all, and
+# everything written through /var/log sat on that same tiny 0755
+# layer. /var/lock's line never applied either: it resolves to
+# ../run/lock, which does not exist until inittab's si4 (after
+# mount -a). All of /var/log, /var/cache, /var/spool, /var/tmp now
+# share this single 8M 1777 mount through their symlinks.
 tmpfs		/dev/shm	tmpfs	mode=0777				0	0
-tmpfs		/tmp		tmpfs	mode=1777				0	0
+tmpfs		/tmp		tmpfs	rw,nosuid,nodev,mode=1777,size=8M	0	0
 tmpfs		/run		tmpfs	mode=0755,nosuid,nodev			0	0
-tmpfs		/var/log	tmpfs	mode=0755,size=4M			0	0
-tmpfs		/var/lock	tmpfs	mode=1777,size=512k			0	0
-tmpfs		/var/cache	tmpfs	mode=0755,size=512k			0	0
