From 43fbad9ed1856c3d485129df0078171daf2ae183 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Fri, 16 Oct 2026 03:37:35 +0300
Subject: [PATCH] ssh: gated S50sshd instead of the stock always-on sshd

Mirror the rpi-universal SSH hardening on the Duo: the overlay replaces
the stock openssh S50sshd with the gate - sshd runs ONLY while
/etc/rnsbox/ssh.conf says enabled=yes (the portal Settings -> SSH card
rewrites the file and restarts the script); at boot it exits silently.
sshd_config closes root login; build.sh locks the root password at
build time and ships the admin users table, so login is the
unprivileged admin account (password set in the portal).
---
 .../cvitek/SG200X/overlay/etc/init.d/S50sshd  |  47 +++++++
 .../cvitek/SG200X/overlay/etc/rnsbox/ssh.conf |   5 +
 .../cvitek/SG200X/overlay/etc/ssh/sshd_config | 129 ++----------------
 3 files changed, 64 insertions(+), 117 deletions(-)
 create mode 100755 buildroot/board/cvitek/SG200X/overlay/etc/init.d/S50sshd
 create mode 100644 buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/ssh.conf

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S50sshd b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S50sshd
new file mode 100755
index 000000000..c2d7b4050
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S50sshd
@@ -0,0 +1,47 @@
+#!/bin/sh
+# RNSBox sshd gate — this overlay script REPLACES the stock OpenSSH S50sshd
+# (the rootfs overlay is copied over the target after packages install, so
+# package upgrades keep working without fighting us).
+#
+# SSH is OFF unless /etc/rnsbox/ssh.conf says enabled=yes. The portal
+# (Settings -> SSH) rewrites that file and calls this script with `restart`;
+# at boot rcS just calls `start`, which exits silently while disabled.
+#
+# Login is the unprivileged `admin` user (password set in the portal); root
+# login is closed: PermitRootLogin no in /etc/ssh/sshd_config and the root
+# password is locked at build time (BR2_TARGET_ENABLE_ROOT_LOGIN off).
+CONF=/etc/rnsbox/ssh.conf
+
+ssh_enabled() {
+	[ -f "$CONF" ] || return 1
+	sed -e 's/#.*$//' "$CONF" | grep -iE '^[[:space:]]*enabled[[:space:]]*=[[:space:]]*(yes|on|true|1)[[:space:]]*$' >/dev/null 2>&1
+}
+
+case "${1:-start}" in
+	start)
+		ssh_enabled || exit 0
+		[ -x /usr/bin/ssh-keygen ] || exit 0
+		umask 077
+		/usr/bin/ssh-keygen -A >/dev/null 2>&1
+		printf "Starting sshd: "
+		/usr/sbin/sshd
+		touch /var/lock/sshd
+		echo "OK"
+		;;
+	stop)
+		printf "Stopping sshd: "
+		killall sshd 2>/dev/null
+		rm -f /var/lock/sshd
+		echo "OK"
+		;;
+	restart|reload)
+		"$0" stop
+		"$0" start
+		;;
+	*)
+		echo "Usage: $0 {start|stop|restart}" >&2
+		exit 1
+		;;
+esac
+
+exit $?
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/ssh.conf b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/ssh.conf
new file mode 100644
index 000000000..46c2d628b
--- /dev/null
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/ssh.conf
@@ -0,0 +1,5 @@
+# SSH server (sshd) gate — read by /etc/init.d/S50sshd at boot and rewritten
+# by the rnsbox-portal (Settings -> SSH). SSH is OFF unless enabled=yes. The
+# WAN side additionally stays closed unless tcp 22 is opened under Network ->
+# Open ports (shipped closed).
+enabled=no
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/ssh/sshd_config b/buildroot/board/cvitek/SG200X/overlay/etc/ssh/sshd_config
index 4eec4859f..fdcadaa3f 100644
--- a/buildroot/board/cvitek/SG200X/overlay/etc/ssh/sshd_config
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/ssh/sshd_config
@@ -1,117 +1,12 @@
