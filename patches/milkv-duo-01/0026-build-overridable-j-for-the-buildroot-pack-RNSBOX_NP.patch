From 8f63b78185225a8df2991fb69fb2e70b21df88b4 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Wed, 14 Oct 2026 21:26:53 +0300
Subject: [PATCH] build: overridable -j for the buildroot pack (RNSBOX_NPROC)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

BR2_JLEVEL=0 means nproc-wide inside every package — the host-rust LLVM
pass at that width resets a RAM-capped build host (observed for real).
Cap both parallelism layers from RNSBOX_NPROC: buildroot's per-package
-j via BR2_JLEVEL in the defconfig, and the BSP makefiles' package-level
-j via a make command-line NPROC (only that beats their := assignment).
---
 build-rnsbox.sh | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/build-rnsbox.sh b/build-rnsbox.sh
index 22cf8d34c..0aa0aea63 100755
--- a/build-rnsbox.sh
+++ b/build-rnsbox.sh
@@ -33,6 +33,17 @@ GENIMG=build/tools/common/sd_tools/genimage_rootless.cfg
 ISO_OVERLAY=buildroot/board/cvitek/SG200X/overlay/opt/rnsbox-clients/usbdisk.iso
 ISO_STASH=/tmp/rnsbox-usbdisk.iso.stash
 
+# RAM-capped build hosts (this one: WSL with a 24G cap) OOM when the stock
+# nproc-wide parallelism reaches the host-rust LLVM pass. RNSBOX_NPROC (set
+# by build.sh) caps both layers: buildroot's per-package -j (BR2_JLEVEL)
+# and the BSP makefiles' package-level -j (NPROC := $(shell nproc); only a
+# make command-line definition beats a := assignment, hence MAKEFLAGS).
+if [ -n "${RNSBOX_NPROC:-}" ]; then
+	sed -i "s/^BR2_JLEVEL=.*/BR2_JLEVEL=${RNSBOX_NPROC}/" "$DEFCONFIG"
+	MAKEFLAGS="NPROC=${RNSBOX_NPROC} ${MAKEFLAGS:-}"
+	export MAKEFLAGS
+fi
+
 restore() {
 	# put the tree back to the committed DVD-shaped state
 	sed -i 's/^BR2_TARGET_ROOTFS_EXT2_SIZE=.*/BR2_TARGET_ROOTFS_EXT2_SIZE="2800M"/' "$DEFCONFIG"
