From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Sat, 17 Oct 2026 03:31:39 +0300
Subject: [PATCH 4/5] rnsd: unbuffered logging + early-death evidence recorder
 in S82rnsd

Two diagnostics for the "rnsd dies silently seconds after boot"
class of failures:

- launch rnsd with PYTHONUNBUFFERED=1 (the env spelling of
  `python -u`, shebang-agnostic). rnsd logs to stdout through
  `>>"$LOG" 2>&1`; python block-buffers stdout when it is not a tty,
  and RNS's fatal exits skip flushing - every normal log line was
  lost, an empty /var/log/rnsd.log could mean anything. With the
  flag the next boot prints the actual death reason into the log.

- early_death_watchdog PID: a root-side 60 s watcher after every
  start. If the pid is gone before the minute is up - and it was not
  a deliberate stop nor a portal restart (a NEWER pid running) - it
  snapshots the evidence into /var/log/rnsd-death: timestamp,
  uptime, the tail of rnsd.log and a 40-line dmesg tail (root CAN
  read dmesg; the admin SSH account cannot - that blindness is half
  of why this stayed a mystery). Overwritten each time: a crash-loop
  repeats identically and /var/log is tmpfs.
---
 .../cvitek/SG200X/overlay/etc/init.d/S82rnsd  | 37 ++++++++++++++++++-
 1 file changed, 36 insertions(+), 1 deletion(-)

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd
index 523734ff7..55414514a 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S82rnsd
@@ -22,10 +22,40 @@ NAME=rnsd
 DAEMON=/usr/bin/rnsd
 PIDFILE=/var/run/$NAME.pid
 LOG=/var/log/$NAME.log
+DEATHLOG=/var/log/rnsd-death
 CFG_DIR=/etc/reticulum
 
 [ -x "$DAEMON" ] || exit 0
 
+# early_death_watchdog PID - the rnsd mystery-black-box recorder.
+#
+# When rnsd died silently seconds after start (no traceback anywhere:
+# os._exit skips flushing, and admin cannot read dmesg), there was no
+# way to tell WHY. This runs as root for 60 s after every start; if
+# the watched pid is gone by then - and it was not a deliberate stop
+# nor a portal restart (a NEWER pid running) - snapshot the evidence
+# into $DEATHLOG (overwritten every time: a crash-loop repeats
+# identically, only the latest snapshot matters; /var/log is tmpfs).
+early_death_watchdog() {
+	(
+		sleep 60
+		kill -0 "$1" 2>/dev/null && exit 0
+		[ -f /run/rnsd.stopped ] && exit 0
+		if [ -f "$PIDFILE" ] && [ "$(cat "$PIDFILE" 2>/dev/null)" != "$1" ] \
+			&& kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
+			exit 0
+		fi
+		{
+			echo "== $(date '+%Y-%m-%d %H:%M:%S') rnsd pid $1 died <60s after start (uptime $(cut -d. -f1 /proc/uptime)s)"
+			echo "--- /var/log/rnsd.log (tail):"
+			tail -c 4096 "$LOG" 2>/dev/null
+			echo "--- dmesg (tail):"
+			dmesg 2>/dev/null | tail -n 40
+			echo
+		} >"$DEATHLOG" 2>&1
+	) &
+}
+
 start() {
 	mkdir -p /var/log /var/run "$CFG_DIR"
 
@@ -45,7 +75,11 @@ start() {
 	# --config points at our config dir; rnsd auto-creates files inside.
 	# -s detaches to its own process group; we still pidfile-track so
 	# the watchdog (S46wanwatch) can detect it cleanly.
-	"$DAEMON" --config "$CFG_DIR" >>"$LOG" 2>&1 &
+	# PYTHONUNBUFFERED=1 is `python -u` by env (same effect, shebang-
+	# agnostic): rnsd's stdout log lines reach $LOG as they are
+	# printed. Block-buffered stdout used to swallow every message on
+	# an os._exit-style death - empty rnsd.log used to mean "no clue".
+	PYTHONUNBUFFERED=1 "$DAEMON" --config "$CFG_DIR" >>"$LOG" 2>&1 &
 	PID=$!
 	echo "$PID" > "$PIDFILE"
 	sleep 0.3
@@ -57,6 +91,7 @@ start() {
 		# a portal-initiated restart left the flag behind entirely).
 		rm -f /run/rnsd-down-since
 		echo "OK (pid $PID)"
+		early_death_watchdog "$PID"
 	else
 		echo "FAIL (see $LOG)"
 		rm -f "$PIDFILE"
