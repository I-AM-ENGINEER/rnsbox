From 111cfd83816a3de59463a200543042453ee594c9 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Sat, 17 Oct 2026 00:00:00 +0300
Subject: [PATCH] router: defer the first dnsmasq start to S80dnsmasq

S60routing's apply() restarted dnsmasq unconditionally. At boot that is
the FIRST start (rcS has not reached S80dnsmasq yet), so S80's own start
then fails with "already running FAIL" on every boot. Restart only
while it is already running; the boot-time start belongs to S80dnsmasq,
which runs right after with the regenerated per-LAN scope.
---
 .../cvitek/SG200X/overlay/etc/init.d/S60routing  | 16 ++++++++++++----
 1 file changed, 12 insertions(+), 4 deletions(-)

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S60routing b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S60routing
index 27abcfe..654c81b 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S60routing
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S60routing
@@ -147,10 +147,18 @@ start() {
 		nft -f "$NFT_FILE"
 	fi
 
-	if [ -x /etc/init.d/S80dnsmasq ]; then
-		/etc/init.d/S80dnsmasq restart >/dev/null 2>&1 || true
-	elif pidof dnsmasq >/dev/null 2>&1; then
-		killall -HUP dnsmasq 2>/dev/null || true
+	# Restart dnsmasq ONLY while it is already running. At boot S60routing
+	# runs BEFORE rcS reaches S80dnsmasq: a restart here silently STARTS
+	# dnsmasq early, and S80's own start then fails noisily with
+	# "Starting dnsmasq: /usr/sbin/dnsmasq is already running FAIL" — the
+	# double start in every boot log. When it is not running yet, S80dnsmasq
+	# starts it moments later with the regenerated scope below.
+	if pidof dnsmasq >/dev/null 2>&1; then
+		if [ -x /etc/init.d/S80dnsmasq ]; then
+			/etc/init.d/S80dnsmasq restart >/dev/null 2>&1 || true
+		else
+			killall -HUP dnsmasq 2>/dev/null || true
+		fi
 	fi
 }
 
