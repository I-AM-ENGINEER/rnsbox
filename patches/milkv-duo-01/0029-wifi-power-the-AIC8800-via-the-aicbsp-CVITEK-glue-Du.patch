From 806275bbaa6ba52cc26577a5b58dfaaf78a02f4b Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Thu, 15 Oct 2026 20:38:36 +0300
Subject: [PATCH] wifi: power the AIC8800 via the aicbsp CVITEK glue (Duo
 Module 01-W)

Port the CONFIG_PLATFORM_CVITEK power path from the milkv-duo SDK
(duo-sdk-v2 linux_5.10 drivers/net/wireless/aicsemi): aicbsp_platform_power_on()
now asks the wifi_pin driver for the WL_REG_ON gpio (dts wifi_pin node,
porta 15), drives it high and triggers cvi_sdio_rescan() so the unpowered
AIC8800 enumerates on the wifi-sd host. Previously the glue was compiled
out entirely: the bsp registered a dummy SDIO notifier and timed out after
2 s ("fail to set AIC_WIFI power state to 1"), no SDIO device, no wlan0.

- aicsdio.c: gpio.h include + CVITEK power-on/rescan/power-off blocks
- aic8800_bsp/Makefile: -DCONFIG_PLATFORM_CVITEK from the exported flag
- board kernel defconfig: CONFIG_CVI_WIFI_PIN=y (cvi_get_wifi_pwr_on_gpio)
---
 .../linux/sg2000_duomodule01_sd_defconfig     |  7 ++
 .../wireless/aic8800/aic8800_bsp/Makefile     |  9 +++
 .../wireless/aic8800/aic8800_bsp/aicsdio.c    | 64 +++++++++++++++++++
 3 files changed, 80 insertions(+)

diff --git a/build/boards/sg200x/sg2000_duomodule01_sd/linux/sg2000_duomodule01_sd_defconfig b/build/boards/sg200x/sg2000_duomodule01_sd/linux/sg2000_duomodule01_sd_defconfig
index b5ffab00b..36ec723a1 100644
--- a/build/boards/sg200x/sg2000_duomodule01_sd/linux/sg2000_duomodule01_sd_defconfig
+++ b/build/boards/sg200x/sg2000_duomodule01_sd/linux/sg2000_duomodule01_sd_defconfig
@@ -51,6 +51,13 @@ CONFIG_INET=y
 # No mac80211 (firmware does the MAC).
 CONFIG_CFG80211=y
 CONFIG_RFKILL=y
+# RNSBox W variant: the aic8800_bsp CVITEK power glue asks the wifi_pin
+# driver for the WL_REG_ON gpio number from the dts wifi_pin node
+# (poweron-gpio = porta 15) and then triggers cvi_sdio_rescan(). Without
+# this the chip is never powered and aicbsp times out ("fail to set
+# AIC_WIFI power state to 1"). Same setting as the milkv-duo SDK Duo/DuoS
+# defconfigs. (CVI_BT_PIN stays off — no BT use case.)
+CONFIG_CVI_WIFI_PIN=y
 CONFIG_UEVENT_HELPER=y
 CONFIG_DEVTMPFS=y
 CONFIG_DEVTMPFS_MOUNT=y
diff --git a/osdrv/extdrv/wireless/aic8800/aic8800_bsp/Makefile b/osdrv/extdrv/wireless/aic8800/aic8800_bsp/Makefile
index 4df195d2c..74ebffdd8 100755
--- a/osdrv/extdrv/wireless/aic8800/aic8800_bsp/Makefile
+++ b/osdrv/extdrv/wireless/aic8800/aic8800_bsp/Makefile
@@ -137,6 +137,15 @@ MODDESTDIR ?= /lib/modules/$(KVER)/kernel/drivers/net/wireless/
 ARCH ?= x86_64
 CROSS_COMPILE ?=
 endif
+
+# RNSBox Duo Module 01-W: the top-level aic8800 Makefile exports
+# CONFIG_PLATFORM_CVITEK=y; turn it into the -DCONFIG_PLATFORM_CVITEK macro
+# so the WL_REG_ON + cvi_sdio_rescan() power glue in aicsdio.c is compiled
+# in (mirrors the milkv-duo SDK aicsemi bsp Makefile).
+CONFIG_PLATFORM_CVITEK ?= y
+ifeq ($(CONFIG_PLATFORM_CVITEK), y)
+ccflags-$(CONFIG_PLATFORM_CVITEK) += -DCONFIG_PLATFORM_CVITEK
+endif
 ###########################################
 
 all: modules
diff --git a/osdrv/extdrv/wireless/aic8800/aic8800_bsp/aicsdio.c b/osdrv/extdrv/wireless/aic8800/aic8800_bsp/aicsdio.c
index 30cd547f2..b22f8ef19 100755
--- a/osdrv/extdrv/wireless/aic8800/aic8800_bsp/aicsdio.c
+++ b/osdrv/extdrv/wireless/aic8800/aic8800_bsp/aicsdio.c
@@ -15,6 +15,7 @@
 #include <linux/semaphore.h>
 #include <linux/debugfs.h>
 #include <linux/kthread.h>
+#include <linux/gpio.h>
 #include "aicsdio_txrxif.h"
 #include "aicsdio.h"
 #include "aic_bsp_driver.h"
@@ -42,6 +43,17 @@ extern void extern_wifi_set_enable(int is_on);
 extern void set_power_control_lock(int lock);
 #endif//for AML
 
+// RNSBox Duo Module 01-W: ported from the milkv-duo SDK aicsemi driver —
+// without this glue aicbsp_platform_power_on() never asserts WL_REG_ON
+// (wifi_pin poweron-gpio, porta 15) and never rescans the wifi-sd host, so
+// the chip-up semaphore times out after 2 s ("fail to set AIC_WIFI power
+// state to 1") and no SDIO device ever appears.
+#ifdef CONFIG_PLATFORM_CVITEK
+extern int cvi_get_wifi_pwr_on_gpio(void);
+extern int cvi_sdio_rescan(void);
+static int cvi_wifi_power_gpio = -1;
+#endif //CONFIG_PLATFORM_CVITEK
+
 
 static int aicbsp_platform_power_on(void);
 static void aicbsp_platform_power_off(void);
@@ -514,6 +526,30 @@ static int aicbsp_platform_power_on(void)
             rockchip_wifi_set_carddetect(1);
 #endif /*CONFIG_PLATFORM_ROCKCHIP2*/
 
+#ifdef CONFIG_PLATFORM_CVITEK
+	// Duo Module 01-W: assert WL_REG_ON (wifi_pin poweron-gpio) before the
+	// bus scan; the AIC8800 comes up unpowered on this module.
+	printk("======== CVITEK WLAN_POWER_ON ========\n");
+	cvi_wifi_power_gpio = cvi_get_wifi_pwr_on_gpio();
+	if (cvi_wifi_power_gpio >= 0) {
+		ret = gpio_request(cvi_wifi_power_gpio, "WLAN_POWER");
+		if (ret < 0) {
+			printk("%s: gpio_request(%d) for WLAN_POWER failed\n",
+				__func__, cvi_wifi_power_gpio);
+			cvi_wifi_power_gpio = -1;
+		}
+	}
+
+	if (cvi_wifi_power_gpio >= 0) {
+		ret = gpio_direction_output(cvi_wifi_power_gpio, 1);
+		if (ret) {
+			printk("%s: WLAN_POWER output high failed!\n", __func__);
+			return -EIO;
+		}
+		mdelay(50);
+	}
+#endif //CONFIG_PLATFORM_CVITEK
+
 	sema_init(&aic_chipup_sem, 0);
 	ret = aicbsp_reg_sdio_notify(&aic_chipup_sem);
 	if (ret) {
@@ -529,6 +565,14 @@ static int aicbsp_platform_power_on(void)
 	sunxi_mmc_rescan_card(aicbsp_bus_index);
 #endif //CONFIG_PLATFORM_ALLWINNER
 
+#ifdef CONFIG_PLATFORM_CVITEK
+	// The wifi-sd host has no card-detect pin; only an explicit
+	// mmc_detect_change() makes it (re)enumerate the now-powered chip.
+	printk("%s,%d: cvi_sdio_rescan\n", __func__, __LINE__);
+	cvi_sdio_rescan();
+	//udelay(1000);
+#endif
+
 	if (down_timeout(&aic_chipup_sem, msecs_to_jiffies(2000)) == 0) {
 		aicbsp_unreg_sdio_notify();
 		if(aicbsp_load_fw_in_fdrv){
@@ -552,6 +596,17 @@ static int aicbsp_platform_power_on(void)
 	rockchip_wifi_power(0);
 #endif /*CONFIG_PLATFORM_ROCKCHIP2*/
 
+#ifdef CONFIG_PLATFORM_CVITEK
+	// Chip never enumerated: drop WL_REG_ON again so a later retry
+	// starts from a clean power cycle.
+	if (cvi_wifi_power_gpio >= 0) {
+		ret = gpio_direction_output(cvi_wifi_power_gpio, 0);
+		if (ret) {
+			printk("%s: WLAN_POWER output low failed!\n", __func__);
+		}
+	}
+#endif //CONFIG_PLATFORM_CVITEK
+
 	return -1;
 }
 
@@ -580,6 +635,15 @@ static void aicbsp_platform_power_off(void)
 	extern_wifi_set_enable(0);
 #endif
 
+#ifdef CONFIG_PLATFORM_CVITEK
+	printk("======== CVITEK WLAN_POWER_OFF ========\n");
+	if (cvi_wifi_power_gpio >= 0) {
+		if(gpio_direction_output(cvi_wifi_power_gpio, 0)) {
+			printk("%s: WLAN_POWER output low failed!\n", __func__);
+		}
+	}
+	gpio_free(cvi_wifi_power_gpio);
+#endif //CONFIG_PLATFORM_CVITEK
 
 	sdio_dbg("%s\n", __func__);
 }
-- 
2.43.0

