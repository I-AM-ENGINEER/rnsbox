From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Taixin Reverse <reverse@taixin.local>
Date: Sat, 17 Oct 2026 16:21:43 +0300
Subject: [PATCH 1/5] headless: silence the vendor S00kmod/S07kmod2 insmod
 noise

Port of licheerv-nano 0033: the sg2000-rv64 series never got the
no-op rewrite, so every boot printed 20+ 'can't insert soph_*.ko:
No such file or directory' lines for the media module set the
headless strip deliberately does not ship.
---
 .../cvitek/SG200X/overlay/etc/init.d/S00kmod  | 34 +++----------------
 .../cvitek/SG200X/overlay/etc/init.d/S07kmod2 | 16 ++-------
 2 files changed, 8 insertions(+), 42 deletions(-)

diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S00kmod b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S00kmod
index 4c5ff6840..6b50a7ffc 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S00kmod
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S00kmod
@@ -1,30 +1,6 @@
 #!/bin/sh
-
-if [ "$1" = "start" ]
-then
-	. /etc/profile
-	printf "load kernel module: "
-	cd /mnt/system/ko/
-	insmod soph_sys.ko
-	insmod soph_base.ko
-	insmod soph_rtos_cmdqu.ko # optional for RTOS core
-	insmod soph_fast_image.ko # optional for RTOS core
-	insmod soph_mipi_rx.ko
-	insmod soph_snsr_i2c.ko
-	insmod soph_vi.ko
-	insmod soph_vpss.ko
-	insmod soph_dwa.ko
-	insmod soph_vo.ko
-#	insmod soph_mipi_tx.ko
-	insmod soph_rgn.ko
-	insmod soph_tpu.ko
-	insmod soph_vcodec.ko
-	insmod soph_jpeg.ko
-	insmod soph_vc_driver.ko MaxVencChnNum=9 MaxVdecChnNum=9
-	insmod soph_ive.ko
-	insmod soph_pwm.ko
-	insmod soph_saradc.ko
-#	insmod soph_wiegand.ko # uncomment it if want use wiegand
-	echo "OK"
-	exit 0
-fi
+# RNSBox headless: the vendor media/ISP ko set is intentionally not
+# shipped (the strip patch); USB-eth and platform ko load from
+# /mnt/system/auto.sh. Load nothing, keep the boot log clean.
+echo "OK"
+exit 0
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S07kmod2 b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S07kmod2
index 016101dce..8eae5b5bb 100755
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S07kmod2
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S07kmod2
@@ -1,14 +1,4 @@
 #!/bin/sh
-
-if [ "$1" = "start" ]
-then
-	. /etc/profile
-	printf "load kernel module: "
-	cd /mnt/system/ko/
-	insmod soph_wdt.ko
-	insmod soph_clock_cooling.ko
-	insmod soph_rtc.ko
-	insmod soph_mon.ko
-	echo "OK"
-	exit 0
-fi
+# RNSBox headless: see S00kmod - nothing to load here either.
+echo "OK"
+exit 0
-- 
