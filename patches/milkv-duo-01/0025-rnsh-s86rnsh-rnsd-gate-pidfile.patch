From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rnsh-agent <rnsh-agent@local>
Subject: [PATCH 0025] rnsh: S86rnsh rnsd gate must not rely on `pidof rnsd`

rnsd is a python console script; its comm is "python3", so `pidof rnsd`
never matches and S86rnsh refused to start even with a healthy rnsd
(the deleted Flask portal code in 0024 documented exactly this and used
a /proc cmdline scan instead). Check the S82rnsd pidfile first, keep
pidof as a fallback.
---
--- a/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S86rnsh
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/init.d/S86rnsh
@@ -157,7 +157,14 @@
 		return 1
 	fi
 
-	if [ -z "$(pidof rnsd)" ]; then
+	# rnsd is a python console script: its comm is "python3", so a plain
+	# `pidof rnsd` never matches (the pre-C++ Flask portal carried a
+	# /proc-cmdline scan for the same reason). Trust the S82rnsd pidfile,
+	# fall back to pidof.
+	rnsd_alive() {
+		[ -s /var/run/rnsd.pid ] && kill -0 "$(cat /var/run/rnsd.pid 2>/dev/null)" 2>/dev/null
+	}
+	if ! rnsd_alive && ! pidof rnsd >/dev/null 2>&1; then
 		echo "S86rnsh: refusing to start - rnsd (S82rnsd) is not running"
 		return 1
 	fi
