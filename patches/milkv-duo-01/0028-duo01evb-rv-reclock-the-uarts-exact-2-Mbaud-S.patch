From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Thu, 15 Oct 2026 19:11:18 +0300
Subject: [PATCH 2/2] duo01evb-rv: reclock the uarts - exact 2 Mbaud SLIP on
 uart1

---
 .../dts_riscv/sg2000_duomodule01_sd.dts       | 21 +++++++++++++++++++
 .../partition/partition_sd.xml                |  2 +-
 .../u-boot/cvi_board_init.c                   |  6 ++++++
 .../SG200X/overlay/etc/rnsbox/slip.conf       |  9 ++++----
 4 files changed, 32 insertions(+), 6 deletions(-)

diff --git a/build/boards/sg200x/sg2000_duomodule01_sd/dts_riscv/sg2000_duomodule01_sd.dts b/build/boards/sg200x/sg2000_duomodule01_sd/dts_riscv/sg2000_duomodule01_sd.dts
index a057e410e..5eb627f29 100644
--- a/build/boards/sg200x/sg2000_duomodule01_sd/dts_riscv/sg2000_duomodule01_sd.dts
+++ b/build/boards/sg200x/sg2000_duomodule01_sd/dts_riscv/sg2000_duomodule01_sd.dts
@@ -22,6 +22,27 @@
 	/delete-property/ clock-frequency;
 };
 
+// RNSBox: reclock disppll 1188 -> 768 MHz and clk_cam0_200 osc/1 ->
+// disppll/8 = 96 MHz (of_clk_init, before any driver probes). Every
+// dw-uart is a gate-only child of clk_cam0_200, so the 8250 input
+// becomes 96 MHz: 2 Mbaud is exact (96M/16/3), 1 Mbaud too (quot 6).
+// The 8250 driver takes the rate from the CCF — the stale 25 MHz
+// clock-frequency property is deleted in the uart0 fix above; without
+// the reclock the SLIP ceiling stays at 1,562,500 (25M/16).
+&clk {
+	assigned-clocks = <&clk CV181X_CLK_DISPPLL>, <&clk CV181X_CLK_CAM0_200>;
+	assigned-clock-parents = <0>, <&clk CV181X_CLK_DISPPLL>;
+	assigned-clock-rates = <768000000>, <96000000>;
+};
+
+// SLIP to the HaLow modem (S31slip, /dev/ttyS1). Pads XGPIOA[28]/[29]
+// are muxed to UART1 TX/RX by u-boot (cvi_board_init.c, fmux func=1).
+&uart1 {
+	status = "okay";
+	clocks = <&clk CV181X_CLK_UART1>;
+	/delete-property/ clock-frequency;
+};
+
 &sd {
 	min-frequency = <400000>; // 400Khz
 	max-frequency = <25000000>; // 25Mhz
diff --git a/build/boards/sg200x/sg2000_duomodule01_sd/partition/partition_sd.xml b/build/boards/sg200x/sg2000_duomodule01_sd/partition/partition_sd.xml
index a75f252b4..a537ddd0e 100644
--- a/build/boards/sg200x/sg2000_duomodule01_sd/partition/partition_sd.xml
+++ b/build/boards/sg200x/sg2000_duomodule01_sd/partition/partition_sd.xml
@@ -1,4 +1,4 @@
 <physical_partition type="sd">
     <partition label="BOOT" size_in_kb="80960" readonly="false" file="boot.sd"/>
-    <partition label="ROOTFS" size_in_kb="1638400" readonly="false" file="rootfs.sd" />
+    <partition label="ROOTFS" size_in_kb="3072000" readonly="false" file="rootfs.sd" />
 </physical_partition>
diff --git a/build/boards/sg200x/sg2000_duomodule01_sd/u-boot/cvi_board_init.c b/build/boards/sg200x/sg2000_duomodule01_sd/u-boot/cvi_board_init.c
index 65cda5c75..93c39f4b2 100644
--- a/build/boards/sg200x/sg2000_duomodule01_sd/u-boot/cvi_board_init.c
+++ b/build/boards/sg200x/sg2000_duomodule01_sd/u-boot/cvi_board_init.c
@@ -10,4 +10,10 @@ int cvi_board_init(void)
 	PINMUX_CONFIG(PWR_BUTTON1, EPHY_SPD_LED);
 
 	return 0;
+
+	// UART1 (SLIP to the HaLow modem): XGPIOA[28] TX / XGPIOA[29] RX,
+	// fmux func=1 — the same encoding the Sipeed SG2002 boards use for
+	// these pads.
+	mmio_write_32(0x03001070, 0x1); // GPIOA 28 UART1 TX
+	mmio_write_32(0x03001074, 0x1); // GPIOA 29 UART1 RX
 }
diff --git a/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/slip.conf b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/slip.conf
index 207320d47..b4d13940a 100644
--- a/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/slip.conf
+++ b/buildroot/board/cvitek/SG200X/overlay/etc/rnsbox/slip.conf
@@ -13,14 +13,13 @@
 # Wiring (LicheeRV Nano-e): UART1 on GPIOA28 (TX) / GPIOA29 (RX), 3.3 V,
 # common ground — device = /dev/ttyS1. Do NOT use ttyS0 (console).
 #
-# baud MUST match the modem's SLIP baud. The Nano's UART tops out at
-# 1,562,500 (25 MHz/16); the modem defaults to 2,000,000 which the Nano
-# cannot reach, so set the modem to 1500000 (via its web UI) and match it
-# here. local_ip/peer_ip must match the modem's SLIP config (defaults
+# baud MUST match the modem's SLIP baud. The board dts reclocks
+# clk_cam0_200 to 96 MHz, making 2,000,000 exact (96M/16/3) - the modem
+# default works as-is. local_ip/peer_ip must match the modem's SLIP config (defaults
 # 192.168.7.2 device / 192.168.7.1 host).
 
 enabled=no
 device=/dev/ttyS1
-baud=1500000
+baud=2000000
 local_ip=192.168.7.1
 peer_ip=192.168.7.2
-- 
