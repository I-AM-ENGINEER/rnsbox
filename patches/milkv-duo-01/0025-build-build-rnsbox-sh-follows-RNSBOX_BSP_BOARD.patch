From b9bf6966727fe08cdc4504542b8b6705c61844d0 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Wed, 14 Oct 2026 01:11:38 +0300
Subject: [PATCH] build: build-rnsbox.sh follows RNSBOX_BSP_BOARD (duo module
 01)

The pack script hardcodes the sg2002_licheervnano_sd board dir in three
places (partition xml, defconfig, install/images dir). Take the board
from RNSBOX_BSP_BOARD with the lichee board as the default, so
./build.sh milkv-duo-01-rv packs the sg2000_duomodule01_sd image.
---
 build-rnsbox.sh | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/build-rnsbox.sh b/build-rnsbox.sh
index bd7a4f80b..22cf8d34c 100755
--- a/build-rnsbox.sh
+++ b/build-rnsbox.sh
@@ -22,8 +22,13 @@ case "$VARIANT" in dvd|lite) ;; *) echo "usage: $0 {dvd|lite}"; exit 1 ;; esac
 LOG=/tmp/rnsbox-build.log; : > "$LOG"; exec > >(tee -a "$LOG") 2>&1
 echo "=================== RNSBox build [$VARIANT] $(date) ==================="
 
+# Which BSP board dir to build. build.sh exports RNSBOX_BSP_BOARD for the
+# board it is building (milkv-duo-01-rv -> sg2000_duomodule01_sd); the
+# lichee default keeps this script working standalone in a lichee tree.
+BSP_BOARD="${RNSBOX_BSP_BOARD:-sg2002_licheervnano_sd}"
+
 DEFCONFIG=buildroot/configs/cvitek_SG200X_musl_riscv64_defconfig
-PARTXML=build/boards/sg200x/sg2002_licheervnano_sd/partition/partition_sd.xml
+PARTXML=build/boards/sg200x/$BSP_BOARD/partition/partition_sd.xml
 GENIMG=build/tools/common/sd_tools/genimage_rootless.cfg
 ISO_OVERLAY=buildroot/board/cvitek/SG200X/overlay/opt/rnsbox-clients/usbdisk.iso
 ISO_STASH=/tmp/rnsbox-usbdisk.iso.stash
@@ -77,7 +82,7 @@ chmod 0755 buildroot/board/cvitek/SG200X/overlay/etc/init.d/S* 2>/dev/null
 
 echo "--- source cvisetup + defconfig ---"
 source build/cvisetup.sh || { echo "FATAL: cvisetup"; exit 93; }
-defconfig sg2002_licheervnano_sd || { echo "FATAL: defconfig"; exit 94; }
+defconfig "$BSP_BOARD" || { echo "FATAL: defconfig"; exit 94; }
 BRD="${BR_DIR:-$ROOT/buildroot}"
 rm -rf "$BRD"/output/build/rnsbox-portal-0.1.0
 export PATH=/usr/sbin:/sbin:$PATH
@@ -88,7 +93,7 @@ echo "--- pack_burn_image ---"
 pack_burn_image || { echo "FATAL: pack_burn_image"; exit 96; }
 
 # tag the produced image with the variant suffix (none for lite)
-NEW=$(ls -t install/soc_sg2002_licheervnano_sd/images/*.img | head -1)
+NEW=$(ls -t install/soc_${BSP_BOARD}/images/*.img | head -1)
 TAGGED="${NEW%.img}${SUFFIX}.img"
 [ "$NEW" = "$TAGGED" ] || cp -f "$NEW" "$TAGGED"
 echo "=================== BUILD OK [$VARIANT] $(date) ==================="
-- 
