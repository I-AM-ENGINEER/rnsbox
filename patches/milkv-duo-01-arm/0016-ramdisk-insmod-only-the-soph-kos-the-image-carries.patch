From 346a7ffe384990df937301a21b18bf163df63050 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Sat, 17 Oct 2026 00:30:00 +0300
Subject: [PATCH] ramdisk: insmod only the soph kos the image actually carries
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The headless rootfs ships only the kos something loads; the vendor
loadsystemko.sh still insmod'd the full multimedia list unconditionally,
so every boot logged one "insmod: can't insert 'soph_*.ko': No such
file" per absent module. Existence-check each module line instead —
same order, same parameters, silent for anything not shipped.
---
 .../overlay/64bit/system/ko/loadsystemko.sh   | 45 ++++++++++---------
 1 file changed, 23 insertions(+), 22 deletions(-)

diff --git a/ramdisk/rootfs/overlay/64bit/system/ko/loadsystemko.sh b/ramdisk/rootfs/overlay/64bit/system/ko/loadsystemko.sh
index b70f623..1555a3f 100644
--- a/ramdisk/rootfs/overlay/64bit/system/ko/loadsystemko.sh
+++ b/ramdisk/rootfs/overlay/64bit/system/ko/loadsystemko.sh
@@ -3,28 +3,29 @@ ${CVI_SHOPTS}
 #
 # Start to insert kernel modules
 #
-insmod /mnt/system/ko/soph_sys.ko
-insmod /mnt/system/ko/soph_base.ko
-insmod /mnt/system/ko/soph_rtos_cmdqu.ko
-insmod /mnt/system/ko/soph_fast_image.ko
-insmod /mnt/system/ko/soph_mipi_rx.ko
-insmod /mnt/system/ko/soph_snsr_i2c.ko
-insmod /mnt/system/ko/soph_vi.ko
-insmod /mnt/system/ko/soph_vpss.ko
-insmod /mnt/system/ko/soph_dwa.ko
-insmod /mnt/system/ko/soph_vo.ko
-insmod /mnt/system/ko/soph_mipi_tx.ko
-insmod /mnt/system/ko/soph_rgn.ko
-
-#insmod /mnt/system/ko/soph_wdt.ko
-insmod /mnt/system/ko/soph_clock_cooling.ko
-
-insmod /mnt/system/ko/soph_tpu.ko
-insmod /mnt/system/ko/soph_vcodec.ko
-insmod /mnt/system/ko/soph_jpeg.ko
-insmod /mnt/system/ko/soph_vc_driver.ko MaxVencChnNum=9 MaxVdecChnNum=9
-#insmod /mnt/system/ko/soph_rtc.ko
-insmod /mnt/system/ko/soph_ive.ko
+# RNSBox: the headless image does not carry the multimedia/vendor ko
+# subset (the slimmer and the ko stash only keep what something loads),
+# so insmod every soph_* module ONLY when its file is on the image —
+# the unconditional insmods spammed one "can't insert ... No such
+# file" line per missing module into every boot log.
+[ -f /mnt/system/ko/soph_sys.ko ] && insmod /mnt/system/ko/soph_sys.ko
+[ -f /mnt/system/ko/soph_base.ko ] && insmod /mnt/system/ko/soph_base.ko
+[ -f /mnt/system/ko/soph_rtos_cmdqu.ko ] && insmod /mnt/system/ko/soph_rtos_cmdqu.ko
+[ -f /mnt/system/ko/soph_fast_image.ko ] && insmod /mnt/system/ko/soph_fast_image.ko
+[ -f /mnt/system/ko/soph_mipi_rx.ko ] && insmod /mnt/system/ko/soph_mipi_rx.ko
+[ -f /mnt/system/ko/soph_snsr_i2c.ko ] && insmod /mnt/system/ko/soph_snsr_i2c.ko
+[ -f /mnt/system/ko/soph_vi.ko ] && insmod /mnt/system/ko/soph_vi.ko
+[ -f /mnt/system/ko/soph_vpss.ko ] && insmod /mnt/system/ko/soph_vpss.ko
+[ -f /mnt/system/ko/soph_dwa.ko ] && insmod /mnt/system/ko/soph_dwa.ko
+[ -f /mnt/system/ko/soph_vo.ko ] && insmod /mnt/system/ko/soph_vo.ko
+[ -f /mnt/system/ko/soph_mipi_tx.ko ] && insmod /mnt/system/ko/soph_mipi_tx.ko
+[ -f /mnt/system/ko/soph_rgn.ko ] && insmod /mnt/system/ko/soph_rgn.ko
+[ -f /mnt/system/ko/soph_clock_cooling.ko ] && insmod /mnt/system/ko/soph_clock_cooling.ko
+[ -f /mnt/system/ko/soph_tpu.ko ] && insmod /mnt/system/ko/soph_tpu.ko
+[ -f /mnt/system/ko/soph_vcodec.ko ] && insmod /mnt/system/ko/soph_vcodec.ko
+[ -f /mnt/system/ko/soph_jpeg.ko ] && insmod /mnt/system/ko/soph_jpeg.ko
+[ -f /mnt/system/ko/soph_vc_driver.ko ] && insmod /mnt/system/ko/soph_vc_driver.ko MaxVencChnNum=9 MaxVdecChnNum=9
+[ -f /mnt/system/ko/soph_ive.ko ] && insmod /mnt/system/ko/soph_ive.ko
 
 echo 3 > /proc/sys/vm/drop_caches
 dmesg -n 4
-- 
