From 2b67cffeb5b09c003159c8c7eb0a3769549ac1d1 Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Wed, 14 Oct 2026 21:51:58 +0300
Subject: [PATCH] buildroot: drop the RISC-V THEAD target LDFLAGS from the
 arm64 config
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The 64bit defconfig was seeded verbatim from the musl riscv64 one and
inherited its BR2_TARGET_LDFLAGS (-mcpu=c906fdv
-march=rv64imafdcv0p7xthead -mcmodel=medany -mabi=lp64d). Injected into
every target package build, those flags are rejected by the aarch64
toolchain at the first target link (zlib: unrecognized option
-mcmodel=medany) — the build can never pass br-rootfs-pack with them.
The c906 march flags only make sense for the C906 riscv build; the
aarch64 side builds for the Cortex-A53 with the toolchain defaults.
---
 buildroot/configs/cvitek_SG200X_64bit_defconfig | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/buildroot/configs/cvitek_SG200X_64bit_defconfig b/buildroot/configs/cvitek_SG200X_64bit_defconfig
index fa5f7677c..b3f7a8116 100644
--- a/buildroot/configs/cvitek_SG200X_64bit_defconfig
+++ b/buildroot/configs/cvitek_SG200X_64bit_defconfig
@@ -231,7 +231,7 @@ BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
 # BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL is not set
 BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
 BR2_TOOLCHAIN_EXTERNAL_HAS_SSP_STRONG=y
-BR2_TOOLCHAIN_EXTERNAL_INET_RPC=y
+# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
 BR2_TOOLCHAIN_EXTERNAL_CXX=y
 # BR2_TOOLCHAIN_EXTERNAL_DLANG is not set
 BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
@@ -272,7 +272,7 @@ BR2_TOOLCHAIN_SUPPORTS_PIE=y
 BR2_TOOLCHAIN_EXTRA_LIBS=""
 BR2_TOOLCHAIN_HAS_FULL_GETTEXT=y
 BR2_TARGET_OPTIMIZATION=""
-BR2_TARGET_LDFLAGS="-mcpu=c906fdv -march=rv64imafdcv0p7xthead -mcmodel=medany -mabi=lp64d"
+BR2_TARGET_LDFLAGS=""
 BR2_TOOLCHAIN_HEADERS_AT_LEAST_3_0=y
 BR2_TOOLCHAIN_HEADERS_AT_LEAST_3_1=y
 BR2_TOOLCHAIN_HEADERS_AT_LEAST_3_2=y
@@ -3514,7 +3514,7 @@ BR2_TARGET_ROOTFS_EXT2_4=y
 BR2_TARGET_ROOTFS_EXT2_GEN=4
 BR2_TARGET_ROOTFS_EXT2_REV=1
 BR2_TARGET_ROOTFS_EXT2_LABEL="rootfs"
-BR2_TARGET_ROOTFS_EXT2_SIZE="2800M"
+BR2_TARGET_ROOTFS_EXT2_SIZE="200M"
 BR2_TARGET_ROOTFS_EXT2_INODES=0
 BR2_TARGET_ROOTFS_EXT2_INODE_SIZE=256
 BR2_TARGET_ROOTFS_EXT2_RESBLKS=5
-- 
