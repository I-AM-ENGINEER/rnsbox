From ab7dae0b7c5928ec0f73c67e9127f4cea115cffe Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Sat, 17 Oct 2026 00:30:00 +0300
Subject: [PATCH] wifi: AIC8800 SDIO on the arm64 board family
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The arm64 board dts only inherited the wifisd LABEL STUB from
soph_base_arm.dtsi (interrupt line, no compatible/reg/clocks), so the
cvitek sdio driver never probed the AIC8800 of the -W boards and the
portal showed "No WiFi radio detected" on boards that have the radio.
Per package:
- sg2000_duo01evb (BGA): fill the &wifisd node (same properties as the
  vendor arm boards carry) and add the wifi_pin node (porta15/porte7,
  the Milk-V Duo S reference wiring — same as the RV duo01 board).
- sg2002_duo (QFN): soph_asic_qfn.dtsi deletes wifi-sd@4320000 outright;
  re-declare the full node (what the vendor sg2002_licheea53nano board
  does after the same delete) and keep the qfn wifi_pin (porte2/porte6).
Both linux defconfigs gain CONFIG_CVI_WIFI_PIN for the cvitek,wifi-pin
driver (WL_REG_ON / WL_HOST_WAKE sequencing for aic8800_bsp). The plain
(non-W) boards have no radio: S35wifi already degrades to a logged
no-op, so the absence stays soft.
---
 .../dts_arm64/sg2000_duo01evb_arm64_sd.dts    | 36 +++++++++++++++++++
 .../linux/sg2000_duo01evb_arm64_sd_defconfig  |  3 ++
 .../dts_arm64/sg2002_duo_arm64_sd.dts         | 29 +++++++++++++++
 .../linux/sg2002_duo_arm64_sd_defconfig       |  3 ++
 4 files changed, 71 insertions(+)

diff --git a/build/boards/sg200x/sg2000_duo01evb_arm64_sd/dts_arm64/sg2000_duo01evb_arm64_sd.dts b/build/boards/sg200x/sg2000_duo01evb_arm64_sd/dts_arm64/sg2000_duo01evb_arm64_sd.dts
index f3cd8a2..4f7e513 100644
--- a/build/boards/sg200x/sg2000_duo01evb_arm64_sd/dts_arm64/sg2000_duo01evb_arm64_sd.dts
+++ b/build/boards/sg200x/sg2000_duo01evb_arm64_sd/dts_arm64/sg2000_duo01evb_arm64_sd.dts
@@ -46,3 +46,39 @@
 	min-frequency = <400000>; // 400Khz
 	max-frequency = <25000000>; // 25Mhz
 };
+
+// Duo Module 01-W only: AIC8800 over SDIO (the -W module carries the
+// radio; the plain Module 01 has none and the absence stays soft —
+// S35wifi exits 0 when no wlanN appears, the portal shows "No WiFi
+// radio detected"). The base dtsi only stubs the label with the
+// interrupt line: these are the node properties that make the cvitek
+// sdio driver actually probe (same ones the vendor arm boards carry).
+// Power/wakeup pins per the Milk-V Duo S reference design; the
+// cvi_wifi_pin driver (CONFIG_CVI_WIFI_PIN below) owns the WL_REG_ON /
+// WL_HOST_WAKE sequencing for the aic8800_bsp probe.
+&wifisd {
+	compatible = "cvitek,cv181x-sdio";
+	bus-width = <4>;
+	reg = <0x0 0x4320000 0x0 0x1000>;
+	reg_names = "core_mem";
+	src-frequency = <375000000>;
+	min-frequency = <400000>; // 400Khz
+	max-frequency = <25000000>; // 25Mhz
+	64_addressing;
+	reset_tx_rx_phy;
+	non-removable;
+	pll_index = <0x7>;
+	pll_reg = <0x300207C>;
+	no-mmc;
+	no-sd;
+	status = "okay";
+	interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>;
+};
+
+/ {
+	wifi_pin {
+		compatible = "cvitek,wifi-pin";
+		poweron-gpio = <&porta 15 GPIO_ACTIVE_HIGH>;
+		wakeup-gpio = <&porte 7 GPIO_ACTIVE_HIGH>;
+	};
+};
diff --git a/build/boards/sg200x/sg2000_duo01evb_arm64_sd/linux/sg2000_duo01evb_arm64_sd_defconfig b/build/boards/sg200x/sg2000_duo01evb_arm64_sd/linux/sg2000_duo01evb_arm64_sd_defconfig
index 5f1a782..e6f09c7 100644
--- a/build/boards/sg200x/sg2000_duo01evb_arm64_sd/linux/sg2000_duo01evb_arm64_sd_defconfig
+++ b/build/boards/sg200x/sg2000_duo01evb_arm64_sd/linux/sg2000_duo01evb_arm64_sd_defconfig
@@ -386,6 +386,9 @@ CONFIG_MMC=y
 CONFIG_MMC_SDHCI=y
 CONFIG_MMC_SDHCI_PLTFM=y
 CONFIG_MMC_SDHCI_CVI=y
+# RNSBox: the cvitek,wifi-pin DT driver — WL_REG_ON/HOST_WAKE
+# sequencing for the AIC8800 SDIO radio of the -W boards
+CONFIG_CVI_WIFI_PIN=y
 CONFIG_BLK_CMDLINE_PARSER=y
 CONFIG_PARTITION_ADVANCED=y
 CONFIG_CMDLINE_PARTITION=y
diff --git a/build/boards/sg200x/sg2002_duo_arm64_sd/dts_arm64/sg2002_duo_arm64_sd.dts b/build/boards/sg200x/sg2002_duo_arm64_sd/dts_arm64/sg2002_duo_arm64_sd.dts
index 15622bf..f2ee471 100755
--- a/build/boards/sg200x/sg2002_duo_arm64_sd/dts_arm64/sg2002_duo_arm64_sd.dts
+++ b/build/boards/sg200x/sg2002_duo_arm64_sd/dts_arm64/sg2002_duo_arm64_sd.dts
@@ -49,3 +49,32 @@
 	min-frequency = <400000>; // 400Khz
 	max-frequency = <25000000>; // 25Mhz
 };
+
+// Duo (SG2002) -W radio only: AIC8800 over SDIO. soph_asic_qfn.dtsi
+// DELETES wifi-sd@4320000 (the vendor default for QFN carriers without a
+// radio), so the node is re-declared here IN FULL — the same thing the
+// vendor sg2002_licheea53nano arm board does after the same delete. The
+// qfn dtsi's own wifi_pin (poweron porte2 / wakeup porte6) stays: it is
+// the vendor wiring for this package. On carriers without the -W radio
+// the absence stays soft (S35wifi exits 0, portal shows "No WiFi radio
+// detected").
+/ {
+	wifisd:wifi-sd@4320000 {
+		compatible = "cvitek,cv181x-sdio";
+		bus-width = <4>;
+		reg = <0x0 0x4320000 0x0 0x1000>;
+		reg_names = "core_mem";
+		src-frequency = <375000000>;
+		min-frequency = <400000>; // 400Khz
+		max-frequency = <25000000>; // 25Mhz
+		64_addressing;
+		reset_tx_rx_phy;
+		non-removable;
+		pll_index = <0x7>;
+		pll_reg = <0x300207C>;
+		no-mmc;
+		no-sd;
+		status = "okay";
+		interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>;
+	};
+};
diff --git a/build/boards/sg200x/sg2002_duo_arm64_sd/linux/sg2002_duo_arm64_sd_defconfig b/build/boards/sg200x/sg2002_duo_arm64_sd/linux/sg2002_duo_arm64_sd_defconfig
index 5f1a782..e6f09c7 100644
--- a/build/boards/sg200x/sg2002_duo_arm64_sd/linux/sg2002_duo_arm64_sd_defconfig
+++ b/build/boards/sg200x/sg2002_duo_arm64_sd/linux/sg2002_duo_arm64_sd_defconfig
@@ -386,6 +386,9 @@ CONFIG_MMC=y
 CONFIG_MMC_SDHCI=y
 CONFIG_MMC_SDHCI_PLTFM=y
 CONFIG_MMC_SDHCI_CVI=y
+# RNSBox: the cvitek,wifi-pin DT driver — WL_REG_ON/HOST_WAKE
+# sequencing for the AIC8800 SDIO radio of the -W boards
+CONFIG_CVI_WIFI_PIN=y
 CONFIG_BLK_CMDLINE_PARSER=y
 CONFIG_PARTITION_ADVANCED=y
 CONFIG_CMDLINE_PARTITION=y
-- 
