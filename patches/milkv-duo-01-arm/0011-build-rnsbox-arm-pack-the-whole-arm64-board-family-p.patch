From 9c66d583c1e5ee2e8ec6c2fa232188d2b9b0ee1e Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Thu, 15 Oct 2026 00:43:22 +0300
Subject: [PATCH 11/11] build-rnsbox-arm: pack the whole arm64 board family per
 run
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The packer now takes optional board names after the variant
(default: BOTH family boards) and loops defconfig/pack_rootfs/
pack_burn_image per board, tagging each image with the variant suffix.
The variant shaping (ext4 size, per-board partition XML, genimage
usb.disk0 lines, ISO stash/restore) is applied for the whole family;
the shared aarch64 rootfs is packed once per board from the same
buildroot output (identical content, so no rootfs rebuild between
boards). The BSP build (build_all per board, done by build.sh) must
have produced install/soc_<board> beforehand — this script only packs.
---
 build-rnsbox-arm.sh | 86 +++++++++++++++++++++++++++++++--------------
 1 file changed, 59 insertions(+), 27 deletions(-)

diff --git a/build-rnsbox-arm.sh b/build-rnsbox-arm.sh
index 454930dc8..d0b9285dd 100755
--- a/build-rnsbox-arm.sh
+++ b/build-rnsbox-arm.sh
@@ -1,13 +1,23 @@
 #!/bin/bash
-# Unified RNSBox build — DVD or LITE variant from one switch.
+# Unified RNSBox build — DVD or LITE variant from one switch, packing the
+# whole arm64 board family from the SAME aarch64 rootfs + kernel build.
 #
-#   ./build-rnsbox.sh dvd     (default) — composite NCM + read-only clients
-#                                          DVD (ISO9660 in rootfs); ~2.8 GB img.
-#   ./build-rnsbox.sh lite              — NCM-only gadget, no clients drive;
-#                                          ~226 MB img (the lighter download).
+#   ./build-rnsbox-arm.sh [dvd|lite] [board ...]
 #
-# The variant touches four spots; this script sets them all, builds, then
-# restores the in-tree files so the tree is left clean for the next run:
+#   variant  dvd (default) — composite NCM + read-only clients DVD
+#                              (ISO9660 in rootfs); ~2.8 GB img per board.
+#            lite          — NCM-only gadget, no clients drive;
+#                            ~226 MB img per board (the lighter download).
+#   boards   subset of the arm64 family to pack (default: ALL of them).
+#            The BSP build (build_all) must have produced install/soc_<b>
+#            for every requested board already — this script only packs.
+#
+# The family shares one kernel Image (identical arm64 defconfigs, per-board
+# DTBs) and one buildroot rootfs (the shared cvitek_SG200X_64bit_defconfig
+# output); only boot.sd (single-DTB boot.itb), fip.bin and the per-board
+# memmap differ. The variant touches four spots; this script sets them all,
+# packs every board, then restores the in-tree files so the tree is left
+# clean for the next run:
 #   1. overlay ISO        /opt/rnsbox-clients/usbdisk.iso  (present | absent)
 #   2. defconfig ext4     BR2_TARGET_ROOTFS_EXT2_SIZE       (2800M | 200M)
 #   3. partition XML      ROOTFS size_in_kb                 (3072000 | 1638400)
@@ -18,20 +28,37 @@ ROOT="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
 cd "$ROOT" || exit 90
 
 VARIANT="${1:-dvd}"
-case "$VARIANT" in dvd|lite) ;; *) echo "usage: $0 {dvd|lite}"; exit 1 ;; esac
+shift || true
+case "$VARIANT" in dvd|lite) ;; *) echo "usage: $0 {dvd|lite} [board ...]"; exit 1 ;; esac
+
+# the arm64 family: one kernel superset + one rootfs, per-board DTBs/fip
+FAMILY_BOARDS="sg2000_duo01evb_arm64_sd sg2002_duo_arm64_sd"
+BOARDS="$*"
+[ -n "$BOARDS" ] || BOARDS=$FAMILY_BOARDS
+for b in $BOARDS; do
+    case " $FAMILY_BOARDS " in *" $b "*) ;; *)
+        echo "unknown arm64 board '$b' — expected one of: $FAMILY_BOARDS"; exit 1 ;;
+    esac
+    [ -d "build/boards/sg200x/$b" ] || {
+        echo "missing board dir build/boards/sg200x/$b (was build_all run for it?)"; exit 1; }
+done
+
 LOG=/tmp/rnsbox-build.log; : > "$LOG"; exec > >(tee -a "$LOG") 2>&1
-echo "=================== RNSBox build [$VARIANT] $(date) ==================="
+echo "=================== RNSBox build [$VARIANT] boards: $BOARDS $(date) ==================="
 
 DEFCONFIG=buildroot/configs/cvitek_SG200X_64bit_defconfig
-PARTXML=build/boards/sg200x/sg2000_duo01evb_arm64_sd/partition/partition_sd.xml
 GENIMG=build/tools/common/sd_tools/genimage_rootless.cfg
 ISO_OVERLAY=buildroot/board/cvitek/SG200X/overlay/opt/rnsbox-clients/usbdisk.iso
 ISO_STASH=/tmp/rnsbox-usbdisk.iso.stash
 
+partxml() { echo "build/boards/sg200x/$1/partition/partition_sd.xml"; }
+
 restore() {
 	# put the tree back to the committed DVD-shaped state
 	sed -i 's/^BR2_TARGET_ROOTFS_EXT2_SIZE=.*/BR2_TARGET_ROOTFS_EXT2_SIZE="2800M"/' "$DEFCONFIG"
-	sed -i 's#\(<partition label="ROOTFS" size_in_kb=\)"[0-9]*"#\1"3072000"#' "$PARTXML"
+	for b in $FAMILY_BOARDS; do
+		sed -i 's#\(<partition label="ROOTFS" size_in_kb=\)"[0-9]*"#\1"3072000"#' "$(partxml "$b")"
+	done
 	# ensure the usb.disk0 lines are present in genimage (DVD shape)
 	grep -q '"usb.disk0"' "$GENIMG" || sed -i 's#\("usb.ncm.mac",\)#\1\n                        "usb.disk0",\n                        "usb.disk0.size",#' "$GENIMG"
 	# restore the ISO into the overlay if we stashed it
@@ -52,7 +79,9 @@ if [ "$VARIANT" = dvd ]; then
 	PART_KB=$(( (EXT2_MB + 200) * 1024 ))
 	echo "--- DVD: ISO ${ISO_MB}M -> rootfs ${EXT2_MB}M, partition $(( PART_KB / 1024 ))MiB ---"
 	sed -i "s/^BR2_TARGET_ROOTFS_EXT2_SIZE=.*/BR2_TARGET_ROOTFS_EXT2_SIZE=\"${EXT2_MB}M\"/" "$DEFCONFIG"
-	sed -i "s#\(<partition label=\"ROOTFS\" size_in_kb=\)\"[0-9]*\"#\1\"${PART_KB}\"#" "$PARTXML"
+	for b in $FAMILY_BOARDS; do
+		sed -i "s#\(<partition label=\"ROOTFS\" size_in_kb=\)\"[0-9]*\"#\1\"${PART_KB}\"#" "$(partxml "$b")"
+	done
 	grep -q '"usb.disk0"' "$GENIMG" || sed -i 's#\("usb.ncm.mac",\)#\1\n                        "usb.disk0",\n                        "usb.disk0.size",#' "$GENIMG"
 	SUFFIX=dvd
 else
@@ -62,7 +91,9 @@ else
 	[ -f "$ISO_OVERLAY" ] && mv "$ISO_OVERLAY" "$ISO_STASH"
 	rm -f buildroot/output/target/opt/rnsbox-clients/usbdisk.iso 2>/dev/null
 	sed -i 's/^BR2_TARGET_ROOTFS_EXT2_SIZE=.*/BR2_TARGET_ROOTFS_EXT2_SIZE="200M"/' "$DEFCONFIG"
-	sed -i 's#\(<partition label="ROOTFS" size_in_kb=\)"[0-9]*"#\1"1638400"#' "$PARTXML"
+	for b in $FAMILY_BOARDS; do
+		sed -i 's#\(<partition label="ROOTFS" size_in_kb=\)"[0-9]*"#\1"1638400"#' "$(partxml "$b")"
+	done
 	# drop the usb.disk0 lines from the genimage boot.vfat list (would error if absent)
 	sed -i '/"usb.disk0",/d; /"usb.disk0.size",/d' "$GENIMG"
 	SUFFIX=lite
@@ -75,22 +106,23 @@ echo "--- ensure all overlay init scripts are executable ---"
 # missing execute bit can never reach the image again.
 chmod 0755 buildroot/board/cvitek/SG200X/overlay/etc/init.d/S* 2>/dev/null
 
-echo "--- source cvisetup + defconfig ---"
+echo "--- source cvisetup ---"
 source build/cvisetup.sh || { echo "FATAL: cvisetup"; exit 93; }
-defconfig sg2000_duo01evb_arm64_sd || { echo "FATAL: defconfig"; exit 94; }
-BRD="${BR_DIR:-$ROOT/buildroot}"
-rm -rf "$BRD"/output/build/rnsbox-portal-0.1.0
 export PATH=/usr/sbin:/sbin:$PATH
 
-echo "--- pack_rootfs ---"
-pack_rootfs || { echo "FATAL: pack_rootfs"; exit 95; }
-echo "--- pack_burn_image ---"
-pack_burn_image || { echo "FATAL: pack_burn_image"; exit 96; }
-
-# tag the produced image with the variant suffix
-NEW=$(ls -t install/soc_sg2000_duo01evb_arm64_sd/images/*.img | head -1)
-TAGGED="${NEW%.img}-${SUFFIX}.img"
-cp -f "$NEW" "$TAGGED"
+for b in $BOARDS; do
+	echo "--- pack [$b] ---"
+	defconfig "$b" || { echo "FATAL: defconfig $b"; exit 94; }
+	BRD="${BR_DIR:-$ROOT/buildroot}"
+	rm -rf "$BRD"/output/build/rnsbox-portal-0.1.0
+	pack_rootfs || { echo "FATAL: pack_rootfs ($b)"; exit 95; }
+	pack_burn_image || { echo "FATAL: pack_burn_image ($b)"; exit 96; }
+	NEW=$(ls -t "install/soc_$b/images/"*.img 2>/dev/null | head -1)
+	[ -n "$NEW" ] || { echo "FATAL: no img produced for $b"; exit 97; }
+	# tag the produced image with the variant suffix
+	TAGGED="${NEW%.img}-${SUFFIX}.img"
+	cp -f "$NEW" "$TAGGED"
+	ls -lh "$TAGGED" | awk '{print "  "$5"  "$NF}'
+done
 echo "=================== BUILD OK [$VARIANT] $(date) ==================="
-ls -lh "$TAGGED" | awk '{print "  "$5"  "$NF}'
 echo "DONE-SENTINEL-OK"
-- 
