From 00b7673b130087ff1b367867bbef3534be19cb1c Mon Sep 17 00:00:00 2001
From: rnsbox <rnsbox@localhost>
Date: Sat, 17 Oct 2026 02:42:50 +0300
Subject: [PATCH] wifi: AIC8800 Bluetooth SDIO transport (BlueZ hci0) on the
 arm64 boards
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The -W radio (AIC8801, SDIO) already boots the combined WiFi+BT firmware
fmacfwbt.bin — the bsp Makefile carries CONFIG_SDIO_BT=y (vendor stock),
so aicbt_init() loads the BT patches and aicwifi_init() downloads
fmacfwbt.bin on every shipped image; the radio side of Bluetooth was
there all along. What was missing is the HCI side:

- aic8800_fdrv/Makefile: CONFIG_SDIO_BT=y again (the shared licheerv
  series 0011 had set n for the WiFi-only rv builds; the rv kernels
  keep CONFIG_BT off, so this is an arm64-series change). Builds
  aic_btsdio.o + btsdio.o into aic8800_fdrv.ko and defines
  -DCONFIG_SDIO_BT so rwnx_main.c registers the HCI device at probe.
- aic8800_fdrv/aic_btsdio.h: force CONFIG_BLUEDROID 0 (the kernel-HCI
  BlueZ path, btsdio.c => a real hci0). The platform ifdef picked the
  Android-bluedroid char-device path (private hci + /dev/aicbt_dev)
  because the CVITEK cross build never defines
  CONFIG_PLATFORM_UBUNTU; nothing on a buildroot image speaks that ABI.
- aic8800/Makefile: CONFIG_AIC8800_BTLPM_SUPPORT := m so aic8800_btlpm.ko
  (LPM/rfkill auxiliary) ships too. Not auto-loaded: its rfkill node
  starts soft-blocked and the SDIO transport needs none of it.

hci0 appears when S35wifi insmods aic8800_fdrv (btsdio_init); S37bluetooth
and bluetoothd pick it up unchanged. Firmware needs no change:
slim-target.sh already keeps fmacfwbt.bin + the BT patch files.
---
 osdrv/extdrv/wireless/aic8800/Makefile                |  7 +++++--
 osdrv/extdrv/wireless/aic8800/aic8800_fdrv/Makefile   |  5 ++++-
 .../extdrv/wireless/aic8800/aic8800_fdrv/aic_btsdio.h | 11 +++++++----
 3 files changed, 16 insertions(+), 7 deletions(-)

diff --git a/osdrv/extdrv/wireless/aic8800/Makefile b/osdrv/extdrv/wireless/aic8800/Makefile
index e88311ce4..589ed5774 100755
--- a/osdrv/extdrv/wireless/aic8800/Makefile
+++ b/osdrv/extdrv/wireless/aic8800/Makefile
@@ -1,5 +1,8 @@
-# RNSBox W variant: BT off (no bluez, no BT use case) — WLAN + BSP only.
-CONFIG_AIC8800_BTLPM_SUPPORT := n
+# RNSBox arm64: BT on — build the btlpm (LPM/rfkill) module too. The shared
+# licheerv series sets n (rv kernels keep CONFIG_BT off); the arm64 kernel
+# ships CONFIG_BT=y and BlueZ, so aic8800_btlpm.ko ships (not auto-loaded:
+# its rfkill node starts soft-blocked and the SDIO transport needs none).
+CONFIG_AIC8800_BTLPM_SUPPORT := m
 CONFIG_AIC8800_WLAN_SUPPORT := m
 CONFIG_AIC_WLAN_SUPPORT := m
 
diff --git a/osdrv/extdrv/wireless/aic8800/aic8800_fdrv/Makefile b/osdrv/extdrv/wireless/aic8800/aic8800_fdrv/Makefile
index ed314f917..9e0eaa273 100755
--- a/osdrv/extdrv/wireless/aic8800/aic8800_fdrv/Makefile
+++ b/osdrv/extdrv/wireless/aic8800/aic8800_fdrv/Makefile
@@ -73,7 +73,10 @@ CONFIG_RADAR_OR_IR_DETECT =n
 CONFIG_DOWNLOAD_FW =n
 CONFIG_RFTEST=y
 CONFIG_USB_BT =n
-CONFIG_SDIO_BT=n
+# RNSBox arm64: BT back ON (vendor default was y; 0011 in the shared series
+# turned it off for the WiFi-only rv builds). Builds aic_btsdio.o + btsdio.o
+# into aic8800_fdrv.ko and defines -DCONFIG_SDIO_BT (see ccflags below).
+CONFIG_SDIO_BT=y
 CONFIG_USE_5G ?= y
 CONFIG_CREATE_TRACE_POINTS = n
 CONFIG_TXRX_THREAD_PRIO = y
diff --git a/osdrv/extdrv/wireless/aic8800/aic8800_fdrv/aic_btsdio.h b/osdrv/extdrv/wireless/aic8800/aic8800_fdrv/aic_btsdio.h
index a58edc97f..55c1950e1 100755
--- a/osdrv/extdrv/wireless/aic8800/aic8800_fdrv/aic_btsdio.h
+++ b/osdrv/extdrv/wireless/aic8800/aic8800_fdrv/aic_btsdio.h
@@ -18,11 +18,14 @@
 #include <linux/suspend.h>
 
 
-#ifdef CONFIG_PLATFORM_UBUNTU
+/* RNSBox arm64: force the BlueZ transport (kernel HCI => a real hci0 for
+ * bluetoothd/BlueZ). The platform switch below would pick the Android
+ * bluedroid char-device path (/dev/aicbt_dev + a PRIVATE hci_dev) because
+ * the CVITEK cross build runs with CONFIG_PLATFORM_UBUNTU unset — no user
+ * of that ABI exists on this image. btsdio.c carries the kernel-side
+ * implementation selected by CONFIG_BLUEDROID == 0 (rwnx_main.c calls
+ * btsdio_init() instead of btchr_init()/hdev_init()). */
 #define CONFIG_BLUEDROID        0 /* bleuz 0, bluedroid 1, lbh 2 */
-#else
-#define CONFIG_BLUEDROID        1 /* bleuz 0, bluedroid 1, lbh 2 */
-#endif
 /* #define HCI_VERSION_CODE KERNEL_VERSION(3, 14, 41) */
 #define HCI_VERSION_CODE LINUX_VERSION_CODE
 
-- 
