#!/bin/sh
# S84cron — regenerate the root crontab from /etc/rnsbox/cron.conf and start
# busybox crond. Runs after S82rnsd (so rnsd is up before any restart job).
#
# Why regenerate at boot: crond is started with its spool at
# /run/cron/crontabs (root's crontab = /run/cron/crontabs/root), and /run is
# tmpfs (wiped each boot). The persistent source of truth is
# /etc/rnsbox/cron.conf; this script materializes it into the spool.
#
# Scheduled tasks: the optional rnsd auto-restart (memory hygiene):
# rnsd_restart_days=N restarts rnsd every N days at 04:00 (N=0, the default,
# means no entry), the daily 05:00 rnsd update check (update_check=yes), and
# always the hourly RTC resync (`S45ntpsync resync`, at :17): the clock
# re-checked against NTP and written to the RTC, since the kernel's own
# 11-minute write-back can't be relied on here (see S45ntpsync). It does
# nothing without an RTC or a reachable NTP server.
#
# Plus a once-per-boot update check (`bootcheck`), run once the clock is
# trusted (/run/clock-synced, kept by S45ntpsync / the portal) and a default
# route exists: start() calls it (covers a clock S45ntpsync took from the RTC
# at boot, with the WAN already up) and S46wanwatch calls it once both hold
# later (NTP once a WAN is up, a browser sync, or a late WAN). A /run marker
# makes it fire once per boot whoever calls first. The update checks (this,
# the daily one via rnsbox-update-check, and the portal's) are the one
# consumer that genuinely needs real time; nothing else waits for the clock.

CONF=/etc/rnsbox/cron.conf
# On /run (0755, root-only). NOT the busybox default /var/spool (-> /tmp, 1777):
# a non-root process could pre-create a subdir there and plant a symlink for
# root to follow, which the sticky-dir protected_* sysctls don't cover.
CRONDIR=/run/cron/crontabs
CRONTAB="$CRONDIR/root"
LOG=/var/log/cron.log
BOOTCHECK_MARK=/run/rnsbox-update-bootcheck   # S46wanwatch tests this too

cfg() {
	grep -E "^[[:space:]]*$1[[:space:]]*=" "$CONF" 2>/dev/null | tail -1 \
	  | sed -E "s/^[^=]*=[[:space:]]*//" | sed -E 's/[[:space:]]*#.*$//' \
	  | sed -E 's/[[:space:]]*$//'
}

# update_check from cron.conf -> $uc = yes|no (default yes)
read_uc() {
	uc=$(cfg update_check)
	case "$uc" in no|No|NO|0|false|off) uc=no ;; *) uc=yes ;; esac
}

gen_crontab() {
	mkdir -p -m 700 "$CRONDIR" || return 1
	days=$(cfg rnsd_restart_days)
	case "$days" in ''|*[!0-9]*) days=0 ;; esac
	read_uc
	# Built beside the spool (same tmpfs), then renamed in: rename(2) replaces
	# whatever is at the path instead of following it, and the one directory
	# change it makes is what tells crond to rescan (next wakeup, <= 60 s).
	tmp="${CRONDIR%/*}/.root.$$"
	rm -f "$tmp"
	{
		echo "# Auto-generated by S84cron from $CONF — do not hand-edit."
		echo "# (edit /etc/rnsbox/cron.conf or use the portal Reticulum tab)"
		# jobs otherwise inherit crond's PATH, which depends on who started
		# it (rcS, or the portal's reload); hwclock and ip live in /sbin
		echo "PATH=/sbin:/usr/sbin:/bin:/usr/bin"
		if [ "$days" -ge 1 ] 2>/dev/null && [ "$days" -le 7 ]; then
			# min hour day-of-month month day-of-week  command
			# every N days at 04:00; kick-restart does nothing after an
			# explicit `S82rnsd stop` (operator or rcK), unlike restart
			echo "0 4 */$days * * /etc/init.d/S82rnsd kick-restart >> $LOG 2>&1"
		fi
		if [ "$uc" = yes ]; then
			# daily at 05:00: notify-only check for a newer rnsd (offline-safe)
			echo "0 5 * * * /usr/sbin/rnsbox-update-check >> $LOG 2>&1"
		fi
		# hourly at :17 (clear of the jobs above): clock checked against NTP
		# and written to the RTC; logs to /var/log/ntp-step.log itself
		echo "17 * * * * /etc/init.d/S45ntpsync resync >> $LOG 2>&1"
	} > "$tmp" || { rm -f "$tmp"; return 1; }
	chmod 600 "$tmp"
	mv -f "$tmp" "$CRONTAB"
	[ "$days" -ge 1 ] 2>/dev/null && echo "S84cron: rnsd auto-restart every $days day(s) at 04:00" \
	                              || echo "S84cron: rnsd auto-restart disabled"
	[ "$uc" = yes ] && echo "S84cron: daily rnsd update check enabled" \
	                || echo "S84cron: rnsd update check disabled"
	echo "S84cron: hourly RTC resync from NTP (a no-op without an RTC)"
}

# have_route - true while the main table has an IPv4 default route (same
# test as S45ntpsync). Builtins only.
have_route() {
	while read -r _ifc dst _gw _flags _rc _use _met mask _rest; do
		[ "$dst" = 00000000 ] && [ "$mask" = 00000000 ] && return 0
	done 2>/dev/null </proc/net/route
	return 1
}

# Once-per-boot update check. Needs a trusted clock (TLS to PyPI, and the
# result is timestamped) and an uplink; until then it does nothing and
# S46wanwatch calls it again. A trusted clock no longer implies an uplink:
# with an RTC it is trusted at S45, possibly long before the WAN (upstream
# router rebooting after the same power cut, cable plugged in later, WiFi STA
# still associating), so the marker isn't spent until a default route exists.
# mkdir is atomic, so the marker also settles a start()/wanwatch race. /run
# is tmpfs, so the marker resets every boot.
bootcheck() {
	[ -f /run/clock-synced ] || return 0
	have_route || return 0
	mkdir "$BOOTCHECK_MARK" 2>/dev/null || return 0
	read_uc
	if [ "$uc" != yes ]; then
		echo "S84cron: boot-time update check disabled (update_check=no)"
		return 0
	fi
	# Backgrounded so it never blocks boot/wanwatch; the short delay lets rnsd
	# and the freshly-up WAN settle first. Quiet when offline. stdin is
	# /dev/null too, so it keeps none of its caller's stdio (S46wanwatch, the
	# portal, an SSH shell).
	( sleep 30; /usr/sbin/rnsbox-update-check ) </dev/null >>"$LOG" 2>&1 &
	echo "S84cron: boot-time update check scheduled"
}

start() {
	gen_crontab
	# -b = background; -c = the crontabs dir itself. Start only if not
	# already running.
	if ! pidof crond >/dev/null 2>&1; then
		crond -b -c "$CRONDIR" 2>>"$LOG"
	fi
	bootcheck
}

stop() {
	killall crond 2>/dev/null
}

# `reload` = regenerate the crontab for crond to pick up, without a full
# restart. The portal calls this after changing the schedule. No signal:
# busybox crond has no SIGHUP handler (HUP kills it); it rescans the spool on
# its next wakeup (<= 60 s) because gen_crontab's rename changed the spool
# directory's mtime.
reload() {
	gen_crontab
	if ! pidof crond >/dev/null 2>&1; then
		crond -b -c "$CRONDIR" 2>>"$LOG"
	fi
}

case "${1:-start}" in
	start)     start ;;
	stop)      stop ;;
	restart)   stop; sleep 1; start ;;
	reload)    reload ;;
	bootcheck) bootcheck ;;
	*) echo "Usage: $0 {start|stop|restart|reload|bootcheck}" >&2; exit 1 ;;
esac
