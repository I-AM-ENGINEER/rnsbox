From: RNSBox <rnsbox@localhost>
Subject: [PATCH] client: set TCP_NODELAY on accepted sockets

uhttpd relays CGI output as HTTP/1.1 chunks. The terminating zero chunk
(and every small chunk of a streaming response) is a separate write;
Nagle holds it until the peer's delayed ACK arrives, which is ~40-50 ms
on the portal's clients. That penalised every CGI response, and the
Console tab's keystroke-sized PTY output chunks paid it on every read.

The portal is a LAN-only service, so the extra small packets are much
cheaper than the latency.

---
 client.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/client.c b/client.c
--- a/client.c
+++ b/client.c
@@ -19,6 +19,8 @@
 
 #include <libubox/blobmsg.h>
 #include <ctype.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
 
 #include "uhttpd.h"
 #include "tls.h"
@@ -628,6 +630,7 @@
 	struct client *cl;
 	unsigned int sl;
 	int sfd;
+	int one = 1;
 	static int client_id = 0;
 	struct sockaddr_in6 addr;
 
@@ -641,6 +644,16 @@
 	if (sfd < 0)
 		return false;
 
+	/*
+	 * CGI output is relayed as HTTP/1.1 chunks. The terminating zero
+	 * chunk and every small chunk of a streaming response are separate
+	 * writes; Nagle holds them until the peer's delayed ACK arrives,
+	 * adding up to ~40 ms to every CGI response and to each terminal
+	 * output chunk. The service is LAN-only; the extra packets are
+	 * cheaper than the latency.
+	 */
+	setsockopt(sfd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+
 	set_addr(&cl->peer_addr, &addr);
 	sl = sizeof(addr);
 	getsockname(sfd, (struct sockaddr *) &addr, &sl);
