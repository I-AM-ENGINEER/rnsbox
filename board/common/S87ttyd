#!/bin/sh
# S87ttyd — full zsh web terminal on the LAN (ttyd + xterm.js).
#
# ttyd listens on the box's LAN address only (10.42.0.1), never on the
# Ethernet uplink. The portal already requires a login; the terminal shares
# that trust boundary (USB-NCM link / hotspot password) and runs as root, so
# there is no second password prompt.
LOG=/var/log/ttyd.log
LAN_IP=10.42.0.1
PORT=7681

mkdir -p /var/log
zsh=$(command -v zsh 2>/dev/null); [ -n "$zsh" ] || zsh=/bin/sh
ttyd=$(command -v ttyd 2>/dev/null)
[ -n "$ttyd" ] || { echo "$(date '+%F %T'): ttyd not installed" >> "$LOG"; exit 0; }

case "${1:-start}" in
	start)
		pidof ttyd >/dev/null 2>&1 && exit 0
		"$ttyd" -W -i "$LAN_IP" -p "$PORT" -t "titleFixed=RNSBox console" \
			"$zsh" -l >>"$LOG" 2>&1 &
		;;
	stop)    killall ttyd 2>/dev/null ;;
	restart) "$0" stop; sleep 1; "$0" start ;;
	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
