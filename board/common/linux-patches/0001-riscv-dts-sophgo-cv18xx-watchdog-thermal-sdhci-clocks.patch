From: RNSBox <rnsbox@localhost>
Subject: [PATCH] riscv: dts: sophgo: add watchdog and thermal sensor, fix SDHCI clocks on CV18xx

The CV1800B/SG2000/SG2002 family shares the same DesignWare APB
watchdog (0x3010000), TEMPSEN thermal sensor (0x30e0000) and SDHCI
controllers.  The nodes were missing from the mainline cv180x.dtsi, so
every board in this tree lacked /dev/watchdog0 and any temperature
readout.

Add the watchdog node with CLK_APB_WDT/RST_WDT, the thermal sensor with
CLK_TEMPSEN, and the soc-thermal zone (passive 85 C, hot 95 C, critical
110 C).  The trip points are informational except critical, which the
thermal core turns into an orderly shutdown.

Also fix the SDHCI clock order.  sdhci-of-dwcmshc takes the divider
base from the clock named "core", but the DT listed the AXI gate
(CLK_AXI4_SD0/SD1/EMMC, fpll/5 ~= 300 MHz) instead of the actual card
clock (CLK_SD0/SD1/EMMC, fpll/15 = 100 MHz).  Programmed frequencies
therefore landed 3x below the requested rate: microSD ran at ~16.7 MHz
instead of 50, SDIO Wi-Fi at ~8.3 MHz instead of 25.  Swapping the
order restores the rates and is safe for boards that override the
clocks themselves.

The thermal sensor needs CONFIG_CV1800_THERMAL from the companion
thermal-driver patch; the watchdog needs CONFIG_DW_WATCHDOG.

---
diff --git a/arch/riscv/boot/dts/sophgo/cv180x.dtsi b/arch/riscv/boot/dts/sophgo/cv180x.dtsi
index ec3bf30..9da805c 100644
--- a/arch/riscv/boot/dts/sophgo/cv180x.dtsi
+++ b/arch/riscv/boot/dts/sophgo/cv180x.dtsi
@@ -160,6 +160,14 @@
 			};
 		};
 
+		soc_temp: thermal-sensor@30e0000 {
+			compatible = "sophgo,cv1800-thermal";
+			reg = <0x030e0000 0x100>;
+			clocks = <&clk CLK_TEMPSEN>;
+			interrupts = <SOC_PERIPHERAL_IRQ(0) IRQ_TYPE_LEVEL_HIGH>;
+			#thermal-sensor-cells = <0>;
+		};
+
 		saradc: adc@30f0000 {
 			compatible = "sophgo,cv1800b-saradc";
 			reg = <0x030f0000 0x1000>;
@@ -400,8 +408,8 @@
 			compatible = "sophgo,cv1800b-dwcmshc";
 			reg = <0x4310000 0x1000>;
 			interrupts = <SOC_PERIPHERAL_IRQ(20) IRQ_TYPE_LEVEL_HIGH>;
-			clocks = <&clk CLK_AXI4_SD0>,
-				 <&clk CLK_SD0>;
+			clocks = <&clk CLK_SD0>,
+				 <&clk CLK_AXI4_SD0>;
 			clock-names = "core", "bus";
 			status = "disabled";
 		};
@@ -410,8 +418,8 @@
 			compatible = "sophgo,cv1800b-dwcmshc";
 			reg = <0x4320000 0x1000>;
 			interrupts = <SOC_PERIPHERAL_IRQ(22) IRQ_TYPE_LEVEL_HIGH>;
-			clocks = <&clk CLK_AXI4_SD1>,
-				 <&clk CLK_SD1>;
+			clocks = <&clk CLK_SD1>,
+				 <&clk CLK_AXI4_SD1>;
 			clock-names = "core", "bus";
 			status = "disabled";
 		};
@@ -432,6 +440,15 @@
 			status = "disabled";
 		};
 
+		watchdog@3010000 {
+			compatible = "snps,dw-wdt";
+			reg = <0x3010000 0x1000>;
+			clocks = <&clk CLK_APB_WDT>;
+			clock-names = "tclk";
+			resets = <&rst RST_WDT>;
+			interrupts = <SOC_PERIPHERAL_IRQ(42) IRQ_TYPE_LEVEL_HIGH>;
+		};
+
 		usb: usb@4340000 {
 			compatible = "sophgo,cv1800b-usb";
 			reg = <0x04340000 0x10000>;
@@ -478,4 +495,32 @@
 			clock-names = "rtc", "mcu";
 		};
 	};
+
+	thermal-zones {
+		soc-thermal {
+			polling-delay-passive = <1000>;
+			polling-delay = <1000>;
+			thermal-sensors = <&soc_temp>;
+
+			trips {
+				soc_passive: soc-passive {
+					temperature = <85000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				soc_hot: soc-hot {
+					temperature = <95000>;
+					hysteresis = <5000>;
+					type = "hot";
+				};
+
+				soc_critical: soc-critical {
+					temperature = <110000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+		};
+	};
 };
diff --git a/arch/riscv/boot/dts/sophgo/cv181x.dtsi b/arch/riscv/boot/dts/sophgo/cv181x.dtsi
index bbdb306..f19e1fd 100644
--- a/arch/riscv/boot/dts/sophgo/cv181x.dtsi
+++ b/arch/riscv/boot/dts/sophgo/cv181x.dtsi
@@ -12,8 +12,8 @@
 			compatible = "sophgo,cv1800b-dwcmshc";
 			reg = <0x4300000 0x1000>;
 			interrupts = <SOC_PERIPHERAL_IRQ(18) IRQ_TYPE_LEVEL_HIGH>;
-			clocks = <&clk CLK_AXI4_EMMC>,
-				 <&clk CLK_EMMC>;
+			clocks = <&clk CLK_EMMC>,
+				 <&clk CLK_AXI4_EMMC>;
 			clock-names = "core", "bus";
 			status = "disabled";
 		};
-- 
2.43.0
