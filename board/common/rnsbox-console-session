#!/bin/sh
# rnsbox-console-session — print the pid of THE rnsbox-console screen session,
# starting one if needed. The portal addresses it as <pid>.rnsbox-console:
# plain -S rnsbox-console is ambiguous once a duplicate exists.
PIDFILE=/run/rnsbox-console.pid
NAME=rnsbox-console

pid=$(cat "$PIDFILE" 2>/dev/null)
if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
	echo "$pid"
	exit 0
fi

# A session may exist without a pidfile (first boot, stale file): reuse it.
pid=$(screen -ls 2>/dev/null | sed -n "s/^[[:space:]]*\([0-9][0-9]*\)\.$NAME.*/\1/p" | head -1)
if [ -n "$pid" ]; then
	echo "$pid" > "$PIDFILE"
	echo "$pid"
	exit 0
fi

screen -dmS "$NAME" /bin/login

# screen detaches; find the daemon by its command line.
i=0
while [ "$i" -lt 10 ]; do
	for p in /proc/[0-9]*; do
		[ -r "$p/cmdline" ] || continue
		c=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null)
		case "$c" in
			*SCREEN*-dmS*"$NAME"*)
				pid=${p#/proc/}
				echo "$pid" > "$PIDFILE"
				echo "$pid"
				exit 0
				;;
		esac
	done
	sleep 1
	i=$((i + 1))
done
exit 1
