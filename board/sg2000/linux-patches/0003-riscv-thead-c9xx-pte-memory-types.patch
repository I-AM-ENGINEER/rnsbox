From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RNSBox <rnsbox@localhost>
Date: Fri, 23 Oct 2026 00:00:00 +0300
Subject: [PATCH] riscv: set the T-Head C9xx PTE memory types on SG2000

The C906 in the CV1800B/SG2000/SG2002 does not implement Svpbmt. With
PTE bits [63:59] left at zero the hardware treats DDR as a device-like
mapping: plain loads/stores work, but the first atomic (amoor.d in
boot_cpu_init) raises a store/AMO access fault and the board hangs
silently right after start_kernel. The vendor 5.10 kernel programs the
T-Head memory-type bits (cacheable|bufferable|shareable for normal RAM),
and the kernel already defines the encodings (_PAGE_PMA_THEAD etc.) but
only activates them through a runtime alternative that this SoC does not
trigger. Program them unconditionally.

The nocache encoding is Shareable-only (as in the vendor kernel): with
Bufferable set, descriptor writes can stay in the C906 write buffer and
a DMA master reads stale dma-coherent memory.

--- a/arch/riscv/include/asm/pgtable-64.h
+++ b/arch/riscv/include/asm/pgtable-64.h
@@ -142,26 +142,22 @@
 
 static inline u64 riscv_page_mtmask(void)
 {
-	u64 val;
-
-	ALT_SVPBMT(val, _PAGE_MTMASK);
-	return val;
+	/* RNSBox SG2000 (T-Head C906): no Svpbmt and the runtime alternative
+	 * is not triggered on this SoC - use the T-Head encodings directly. */
+	return _PAGE_MTMASK_THEAD;
 }
 
 static inline u64 riscv_page_nocache(void)
 {
-	u64 val;
-
-	ALT_SVPBMT(val, _PAGE_NOCACHE);
-	return val;
+	/* Shareable-only, matching the vendor kernel: Bufferable writes can
+	 * linger in the C906 write buffer and a DMA master then reads stale
+	 * dma-coherent descriptors. */
+	return 1UL << 60;
 }
 
 static inline u64 riscv_page_io(void)
 {
-	u64 val;
-
-	ALT_SVPBMT(val, _PAGE_IO);
-	return val;
+	return _PAGE_IO_THEAD;
 }
 
 #define _PAGE_NOCACHE		riscv_page_nocache()
--- a/arch/riscv/include/asm/pgtable.h
+++ b/arch/riscv/include/asm/pgtable.h
@@ -164,7 +164,8 @@
 #define USER_PTRS_PER_PGD   (TASK_SIZE / PGDIR_SIZE)
 
 /* Page protection bits */
-#define _PAGE_BASE	(_PAGE_PRESENT | _PAGE_ACCESSED | _PAGE_USER)
+#define _PAGE_BASE	(_PAGE_PRESENT | _PAGE_ACCESSED | _PAGE_USER | \
+			 _PAGE_PMA_THEAD)
 
 #define PAGE_NONE		__pgprot(_PAGE_PROT_NONE | _PAGE_READ)
 #define PAGE_READ		__pgprot(_PAGE_BASE | _PAGE_READ)
@@ -185,7 +186,8 @@
 				| _PAGE_PRESENT \
 				| _PAGE_ACCESSED \
 				| _PAGE_DIRTY \
-				| _PAGE_GLOBAL)
+				| _PAGE_GLOBAL \
+				| _PAGE_PMA_THEAD)
 
 #define PAGE_KERNEL		__pgprot(_PAGE_KERNEL)
 #define PAGE_KERNEL_READ	__pgprot(_PAGE_KERNEL & ~_PAGE_WRITE)
