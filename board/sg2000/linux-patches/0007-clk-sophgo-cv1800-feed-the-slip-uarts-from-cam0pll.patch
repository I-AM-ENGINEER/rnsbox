From: RNSBox <rnsbox@localhost>
Subject: [PATCH] clk: sophgo: cv1800: feed the SLIP UARTs from the camera PLL

The SLIP UARTs inherit clk_cam0_200, which the bootloader leaves on the
25 MHz crystal (base_baud 1,562,500, so 2 Mbaud is impossible). Its mux
has only the crystal and disppll, and reparenting to disppll is not an
option: that PLL also carries the AXI/CPU fabric, and changing its rate
under a running system kills userspace (observed twice on the EVB).

UART1/UART2 get the independent camera PLL instead. cam0pll is unused on
a headless router, can synthesize 96 MHz, and then 2 Mbaud is exact
(96M/16/3). UART0 keeps clk_cam0_200 for the 115200 console.

--- a/drivers/clk/sophgo/clk-cv1800.c
+++ b/drivers/clk/sophgo/clk-cv1800.c
@@ -294,6 +294,17 @@
 	{ .hw = &clk_cam0_200.mux.common.hw },
 };
 
+/*
+ * The SLIP UARTs need a clock that can reach 2 Mbaud. clk_cam0_200 runs
+ * from the 25 MHz crystal (max 1.5625 Mbaud) and its mux has no other
+ * useful parent. Feed UART1/UART2 from the camera PLL instead: it is
+ * independent of disppll (which carries the AXI/CPU fabric) and unused
+ * on a headless router. UART0 stays on clk_cam0_200 for the console.
+ */
+static const struct clk_parent_data clk_uart_slip_parents[] = {
+	{ .hw = &clk_cam0pll.common.hw },
+};
+
 /* AHB ROM */
 static CV1800_GATE(clk_ahb_rom, clk_axi4_bus_parents,
 		   REG_CLK_EN_0, 6,
@@ -522,13 +533,13 @@
 static CV1800_GATE(clk_apb_uart0, clk_axi4_bus_parents,
 		   REG_CLK_EN_1, 15,
 		   CLK_IS_CRITICAL);
-static CV1800_GATE(clk_uart1, clk_uart_parents,
+static CV1800_GATE(clk_uart1, clk_uart_slip_parents,
 		   REG_CLK_EN_1, 16,
 		   0);
 static CV1800_GATE(clk_apb_uart1, clk_axi4_bus_parents,
 		   REG_CLK_EN_1, 17,
 		   0);
-static CV1800_GATE(clk_uart2, clk_uart_parents,
+static CV1800_GATE(clk_uart2, clk_uart_slip_parents,
 		   REG_CLK_EN_1, 18,
 		   0);
 static CV1800_GATE(clk_apb_uart2, clk_axi4_bus_parents,
