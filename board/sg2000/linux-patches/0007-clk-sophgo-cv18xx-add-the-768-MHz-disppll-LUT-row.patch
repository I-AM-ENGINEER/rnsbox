From: RNSBox <rnsbox@localhost>
Subject: [PATCH] clk: sophgo: cv18xx: add the vendor 768 MHz disppll row

The generic fractional-PLL synthesis picks a divider/mode combination
the SG2000 cannot lock at 768 MHz: assigning that rate in of_clk_init()
hung the Duo Module 01 EVB before the console registered. The vendor
driver carries a LUT and the board only works with its row:

    .rate = 768000000, .csr = 0x00108101, .ssc_set = 419430400

Use those values verbatim when the 25 MHz crystal asks for 768 MHz.
clk_cam0_200 can then take disppll/8 = 96 MHz, which makes the modem's
2 Mbaud SLIP rate exact (96M/16/3) and keeps the 115200 console at
divisor 52 (+0.16%).

--- a/drivers/clk/sophgo/clk-cv18xx-pll.c
+++ b/drivers/clk/sophgo/clk-cv18xx-pll.c
@@ -245,6 +245,14 @@
 			      syn_set, clk_full);
 }
 
+/*
+ * The vendor LUT row for 768 MHz. The generic synthesis formula picks a
+ * divider/mode combination this PLL cannot lock on the SG2000 (the EVB
+ * hung before the console came up), so use the vendor values verbatim.
+ */
+#define CV1800_DISPPLL_768M_CSR		0x00108101U
+#define CV1800_DISPPLL_768M_SSC		419430400U
+
 static unsigned long fpll_find_synthesizer(unsigned long parent,
 					   unsigned long rate,
 					   unsigned long pre_div,
@@ -294,6 +302,13 @@
 	bool clk_full = cv1800_clk_checkbit(&pll->common,
 					       &pll->pll_syn->clk_half);
 
+	if (trate == 768000000UL && prate == 25000000UL) {
+		*value = CV1800_DISPPLL_768M_CSR;
+		*ssc_syn_set = CV1800_DISPPLL_768M_SSC;
+		*rate = 768000000UL;
+		return 0;
+	}
+
 	for_each_pll_limit_range(pre, &limit->pre_div) {
 		for_each_pll_limit_range(post, &limit->post_div) {
 			for_each_pll_limit_range(div, &limit->div) {
@@ -360,11 +375,16 @@
 	if (!fpll_is_factional_mode(pll))
 		return ipll_set_rate(hw, rate, parent_rate);
 
-	fpll_find_rate(pll, &pll->pll_limit[2], parent_rate,
-		       &rate, &detected, &detected_ssc);
-	pll_get_mode_ctrl(PLL_GET_DIV_SEL(detected),
-			  fpll_check_mode_ctrl_restrict,
-			  pll->pll_limit, &detected);
+	if (rate == 768000000UL && parent_rate == 25000000UL) {
+		detected = CV1800_DISPPLL_768M_CSR;
+		detected_ssc = CV1800_DISPPLL_768M_SSC;
+	} else {
+		fpll_find_rate(pll, &pll->pll_limit[2], parent_rate,
+			       &rate, &detected, &detected_ssc);
+		pll_get_mode_ctrl(PLL_GET_DIV_SEL(detected),
+				  fpll_check_mode_ctrl_restrict,
+				  pll->pll_limit, &detected);
+	}
 
 	spin_lock_irqsave(pll->common.lock, flags);
 
