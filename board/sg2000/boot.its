/*
 * RNSBox boot.sd FIT for the vendor u-boot (sg2000-duomodule01
 * flow blobs, see README.fip.md). Packed by post-image.sh with cwd =
 * BINARIES_DIR (the /incbin/ paths are relative to it).
 *
 * - config name follows the older vendor u-boot env (older sg2000 fip
 *   generations run `bootm ${uImage_addr}#config-sg2000_duomodule01_sd`);
 *   the current flow u-boot (patch 0034, plain `bootm`) boots the FIT's
 *   DEFAULT configuration — which is this one, so the same boot.sd boots
 *   under both u-boot generations.
 * - load/entry 0x80200000: riscv needs a 2MB-aligned load
 *   address; 0x80200000 is clear of the OpenSBI region (0x80000000..
 *   0x80080000, reserved in the DTS) and of the FAT-load buffer at
 *   0x81800000 (u-boot has already relocated itself to the top of RAM by
 *   bootm time).
 * - gzip: u-boot unpacks it (the vendor flow ships Image.gz the same
 *   way); the gzipped mini-config Image comfortably fits the 16M
 *   FAT-load buffer region.
 * - crc32 hashes: exactly what the vendor FIT uses (u-boot 2021.10
 *   cvitek).
 */
/dts-v1/;

/ {
	description = "RNSBox (sg2000 milkv-duo-module-01 EVB)";
	#address-cells = <2>;

	images {
		kernel-1 {
			description = "linux Image.gz";
			data = /incbin/("./Image.gz");
			type = "kernel";
			arch = "riscv";
			os = "linux";
			compression = "gzip";
			load = <0x0 0x80200000>;
			entry = <0x0 0x80200000>;
			hash-1 {
				algo = "crc32";
			};
		};

		fdt-sg2000_duomodule01_sd {
			description = "sg2000-milkv-duomodule01-evb device tree";
			data = /incbin/("./sg2000-duomodule01-evb.dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			hash-1 {
				algo = "crc32";
			};
		};
	};

	configurations {
		default = "config-sg2000_duomodule01_sd";
		config-sg2000_duomodule01_sd {
			description = "RNSBox sg2000 (vendor u-boot name)";
			kernel = "kernel-1";
			fdt = "fdt-sg2000_duomodule01_sd";
		};
	};
};
