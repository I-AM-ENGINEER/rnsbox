# RNSBox kernel additions on top of the arm64 defconfig for the Milk-V Duo S
# (Sophgo SG2000, Cortex-A53).  The arm64 defconfig already enables
# ARCH_SOPHGO, the SG2000 pinctrl/clock drivers, DWCMSHC MMC and DWC2; this
# fragment adds the router data plane and the board's peripherals.

# --- Ethernet: internal EPHY via the Sophgo DWMAC glue ---
CONFIG_DWMAC_SOPHGO=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_GENERIC=y
CONFIG_PHYLIB=y

# --- USB: DWC2 peripheral + CDC-NCM/mass-storage gadget on the USB-C port ---
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_PHY_SOPHGO_CV1800_USB2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y

# --- nftables data plane (S60routing; ruleset validated by nft -c) ---
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_FIB_INET=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y

# --- one bridged LAN (br-lan): USB NCM + WiFi hotspot share a subnet ---
CONFIG_BRIDGE=y
CONFIG_BRIDGE_IGMP_SNOOPING=y

# --- SLIP over UART for the optional HaLow modem link ---
CONFIG_SLIP=y
CONFIG_SLIP_COMPRESSED=y
CONFIG_SLIP_SMART=y

# --- RNode / USB serial modems ---
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y

# --- throughput: BBR + fq ---
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y

# --- misc router bits ---
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_INET_DIAG=y

# --- 256/512 MB parts: zram swap (S05zram) ---
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=m
CONFIG_ZRAM_DEF_COMP_LZORLE=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_LZORLE=y

# --- watchdog + optional DS3231 RTC ---
CONFIG_WATCHDOG=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_DS1307=y

# --- rootfs essentials ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TMPFS=y
CONFIG_IPV6=y
