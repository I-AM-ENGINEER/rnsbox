/*
 * RNSBox mainline boot.sd FIT for the Milk-V Duo S (SG2000, C906).
 * Same scheme as board/sg2000-mainline/boot.its: the vendor u-boot boots
 * the FIT's default configuration (older generations append
 * #config-sg2000_duo_sd), Image.gz is gunzipped to 0x80200000.
 *
 * Built by configs/rnsbox_duo_s_mainline_defconfig; the mainline
 * v7.3-rc7 tree already ships sg2000-milkv-duo-s.dts and
 * linux-patches/0001-* enables its gmac0 + mdio nodes (internal EPHY).
 */
/dts-v1/;

/ {
	description = "RNSBox mainline (sg2000 milkv-duo-s)";
	#address-cells = <2>;

	images {
		kernel-1 {
			description = "mainline linux Image.gz";
			data = /incbin/("./Image.gz");
			type = "kernel";
			arch = "riscv";
			os = "linux";
			compression = "gzip";
			load = <0x0 0x80200000>;
			entry = <0x0 0x80200000>;
			hash-1 {
				algo = "crc32";
			};
		};

		fdt-sg2000_duo_sd {
			description = "mainline sg2000-milkv-duo-s device tree";
			data = /incbin/("./sg2000-milkv-duo-s.dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			hash-1 {
				algo = "crc32";
			};
		};
	};

	configurations {
		default = "config-sg2000_duo_sd";
		config-sg2000_duo_sd {
			description = "RNSBox mainline sg2000 (vendor u-boot name)";
			kernel = "kernel-1";
			fdt = "fdt-sg2000_duo_sd";
		};
	};
};
