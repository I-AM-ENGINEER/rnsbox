#!/bin/sh
# S60routing — kernel routing knobs + regenerate nftables.conf and the
# per-LAN dnsmasq scope, then apply.
#
# Runs after S30gadget_nic (usb0), S30eth (eth0 lease) and S35wifi (so an
# AP iface, if any, already exists and can be folded into the LAN side).
# Re-runnable as `restart` whenever the portal edits the rnsbox configs.
#
# nftables ruleset comes from `python3 -m rnsbox_portal.nftgen` (single
# source of truth shared with the Flask UI). Pre-validate with `nft -c -f`
# (validate-before-swap discipline) before atomically swapping the live config so a bad
# generated rule can't lock us out.

WAN_CONF=/etc/rnsbox/wan.conf
NFT_FILE=/etc/nftables.conf
DNSMASQ_FILE=/etc/dnsmasq.conf
NFTGEN="/usr/sbin/rnsbox-portal nftgen"

USB0_LAN_IP=10.42.0.1
USB0_LAN_DHCP_START=10.42.0.10
USB0_LAN_DHCP_END=10.42.0.20
AUTOGEN_DNSMASQ="# --- AUTOGEN MARKER --- per-LAN scopes appended at boot below ---"

# RNSBox W variant: S35wifi writes the AP iface name to /run/wifi-ap-iface
# when a hotspot is up. Fold it into the LAN side so it gets NAT + a DHCP
# scope automatically. WiFi subnet read from /etc/rnsbox/wifi.conf.
WIFI_CONF=/etc/rnsbox/wifi.conf
wifi_cfg() {
	grep -E "^[[:space:]]*$1[[:space:]]*=" "$WIFI_CONF" 2>/dev/null | tail -1 \
	  | sed -E "s/^[^=]*=[[:space:]]*//" | sed -E 's/[[:space:]]*#.*$//' \
	  | sed -E 's/[[:space:]]*$//'
}

read_wan() {
	# wan.conf is now key=value (interface=eth0). Prefer the interface= key;
	# fall back to a legacy bare "eth0"/"wlan0" line if no key is present.
	WAN=$(grep -E '^[[:space:]]*interface[[:space:]]*=' "$WAN_CONF" 2>/dev/null \
	  | tail -1 | sed -E 's/^[^=]*=[[:space:]]*//' | sed -E 's/[[:space:]]*#.*$//' \
	  | tr -d '[:space:]')
	[ -z "$WAN" ] && WAN=$(grep -vE '^[[:space:]]*#|^[[:space:]]*$|=' "$WAN_CONF" 2>/dev/null | head -1 | tr -d '[:space:]')
	case "$WAN" in eth0|wlan0) ;; *) WAN=wlan0 ;; esac
}

read_lan() {
	LAN_IFACES="usb0"
	AP_IF=""
	if [ -r /run/wifi-ap-iface ]; then
		AP_IF=$(cat /run/wifi-ap-iface 2>/dev/null | tr -d '[:space:]')
		[ -n "$AP_IF" ] && [ -e "/sys/class/net/$AP_IF" ] && LAN_IFACES="usb0,$AP_IF"
	fi
}

regen_nftables() {
	TMP=$(mktemp /tmp/nftables.conf.XXXXXX) || return 1
	if ! $NFTGEN --wan "$WAN" --lan "$LAN_IFACES" > "$TMP" 2>/var/log/nftgen.err; then
		echo "S60routing: nftgen failed (see /var/log/nftgen.err); keeping previous $NFT_FILE"
		rm -f "$TMP"
		return 1
	fi
	if ! nft -c -f "$TMP" >>/var/log/nftgen.err 2>&1; then
		echo "S60routing: generated ruleset failed nft -c validation; keeping previous $NFT_FILE"
		rm -f "$TMP"
		return 1
	fi
	mv "$TMP" "$NFT_FILE"
	chmod 0644 "$NFT_FILE"
}

regen_dnsmasq() {
	if grep -q "$AUTOGEN_DNSMASQ" "$DNSMASQ_FILE" 2>/dev/null; then
		sed -i "/$AUTOGEN_DNSMASQ/q" "$DNSMASQ_FILE"
	fi
	{
		echo
		echo "# WAN=$WAN (DHCP not served here — eth0 receives a lease, doesn't serve one)"
		echo "no-dhcp-interface=$WAN"
		echo
		echo "# usb0 LAN"
		echo "interface=usb0"
		echo "dhcp-range=set:usb0,$USB0_LAN_DHCP_START,$USB0_LAN_DHCP_END,255.255.255.0,12h"
		echo "dhcp-option=tag:usb0,3,$USB0_LAN_IP"
		echo "dhcp-option=tag:usb0,6,$USB0_LAN_IP"
		# RNSBox W variant: AP hotspot scope (only when S35wifi has an AP up).
		if [ -n "$AP_IF" ] && [ -e "/sys/class/net/$AP_IF" ]; then
			AP_IP=$(wifi_cfg ap_ip); [ -z "$AP_IP" ] && AP_IP=192.168.42.1
			AP_DS=$(wifi_cfg ap_dhcp_start); [ -z "$AP_DS" ] && AP_DS=192.168.42.10
			AP_DE=$(wifi_cfg ap_dhcp_end); [ -z "$AP_DE" ] && AP_DE=192.168.42.100
			echo
			echo "# $AP_IF WiFi AP LAN"
			echo "interface=$AP_IF"
			echo "dhcp-range=set:$AP_IF,$AP_DS,$AP_DE,255.255.255.0,12h"
			echo "dhcp-option=tag:$AP_IF,3,$AP_IP"
			echo "dhcp-option=tag:$AP_IF,6,$AP_IP"
		fi
	} >> "$DNSMASQ_FILE"
}

start() {
	read_wan
	read_lan
	echo "S60routing: WAN=$WAN LAN=$LAN_IFACES"

	# --- routing knobs ---
	echo 1 > /proc/sys/net/ipv4/ip_forward
	echo 0 > /proc/sys/net/ipv4/conf/all/rp_filter
	echo 0 > /proc/sys/net/ipv4/conf/default/rp_filter
	echo 0 > /proc/sys/net/ipv4/conf/all/accept_redirects
	echo 0 > /proc/sys/net/ipv6/conf/all/forwarding 2>/dev/null || true
	# route_localnet on the WAN iface: lets a port forward whose target is a
	# loopback address (127.0.0.0/8 — e.g. a service that binds only to
	# 127.0.0.1) actually be delivered. Without it, a packet DNAT'd to 127.x
	# arriving on a real iface is dropped as a martian before INPUT. Forwards
	# to the box's real LAN IP (10.42.0.1) don't need this; loopback ones do.
	# Safe: INPUT's drop policy + the "ct status dnat" gate mean only flows
	# our own prerouting DNAT created can reach a local service this way.
	echo 1 > "/proc/sys/net/ipv4/conf/$WAN/route_localnet" 2>/dev/null || true

	# --- throughput tuning ---
	for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
		[ -w "$g" ] && echo performance > "$g" 2>/dev/null
	done
	echo 4194304 > /proc/sys/net/core/rmem_max
	echo 4194304 > /proc/sys/net/core/wmem_max
	echo 1048576 > /proc/sys/net/core/rmem_default
	echo 1048576 > /proc/sys/net/core/wmem_default
	echo "4096 1048576 4194304" > /proc/sys/net/ipv4/tcp_rmem
	echo "4096 524288 4194304"  > /proc/sys/net/ipv4/tcp_wmem
	echo 4000 > /proc/sys/net/core/netdev_max_backlog
	echo 600 > /proc/sys/net/core/netdev_budget 2>/dev/null
	echo 8000 > /proc/sys/net/core/netdev_budget_usecs 2>/dev/null
	echo 0 > /proc/sys/net/ipv4/tcp_slow_start_after_idle 2>/dev/null
	echo 15 > /proc/sys/net/ipv4/tcp_fin_timeout 2>/dev/null
	echo 1 > /proc/sys/net/ipv4/tcp_tw_reuse 2>/dev/null
	echo 3 > /proc/sys/net/ipv4/tcp_fastopen 2>/dev/null
	if grep -qw bbr /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null; then
		echo bbr > /proc/sys/net/ipv4/tcp_congestion_control
	fi
	[ -d /sys/module/sch_fq ] || modprobe sch_fq 2>/dev/null
	echo fq > /proc/sys/net/core/default_qdisc 2>/dev/null

	# --- regenerate + apply ---
	regen_dnsmasq
	regen_nftables

	nft flush ruleset 2>/dev/null
	if [ -r "$NFT_FILE" ]; then
		nft -f "$NFT_FILE"
	fi

	if [ -x /etc/init.d/S80dnsmasq ]; then
		/etc/init.d/S80dnsmasq restart >/dev/null 2>&1 || true
	elif pidof dnsmasq >/dev/null 2>&1; then
		killall -HUP dnsmasq 2>/dev/null || true
	fi
}

stop() {
	nft flush ruleset 2>/dev/null || true
	echo 0 > /proc/sys/net/ipv4/ip_forward
}

case "${1:-start}" in
	start)   start ;;
	stop)    stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
