#!/bin/sh
# S84cron — regenerate the root crontab from /etc/rnsbox/cron.conf and start
# busybox crond. Runs after S82rnsd (so rnsd is up before any restart job).
#
# Why regenerate at boot: busybox crond reads /var/spool/cron/crontabs/root,
# and /var/spool -> /tmp is tmpfs (wiped each boot). The persistent source of
# truth is /etc/rnsbox/cron.conf; this script materializes it into the spool.
#
# Currently the only scheduled task is the optional rnsd auto-restart
# (memory hygiene): rnsd_restart_days=N restarts rnsd every N days at 04:00.
# N=0 (default) means no crontab entry — crond still runs but has nothing to do.

CONF=/etc/rnsbox/cron.conf
CRONDIR=/var/spool/cron/crontabs
CRONTAB="$CRONDIR/root"
LOG=/var/log/cron.log

cfg() {
	grep -E "^[[:space:]]*$1[[:space:]]*=" "$CONF" 2>/dev/null | tail -1 \
	  | sed -E "s/^[^=]*=[[:space:]]*//" | sed -E 's/[[:space:]]*#.*$//' \
	  | sed -E 's/[[:space:]]*$//'
}

gen_crontab() {
	mkdir -p "$CRONDIR"
	days=$(cfg rnsd_restart_days)
	case "$days" in ''|*[!0-9]*) days=0 ;; esac
	uc=$(cfg update_check)
	case "$uc" in no|No|NO|0|false|off) uc=no ;; *) uc=yes ;; esac
	{
		echo "# Auto-generated by S84cron from $CONF — do not hand-edit."
		echo "# (edit /etc/rnsbox/cron.conf or use the portal Reticulum tab)"
		if [ "$days" -ge 1 ] 2>/dev/null && [ "$days" -le 7 ]; then
			# min hour day-of-month month day-of-week  command
			# every N days at 04:00
			echo "0 4 */$days * * /etc/init.d/S82rnsd restart >> $LOG 2>&1"
		fi
		if [ "$uc" = yes ]; then
			# daily at 05:00: notify-only check for a newer rnsd (offline-safe)
			echo "0 5 * * * /usr/sbin/rnsbox-update-check >> $LOG 2>&1"
		fi
	} > "$CRONTAB"
	chmod 600 "$CRONTAB"
	[ "$days" -ge 1 ] 2>/dev/null && echo "S84cron: rnsd auto-restart every $days day(s) at 04:00" \
	                              || echo "S84cron: rnsd auto-restart disabled"
	[ "$uc" = yes ] && echo "S84cron: daily rnsd update check enabled" \
	                || echo "S84cron: rnsd update check disabled"
}

start() {
	gen_crontab
	# -b = background; -c = crontab dir (parent of crontabs/). Start only if
	# not already running.
	if ! pidof crond >/dev/null 2>&1; then
		crond -b -c "$CRONDIR" 2>>"$LOG"
	fi
	# Best-effort update check shortly after boot (once the clock is synced and
	# WAN may be up). Backgrounded so it never blocks boot; quiet when offline.
	# ($uc was set by gen_crontab above.)
	if [ "$uc" = yes ]; then
		( sleep 30; [ -f /run/clock-synced ] && /usr/sbin/rnsbox-update-check ) >>"$LOG" 2>&1 &
	fi
}

stop() {
	killall crond 2>/dev/null
}

# `reload` = regenerate the crontab and signal crond to re-read, without a full
# restart. The portal calls this after changing the schedule.
reload() {
	gen_crontab
	if pidof crond >/dev/null 2>&1; then
		# busybox crond re-reads when the crontab mtime changes; gen_crontab
		# rewrote it, so a HUP or just leaving it is enough. HUP to be prompt.
		killall -HUP crond 2>/dev/null || true
	else
		crond -b -c "$CRONDIR" 2>>"$LOG"
	fi
}

case "${1:-start}" in
	start)   start ;;
	stop)    stop ;;
	restart) stop; sleep 1; start ;;
	reload)  reload ;;
	*) echo "Usage: $0 {start|stop|restart|reload}" >&2; exit 1 ;;
esac
