image boot.vfat {
	vfat {
		files = {
#BOOT_FILES#
		}
	}

	# image-size: sized to the payload (Image ~24M + firmware blobs ~9M +
	# dtbs/overlays ~4M + usb.* flags), not to the card — /boot is a fixed
	# FAT that nothing grows at runtime, so keep ~8M of slack for a future
	# gadget flag files. 48M (was 128M).
	size = 48M
}

# Plain single-rootfs layout (same shape as every other RNSBox board):
#   p1 boot (FAT, 48M)   : firmware + kernel + DTBs + usb.* gadget flags
#   p2 rootfs (ext4)     : the rootfs image itself; S02resizefs grows p2 to
#                          fill the card on first boot
# The A/B dual-slot layout is disabled for now; the two-slot template lives
# in git history next to the initramfs staging in post-image.sh.
image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.ext4"
	}
}
