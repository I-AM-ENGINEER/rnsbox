/dts-v1/;

#include "mt7628a.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "morse,ekh03v3", "ralink,mt7628a-soc";
	model = "HT-HD01 HaLow Dongle V2";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
		stdout-path = &uart0;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x8000000>;
	};

	mmc_clock: mmc-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <48000000>;
	};

	mmc_power: regulator-mmc-power {
		compatible = "regulator-fixed";
		regulator-name = "mmc_power";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	mmc_io: regulator-mmc-io {
		compatible = "regulator-fixed";
		regulator-name = "mmc_io";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	leds {
		compatible = "gpio-leds";

		status {
			label = "fuchsia:status";
			gpios = <&gpio 44 GPIO_ACTIVE_LOW>;
		};
	};

	/*
	 * MT7628 has no switch driver.  The built-in 5-port switch
	 * is left in the flat, VLAN-disabled state U-Boot programs
	 * (0x98 = 0x7f7f) and the frame engine sees it as one MAC.  The esw
	 * node documents the port map; no driver binds to it.
	 */
	ethernet@10100000 {
		compatible = "ralink,rt5350-eth";
		reg = <0x10100000 0x10000>;
		#address-cells = <1>;
		#size-cells = <0>;
		interrupt-parent = <&cpuintc>;
		interrupts = <5>;
		resets = <&sysc 21>, <&sysc 23>;
		reset-names = "fe", "esw";
		mediatek,switch = <&esw>;

		mac@0 {
			compatible = "mediatek,eth-mac";
			reg = <0>;
			phy-mode = "mii";
			nvmem-cells = <&macaddr_factory_28>;
			nvmem-cell-names = "mac-address";

			fixed-link {
				speed = <100>;
				full-duplex;
			};
		};
	};

	esw: esw@10110000 {
		compatible = "mediatek,mt7628-esw", "ralink,rt3050-esw";
		reg = <0x10110000 0x8000>;
		interrupt-parent = <&intc>;
		interrupts = <17>;
		mediatek,portmap = <0x7>;
		mediatek,portdisable = <0x3a>;
	};

	mmc@10130000 {
		compatible = "mediatek,mt7620-mmc";
		status = "okay";
		reg = <0x10130000 0x4000>;
		#address-cells = <1>;
		#size-cells = <0>;
		interrupt-parent = <&intc>;
		interrupts = <14>;
		clocks = <&mmc_clock>, <&mmc_clock>;
		clock-names = "source", "hclk";
		pinctrl-names = "default", "state_uhs";
		pinctrl-0 = <&pinmux_sdmode_sdxc>;
		pinctrl-1 = <&pinmux_sdmode_sdxc>;
		bus-width = <4>;
		max-frequency = <48000000>;
		cap-sd-highspeed;
		cap-mmc-highspeed;
		cap-sdio-irq;
		non-removable;
		disable-wp;
		vmmc-supply = <&mmc_power>;
		/* The vendor DTS feeds both rails from the same 3.3 V
		 * regulator; the MM6108 does not come up with 1.8 V I/O. */
		vqmmc-supply = <&mmc_power>;

		mm6108_sdio@0 {
			compatible = "morse,mm610x";
			reg = <2>;
			bus-width = <4>;
			reset-gpios = <&gpio 40 GPIO_ACTIVE_HIGH>;
			power-gpios = <&gpio 41 GPIO_ACTIVE_HIGH>,
				      <&gpio 39 GPIO_ACTIVE_HIGH>;
			status = "okay";
		};
	};
};

&spi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <40000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x30000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x30000 0x10000>;
			};

			factory: partition@40000 {
				label = "factory";
				reg = <0x40000 0x10000>;
				read-only;
				compatible = "nvmem-cells";
				#address-cells = <1>;
				#size-cells = <1>;

				macaddr_factory_28: macaddr@28 {
					reg = <0x28 0x06>;
				};
			};

			partition@50000 {
				label = "kernel";
				reg = <0x50000 0x400000>;
			};

			partition@450000 {
				label = "rootfs";
				reg = <0x450000 0x1600000>;
			};

			partition@1a50000 {
				label = "overlay";
				reg = <0x1a50000 0x5b0000>;
			};
		};
	};
};

&wmac {
	status = "okay";
	mediatek,mtd-eeprom = <&factory 0x0>;
};
