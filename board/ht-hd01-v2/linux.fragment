# HT-HD01-V2 (MT7628AN) core kernel fragment.
# Applied on top of Buildroot's upstream vocore2_defconfig; last wins.

CONFIG_SOC_MT7620=y

# Board DTB: this symbol is added by the external.mk post-patch hook.
# The vocore2 defconfig's own built-in DTB must go away.
# CONFIG_DTB_VOCORE2 is not set
CONFIG_DTB_EKH03V3=y
CONFIG_BUILTIN_DTB=y

CONFIG_CPU_MIPS32_R2=y
CONFIG_MIPS_CMDLINE_FROM_BOOTLOADER=y
CONFIG_HZ_100=y

# Keep the image small; modules are used for the out-of-tree HaLow driver.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# Uncompressed modules: Buildroot's host depmod has no xz support, so with
# CONFIG_MODULE_COMPRESS_XZ modules.dep comes out empty and modprobe cannot
# load morse/dot11ah at all.  The two modules are ~230 KB together.
# CONFIG_MODULE_COMPRESS is not set
# Kernel compression is chosen with BR2_LINUX_KERNEL_LZMA in the board
# config: the stock Ralink U-Boot 1.1.3 has gzip and xz disabled and can only
# unpack an LZMA uImage.
CONFIG_RD_ZSTD=y
CONFIG_RD_XZ=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# Debug/instrumentation off.
# CONFIG_DEBUG_INFO is not set
# CONFIG_KALLSYMS is not set
# CONFIG_IKCONFIG is not set
# CONFIG_FTRACE is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_KPROBES is not set
# CONFIG_COREDUMP is not set
# CONFIG_ELF_CORE is not set
# CONFIG_SWAP is not set
# CONFIG_MAGIC_SYSRQ is not set

# Unused buses/subsystems.
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_BT is not set
# CONFIG_WIRELESS_EXT is not set
# CONFIG_CFG80211_WEXT is not set
# CONFIG_USB is not set

# Ethernet: MT7628 frame engine + flat built-in switch (no switch driver).
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_MEDIATEK=y
CONFIG_NET_MEDIATEK_SOC=y
CONFIG_PHYLIB=y

# SDIO / MMC for the MM6108 HaLow module.
CONFIG_MMC=y
CONFIG_MMC_MTK=y
CONFIG_MMC_BLOCK=y

# SPI NOR + MTD.  NVMEM lets the eth-mac node read the factory macaddr@28
# cell; without it mtk_eth_soc falls back to a random MAC.
CONFIG_NVMEM=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_SPI_NOR=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_MT7621=y

# MT7628 integrated 2.4 GHz WMAC (mt76 mt7603e).
CONFIG_WLAN=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MT7603E=y
CONFIG_RFKILL=y

# MT7603E's Kconfig still depends on PCI even for the SoC WMAC.
CONFIG_PCI=y

# GPIO/pinctrl/clock/reset.
CONFIG_GPIO_MT7621=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SINGLE=y
CONFIG_CLK_MTMIPS=y
CONFIG_RESET_CONTROLLER=y

# Serial console.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y

# Watchdog.
CONFIG_WATCHDOG=y
CONFIG_MT7621_WDT=y

# Firmware loader for mt7628_e1/e2 and the Morse blobs.
CONFIG_FW_LOADER=y
CONFIG_MMC_SPI=y

# External initrd/initramfs support. Needed to TFTP-boot a rootfs image into
# RAM for testing or recovery; unused when booting from flash.
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_RAM=y
CONFIG_BLK_DEV_RAM_SIZE=32768

# Filesystems: squashfs + jffs2 overlay for production, initramfs for now.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_JFFS2_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# Firewall: nftables is what rnsbox-portal nftgen emits.
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_NAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_BRIDGE=y
# Vendor switch setup tags the CPU port (VLAN 1: 0 2 6t), so Linux needs
# 802.1Q to put the LAN address on eth0.1.
CONFIG_VLAN_8021Q=y
# CONFIG_NETFILTER_XTABLES is not set

# Morse LED support uses the LED class.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
