#!/bin/sh
# AIC8800: the WiFi (fdrv) and BSP modules ship with debug levels wide open
# (aicwf_dbg_level=1039, aicwf_dbg_level_bsp) and flood the kernel log —
# AICWFDBG/AICBT lines per SDIO frame, fast enough at BLE throughput to
# rotate /var/log/messages every ~30 s. S35wifi loads the modules; silence
# them after that. The modprobe.d options apply the same values when the
# modules load on later boots.
case "$1" in
	start|reload)
		for p in /sys/module/aic8800_fdrv/parameters/aicwf_dbg_level \
		         /sys/module/aic8800_bsp/parameters/aicwf_dbg_level_bsp; do
			if [ -w "$p" ]; then echo 0 > "$p"; fi
		done
		;;
esac
