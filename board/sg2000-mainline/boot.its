/*
 * RNSBox mainline boot.sd FIT for the vendor u-boot (sg2000-duomodule01 flow
 * blobs, see README.fip.md). Packed by post-image.sh with cwd = BINARIES_DIR
 * (the /incbin/ paths are relative to it).
 *
 * - the vendor sg2000 u-boot ends its sdboot env with a BARE
 *   `bootm ${uImage_addr}` (no #config suffix; CVICHIP is not defined in
 *   this SDK build), so u-boot 2021.10 without CONFIG_MULTI_DTB_FIT
 *   resolves the configuration only through the `default` property of
 *   /configurations — it MUST be present (same lesson as the cv1800b
 *   flow; see main commits f278299 + 5e9c52c).
 * - load/entry 0x80200000: mainline riscv needs a 2MB-aligned load
 *   address; 0x80200000 is clear of the OpenSBI region
 *   (0x80000000..0x80080000, reserved in the DTS) and of the FIT-load
 *   buffer at 0x81800000 (u-boot fatloads boot.sd there and has already
 *   relocated itself to the top of RAM by bootm time).
 * - gzip: u-boot unpacks it (the vendor flow ships Image.gz the same
 *   way); the gzipped mini-config Image comfortably fits the 16 MB
 *   UIMAG fatload buffer.
 * - crc32 hashes: exactly what the vendor FIT uses (u-boot 2021.10 cvitek).
 */
/dts-v1/;

/ {
	description = "RNSBox mainline (sg2000 duomodule01)";
	#address-cells = <2>;

	images {
		kernel-1 {
			description = "mainline linux Image.gz";
			data = /incbin/("./Image.gz");
			type = "kernel";
			arch = "riscv";
			os = "linux";
			compression = "gzip";
			load = <0x0 0x80200000>;
			entry = <0x0 0x80200000>;
			hash-1 {
				algo = "crc32";
			};
		};

		fdt-sg2000_duomodule01_sd {
			description = "mainline sg2000-duomodule01-evb device tree";
			data = /incbin/("./sg2000-duomodule01-evb.dtb");
			type = "flat_dt";
			arch = "riscv";
			compression = "none";
			hash-1 {
				algo = "crc32";
			};
		};
	};

	configurations {
		default = "config-sg2000_duomodule01_sd";
		config-sg2000_duomodule01_sd {
			description = "RNSBox mainline sg2000 (vendor u-boot name)";
			kernel = "kernel-1";
			fdt = "fdt-sg2000_duomodule01_sd";
		};
	};
};
