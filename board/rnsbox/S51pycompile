#!/bin/sh
# S51pycompile -- rebuild the python bytecode cache in the background.
#
# The rootfs ships .py-only python (image-size: the .pyc tree duplicates the
# .py sources nearly byte-for-byte, ~60 MB of dead weight in the factory
# image). Without this script python would compile each module on first
# import, stalling the first rnsd start by tens of seconds. Instead: one
# niced background compileall pass on boot; it skips up-to-date files, so
# on every later boot it is a cheap no-op. Never blocks rcS; concurrent
# compiles (rnsd importing while this runs) are safe -- CPython writes .pyc
# atomically via tmp file + rename.
[ "$1" = start ] || exit 0

(
	for d in /usr/lib/python3.*; do
		nice -n 19 python3 -m compileall -q -j 0 "$d" 2>/dev/null
	done
) >/dev/null 2>&1 &
