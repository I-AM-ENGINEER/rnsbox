# RNSBox PC/VM kernel config — x86_64, BIOS boot, for QEMU / VirtualBox /
# VMware. Derived from buildroot's board/pc/linux.config (the
# pc_x86_64_bios_defconfig kernel), trimmed for a headless router appliance
# (no WiFi, no DRM, no sound, no USB storage) and extended with the RNSBox
# data plane (nftables, SLIP, bridge) and the VM device set (virtio,
# e1000/e1000e, AHCI, 8250 UARTs).
#
# USE_CUSTOM_CONFIG: this file IS the .config — every RNSBox-relevant symbol
# is explicit here; everything else takes Kconfig defaults (ACPI, VT, procfs,
# binfmt, ... all default on for x86_64).

# base
CONFIG_SYSVIPC=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_SMP=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PCI=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# console: VGA (+VESA framebuffer for VirtualBox/VMware graphical consoles)
# + 8250 UARTs. ttyS0 is the QEMU serial console (-nographic); ttyS1 is the
# SLIP test port (scripts/run-pc-vm.sh --slip-pty attaches a host pty).
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FIRMWARE_EDID=y
CONFIG_FB_VESA=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_INPUT=y
CONFIG_KEYBOARD_ATKBD=y

# block/storage: QEMU default IDE (-hda) and virtio-blk, VirtualBox/VMware
# SATA (AHCI). The image is one MBR disk: grub in the MBR + one ext4 root
# partition = /dev/sda1 everywhere.
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_BLK_DEV_LOOP=y

# network devices: virtio-net (QEMU default), e1000/e1000e (VirtualBox and
# VMware default NICs), 8139cp (-device rtl8139). Built-in, like the boards:
# the S-chain expects eth0/eth1 at boot, not after modprobe.
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_NET=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_8139CP=y
CONFIG_VIRTIO_PCI=y
CONFIG_HW_RANDOM_VIRTIO=y

# TCP/IP + IPv6: RNS AutoInterface runs over fe80:: on the LAN bridge.
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y

# nftables data plane (S60routing; ruleset validated by nft -c) — same set
# as the boards' linux.fragment, plus IPv6 table support (the shipped
# nftables.conf fallback carries an ip6 table; nft -f is all-or-nothing).
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_NAT=y

# SLIP over a UART for the HaLow-modem path (S31slip). In the VM the "modem"
# is a host pty peer on ttyS1 (run-pc-vm.sh --slip-pty); on real hardware it
# would be the RNode's UART.
CONFIG_SLIP=y
CONFIG_SLIP_COMPRESSED=y
CONFIG_SLIP_SMART=y

# one bridged LAN (br-lan): pc S30lan enslaves eth1, exactly as the boards'
# S30gadget_nic enslaves usb0 — every consumer of /run/lan-iface, dnsmasq,
# nftables and rnsd's AutoInterface behaves unchanged.
CONFIG_BRIDGE=y

# throughput: BBR + fq (as on the boards)
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y

# misc router bits
CONFIG_TUN=y
CONFIG_VETH=y

# VM conveniences
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y

# clock: QEMU exposes a CMOS RTC; read it at boot (S45ntpsync records the
# source, rnsd cares about monotonic-vs-wall time)
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y

# rootfs + init environment (fstab mounts tmpfs on /tmp, /run, /dev/shm)
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
