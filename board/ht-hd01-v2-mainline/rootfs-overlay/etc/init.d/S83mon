#!/bin/sh
# S83mon — one small C daemon for the three periodic jobs that used to be
# separate BusyBox shell loops:
#   * memory watchdog (restart rnsd above mem_threshold, S46memwatch)
#   * RAM/swap/zram/CPU sampler (S47memlog)
#   * rnstatus cache warm-up (S83rnsstatus)
#
# On a 64 MB target the three ash loops cost ~2.2 MB RSS just to exist; this
# daemon is ~200 KB. The log format is unchanged, and the config files
# (/etc/rnsbox/rnsdmon.conf, /etc/rnsbox/memlog.conf) still apply.
DAEMON=/usr/sbin/rnsbox-mon
PIDFILE=/run/rnsbox-mon.pid

running() {
	[ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null
}

case "$1" in
	start)
		printf "Starting rnsbox monitor: "
		if running; then
			echo "already running (pid $(cat "$PIDFILE"))"
			exit 0
		fi
		if [ ! -x "$DAEMON" ]; then
			echo "missing $DAEMON"
			exit 1
		fi
		rm -rf /run/rnsstatus.lock
		"$DAEMON" </dev/null >/dev/null 2>&1 &
		echo $! > "$PIDFILE"
		echo "OK (pid $!)"
		;;
	stop)
		printf "Stopping rnsbox monitor: "
		if running; then
			kill "$(cat "$PIDFILE")" 2>/dev/null
			rm -f "$PIDFILE"
		fi
		rm -rf /run/rnsstatus.lock
		echo "OK"
		;;
	restart|reload)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac
