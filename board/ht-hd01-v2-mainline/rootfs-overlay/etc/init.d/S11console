#!/bin/sh
# S11console — PTY broker behind the portal's Console and NomadNet tabs.
#
# One root-owned process keeps the admin shell (and NomadNet's TUI, started on
# first use) alive on their PTYs across page reloads, and serves raw terminal
# output to the authenticated CGI streams over a Unix socket. It listens on no
# network port; the browser still talks only to the portal on :80. The broker
# daemonizes itself and writes its pidfile.
PID=/run/rnsbox-console.pid
SOCK=/run/rnsbox-console.sock

# seed_admin_rpc_key — give the admin account rnsd's shared-instance RPC key.
#
# The NomadNet TUI runs as `admin` and attaches to rnsd's shared instance.
# RNS derives the RPC authkey from the transport identity in the RNS config
# directory; rnsd uses /etc/reticulum, while the admin TUI has its own
# ~/.reticulum, so without this its get_interface_stats() call aborts the TUI
# with AuthenticationError. rnsd (S82rnsd) starts after this script, so wait
# for its transport identity and patch the admin config in the background.
seed_admin_rpc_key() {
	i=0
	while [ ! -f /etc/reticulum/storage/transport_identity ] && [ "$i" -lt 120 ]; do
		sleep 1
		i=$((i + 1))
	done
	[ -f /etc/reticulum/storage/transport_identity ] || return 0

	key=$(sha256sum /etc/reticulum/storage/transport_identity 2>/dev/null | cut -d' ' -f1)
	[ -n "$key" ] || return 0

	dir=/home/admin/.reticulum
	cfg=$dir/config
	mkdir -p "$dir" || return 0
	if [ ! -f "$cfg" ]; then
		cp /etc/reticulum/config "$cfg" 2>/dev/null || return 0
	fi
	awk -v k="$key" '
		/^\[reticulum\]/ { print; print "  rpc_key = " k; next }
		/^[[:space:]]*rpc_key[[:space:]]*=/ { next }
		{ print }
	' "$cfg" > "$cfg.new" && mv "$cfg.new" "$cfg" || return 0
	chown -R admin:admin "$dir" 2>/dev/null || true
	chmod 0700 "$dir" 2>/dev/null || true
	chmod 0600 "$cfg" 2>/dev/null || true
}

start() {
	if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
		echo "S11console: broker already running (pid $(cat "$PID"))"
		return 0
	fi
	rm -f "$PID" "$SOCK"
	printf "Starting console broker: "
	/usr/sbin/rnsbox-portal console-broker
	( seed_admin_rpc_key ) >/dev/null 2>&1 &
	sleep 1
	if [ -S "$SOCK" ] && [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
		echo "OK (pid $(cat "$PID"))"
		return 0
	fi
	echo "FAIL"
	return 1
}

stop() {
	printf "Stopping console broker: "
	if [ -f "$PID" ]; then
		pid="$(cat "$PID")"
		kill "$pid" 2>/dev/null
		i=0
		while [ "$i" -lt 5 ] && kill -0 "$pid" 2>/dev/null; do
			sleep 1
			i=$((i + 1))
		done
		kill -9 "$pid" 2>/dev/null
	fi
	rm -f "$PID" "$SOCK"
	echo "OK"
}

case "${1:-start}" in
	start)   start ;;
	stop)    stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac
