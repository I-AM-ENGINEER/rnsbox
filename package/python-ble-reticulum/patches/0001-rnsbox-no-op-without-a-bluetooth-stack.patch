+    # ---- RNSBox: honest no-op without a Bluetooth stack -------------------
+    # Upstream start() assumes a working BlueZ adapter. On a router without
+    # one (no hci device, or no system D-Bus) the driver would sit in its
+    # scan loop logging an exception every discovery_interval, forever.
+    # Instead: probe the stack; when absent, log the reason once, leave the
+    # interface offline (rnsd runs, every other interface is unaffected) and
+    # re-probe in the background so a USB dongle plugged in later brings BLE
+    # up without a restart (the portal restart button works too). The probe
+    # is a sysfs listing + a socket existence check: no D-Bus traffic, so a
+    # no-op board pays nothing.
+    _RNSBOX_PROBE_INTERVAL = 30.0
+
+    @staticmethod
+    def _rnsbox_stack_reason():
+        """Return None when BLE can run, else a human-readable reason."""
+        try:
+            adapters = [n for n in os.listdir("/sys/class/bluetooth")
+                        if n.startswith("hci")]
+        except OSError:
+            return "no Bluetooth stack (/sys/class/bluetooth is missing)"
+        if not adapters:
+            return "no Bluetooth adapter (no hci device)"
+        if not os.path.exists("/run/dbus/system_bus_socket"):
+            return "no system D-Bus (/run/dbus/system_bus_socket is missing)"
+        return None
+
+    def _rnsbox_start_when_ready(self):
