+# --- Buildroot cross-build support -----------------------------------------
+# The upstream sdist has no way to cross-compile: the cmdclass below always
+# runs meson NATIVELY against the interpreter that runs setup.py (in a
+# buildroot setuptools build that is the HOST python, so the C extensions
+# would come out x86_64). Meson cannot help a cross build here either: it
+# would need to run the target interpreter for python introspection.
+#
+# When DBUS_PYTHON_SIMPLE_BUILD=1 is set (RNSBox's package/python-dbus.mk),
+# skip the meson wrapper entirely and build the two extensions with plain
+# setuptools build_ext, which under buildroot's PKG_PYTHON_ENV cross-builds
+# against the target python sysconfig (staging headers/libs, target CC).
+# The dbus/glib -I/-l flags and the vendored dbus-gmain C sources are wired
+# in below; DBUSPY_STAGING points at the buildroot staging sysroot.
+SIMPLE_BUILD = bool(os.environ.get('DBUS_PYTHON_SIMPLE_BUILD'))
 
 dbus_bindings = Extension('_dbus_bindings',
         sources=['dbus_bindings/module.c'])
 dbus_glib_bindings = Extension('_dbus_glib_bindings',
         sources=['dbus_glib_bindings/module.c'])
 
