+if SIMPLE_BUILD:
+    staging = os.environ.get('DBUSPY_STAGING', '')
+    incs = [
+        'include',                                   # dbus/dbus-python.h
+        'subprojects/dbus-gmain',                    # dbus-gmain/dbus-gmain.h
+        os.path.join(staging, 'usr/include/dbus-1.0'),
+        os.path.join(staging, 'usr/lib/dbus-1.0/include'),
+        os.path.join(staging, 'usr/include/glib-2.0'),
+        os.path.join(staging, 'usr/lib/glib-2.0/include'),
+    ]
+    dbus_bindings = Extension('_dbus_bindings',
+            sources=['dbus_bindings/module.c'],
+            include_dirs=incs,
+            libraries=['dbus-1'])
+    # meson builds dbus-gmain.c as a static lib for this extension; with
+    # plain setuptools just compile it in. Both TUs share the default
+    # DBUS_GMAIN_FUNCTION_NAME rename macro, so the symbols line up.
+    dbus_glib_bindings = Extension('_dbus_glib_bindings',
+            sources=['dbus_glib_bindings/module.c',
+                     'subprojects/dbus-gmain/dbus-gmain.c'],
+            include_dirs=incs,
+            libraries=['dbus-1', 'glib-2.0'])
+
+    setup(
+        name='dbus-python',
+        version=version,
+        packages=['dbus'],
+        ext_modules=[dbus_bindings, dbus_glib_bindings],
+    )
+else:
+    class Build(Distribution().get_command_class('build')):
+        """Dummy version of distutils build which runs an Autotools or Meson
+        build system instead.
+        """
+
+        def run(self):
+            srcdir = os.getcwd()
+            builddir = os.path.join(srcdir, self.build_temp)
+            os.makedirs(builddir, exist_ok=True)
+
+            subprocess.check_call(
+                [
+                    sys.executable,
+                    '-m', 'mesonbuild.mesonmain',
+                    'setup',
+                    '--prefix=' + os.path.join(builddir, 'prefix'),
+                    '-Ddoc=disabled',
+                    '-Dinstalled_tests=false',
+                    '-Dpython=' + sys.executable,
+                    '-Dpython.platlibdir=' + os.path.join(srcdir, self.build_lib),
+                    '-Dpython.purelibdir=' + os.path.join(srcdir, self.build_lib),
+                    '-Dtests=disabled',
+                    srcdir,
+                    builddir,
+                ]
+            )
+            subprocess.check_call(['meson', 'compile', '-C', builddir])
+            subprocess.check_call(['meson', 'install', '-C', builddir])
+
+    class BuildExt(Distribution().get_command_class('build_ext')):
+        def run(self):
+            pass
+
+    class BuildPy(Distribution().get_command_class('build_py')):
+        def run(self):
+            pass
+
+    setup(
+        name='dbus-python',
+        version=version,
+        packages=['dbus'],
+        ext_modules=[dbus_bindings, dbus_glib_bindings],
+        cmdclass={
+            'build': Build,
+            'build_py': BuildPy,
+            'build_ext': BuildExt,
+        },
+        setup_requires=['meson>=0.60.0', 'ninja', 'setuptools', 'wheel'],
+        tests_require=['tap.py'],
+    )
