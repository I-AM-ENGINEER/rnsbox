config BR2_PACKAGE_PYTHON_DBUS
	bool "python-dbus"
	depends on BR2_PACKAGE_DBUS      # libdbus-1 + the system bus daemon
	depends on BR2_PACKAGE_LIBGLIB2  # _dbus_glib_bindings (GLib main loop)
	help
	  D-Bus Python bindings (the upstream dbus-python project): the
	  `dbus` module plus the `_dbus_bindings` and `_dbus_glib_bindings`
	  C extensions (GLib main-loop integration lives in
	  dbus.mainloop.glib).

	  Needed by python-bluezero (BLE peripheral mode) and
	  ble-reticulum's pairing agent (BLEAgent). Not selectable on its
	  own from the RNSBox menu - it is pulled in by those.

	  http://www.freedesktop.org/wiki/Software/DBusBindings

comment "python-dbus needs dbus and libglib2"
	depends on !BR2_PACKAGE_DBUS || !BR2_PACKAGE_LIBGLIB2
