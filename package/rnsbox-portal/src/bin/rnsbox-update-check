#!/bin/sh
# rnsbox-update-check — thin launcher for the standalone update-check helper.
# Called by S84cron (daily at 05:00 + once per boot once the clock is trusted
# and a default route exists: `S84cron bootcheck`, triggered by S84cron start
# or S46wanwatch). The helper is stdlib-only Python (no Flask, no
# rnsbox_portal package); the C++ portal invokes the same script for the
# on-demand "Check for updates" / "Download" / "Install" buttons on the
# Reticulum tab. Arg defaults to "cron" (check, download the wheel and, if update_install=yes,
# install it; prints a human summary); the portal passes "check" / "download" /
# "install" (JSON output).
#
# No clock gate: rngit (Git over Reticulum) verifies signatures, not dates, so
# checks work on a box that booted at 1970. updatecheck.py skips only the
# HTTPS/PyPI fallback when the clock is untrusted.
exec python3 /usr/lib/rnsbox/updatecheck.py "${1:-cron}"
