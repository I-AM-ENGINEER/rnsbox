# ------------------------------------------------------------------ apply ---

def sha256_file(path, progress=None):
    h = hashlib.sha256()
    n = 0
    with open(path, "rb") as f:
        while True:
            chunk = f.read(1024 * 1024)
            if not chunk:
                break
            h.update(chunk)
            n += len(chunk)
            if progress and n % (32 * 1024 * 1024) < 1024 * 1024:
                progress("hashed %d MB" % (n // (1024 * 1024)))
    return h.hexdigest()


def write_idle_slot(img_path, idle_dev, part_off, part_size, st):
    """Stream one partition out of the .img.xz onto the idle slot device.

    Two subprocess pipeline (xz | dd): the first part_off decompressed bytes
    are read and discarded, then exactly part_size bytes are piped into dd.
    Exact byte accounting: a short stream (corrupt archive, dead disk) aborts
    with the slot useless but the running system untouched.
    """
    if not shutil.which("xz"):
        raise RuntimeError("xz not found on the system")
    with open("/dev/null", "w") as devnull:
        xz = subprocess.Popen(["xz", "-dc", "--", img_path],
                              stdout=subprocess.PIPE, stderr=devnull)
        dd = subprocess.Popen(["dd", "of=%s" % idle_dev, "bs=4M",
                               "conv=fsync"],
                              stdin=subprocess.PIPE, stderr=devnull)
        written = 0
        try:
            # skip everything before the target partition
            remaining = part_off
            while remaining > 0:
                chunk = xz.stdout.read(min(4 * 1024 * 1024, remaining))
                if not chunk:
                    break
                remaining -= len(chunk)
            if remaining:
                raise RuntimeError("decompressed stream ended inside the "
                                   "skip region — corrupt archive?")
            while written < part_size:
                need = min(4 * 1024 * 1024, part_size - written)
                chunk = xz.stdout.read(need)
                if not chunk:
                    break
                dd.stdin.write(chunk)
                written += len(chunk)
                if written % (128 * 1024 * 1024) < 4 * 1024 * 1024:
                    st.d["progress"] = "wrote %d/%d MB" % (
                        written // (1024 * 1024), part_size // (1024 * 1024))
                    st.save()
        except BrokenPipeError:
            pass
        finally:
            # close dd's stdin first so dd sees EOF and exits; then kill xz —
            # its remaining output is not needed, and waiting for it without
            # draining would deadlock (xz blocked on a full pipe, dd gone)
            try:
                dd.stdin.close()
            except OSError:
                pass
            ddr = dd.wait()
            xz.kill()
            try:
                xz.stdout.close()
            except OSError:
                pass
            xz.wait()
    if written != part_size:
        raise RuntimeError("short write onto %s: %d of %d bytes — corrupt "
                           "archive?" % (idle_dev, written, part_size))
    if ddr != 0:
        raise RuntimeError("dd failed (rc=%d) writing %s" % (ddr, idle_dev))
    st.log("idle slot written: %d MB -> %s" % (part_size // (1024 * 1024),
                                               idle_dev))


def boot_refresh_set(board):
    """Which p1 files the transaction refreshes on the shared boot FAT."""
    if board == "rpi0-2w":
        # refresh everything the firmware/kernel consumes; keep per-device
        # flags and the A/B state, which belong to THIS card, not the image
        return None  # None = blacklist mode, keep_set below
    return {"boot.sd", "fip.bin"}   # cvitek whitelist


RPI_KEEP = {"config.txt", "cmdline.txt", "ab_slot", "ab_tries",
            "rnsbox-abselect", "hostname", "ver"}


def is_kept(name):
    return name in RPI_KEEP or name.startswith("usb.")


def fsync_dir(path):
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def read_range_from_xz(path, off, size):
    """Decompressed bytes [off, off+size) from an .img.xz (single pass)."""
    xz = subprocess.Popen(["xz", "-dc", "--", path],
                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    data = b""
    try:
        remaining = off
        while remaining > 0:
            chunk = xz.stdout.read(min(1024 * 1024, remaining))
            if not chunk:
                break
            remaining -= len(chunk)
        while len(data) < size:
            chunk = xz.stdout.read(size - len(data))
            if not chunk:
                break
            data += chunk
    finally:
        xz.kill()
        xz.wait()
    if len(data) != size:
        raise RuntimeError("short read from %s: %d of %d bytes"
                           % (path, len(data), size))
    return data


def write_boot_files(img_path, parts, board, layout, st):
    """Refresh the shared boot partition from the verified image.

    Old files are kept in STATE_DIR/boot-bak and restored on any mismatch —
    and because the slot is NOT flipped on failure, the box reboots into the
    old slot with the old boot chain either way.
    """
    p1_off, p1_size, _ = parts[0]
    fat_data = read_range_from_xz(img_path, p1_off, p1_size)
    fr = FatReader(fat_data)

    if board == "rpi0-2w":
        plan = []
        stack = ["/"]
        while stack:
            d = stack.pop()
            for e in fr.listdir(d):
                rel = (d + "/" + e["name"]).lstrip("/")
                if e["is_dir"]:
                    stack.append("/" + rel)
                elif not is_kept(e["name"]):
                    plan.append(rel)
        whitelist = None
    else:
        whitelist = boot_refresh_set(board)
        plan = []
        low = {w.lower() for w in whitelist}
        for e in fr.listdir("/"):
            if not e["is_dir"] and e["name"].lower() in low:
                plan.append(e["name"])
        missing = {w for w in whitelist
                   if w.lower() not in {p.lower() for p in plan}}
        if missing:
            raise RuntimeError("boot artifacts missing from image: %s"
                               % ",".join(sorted(missing)))
    if not plan:
        st.log("no boot files to refresh")
        return

    # free space check BEFORE touching anything
    boot_dir = layout["boot_dir"]
    need = 0
    for rel in plan:
        need += len(fr.read(rel))
    free = shutil.disk_usage(boot_dir).free
    bak_free = shutil.disk_usage(state_dir()).free
    if need > free - 4 * 1024 * 1024:
        raise RuntimeError("boot partition lacks %d free bytes for "
                           "refresh" % need)
    if need > bak_free - 4 * 1024 * 1024:
        raise RuntimeError("state partition lacks room for the boot backup")
    bak = os.path.join(state_dir(), "boot-bak")
    if os.path.isdir(bak):
        shutil.rmtree(bak)
    os.makedirs(bak)

    replaced = []
    try:
        for rel in plan:
            data = strip_cimg(fr.read(rel))
            if whitelist is not None:
                rel = rel.lower()   # canonical boot.sd/fip.bin naming
            dst = os.path.join(boot_dir, rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            if os.path.exists(dst):
                with open(dst, "rb") as src, \
                        open(os.path.join(bak, rel + ".old"), "wb") as dstf:
                    shutil.copyfileobj(src, dstf)
            tmp = dst + ".new"
            with open(tmp, "wb") as f:
                f.write(data)
                f.flush()
                os.fsync(f.fileno())
            with open(tmp, "rb") as f:
                if hashlib.sha256(f.read()).hexdigest() != \
                        hashlib.sha256(data).hexdigest():
                    raise RuntimeError("boot file read-back mismatch: %s"
                                       % rel)
            os.replace(tmp, dst)
            replaced.append(rel)
        fsync_dir(boot_dir)
    except Exception:
        st.log("boot refresh failed — restoring old files")
        for rel in replaced:
            dst = os.path.join(boot_dir, rel)
            old = os.path.join(bak, rel + ".old")
            if os.path.exists(old):
                shutil.copyfile(old, dst)
                os.unlink(old)
        fsync_dir(boot_dir)
        raise
    st.log("boot files refreshed: %s" % ", ".join(replaced[:8]) +
           (" (+%d more)" % (len(replaced) - 8) if len(replaced) > 8 else ""))


def acquire_lock(blocking=False):
    fd = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX if blocking else fcntl.LOCK_EX |
                    fcntl.LOCK_NB)
    except OSError as e:
        os.close(fd)
        if e.errno in (errno.EAGAIN, errno.EACCES, errno.EWOULDBLOCK):
            return None
        raise
    return fd


def do_apply(conf, allow_unknown_version=False):
    st = State().load()
    if st.d.get("phase") in ("downloading", "verifying", "writing_slot",
                             "writing_boot", "flipping"):
        st.log("apply already in progress")
        return 1
    try:
        layout = probe_layout()
    except LayoutError as e:
        st.d["phase"] = "error"
        st.d["error"] = str(e)
        st.log(str(e))
        st.save()
        return 1

    cand = st.d.get("candidate")
    if not cand or not cand.get("sha256"):
        st.log("no checked candidate — run check first")
        return 1
    cur = running_version()
    if not cur and not allow_unknown_version:
        st.log("running image version unknown (%s missing) — reflash this "
               "card once with a current image, then updates work" %
               IMAGE_VER_FILE)
        st.d["phase"] = "error"
        st.save()
        return 1
    if cur and not is_newer(cand["version"], cur):
        st.log("candidate %s is not newer than running %s" %
               (cand["version"], cur))
        st.d["phase"] = "uptodate"
        st.save()
        return 0

    board = conf.get("board") or "auto"
    if board in ("", "auto"):
        board = detect_board()

    dl = os.path.join(state_dir(), "download.img.xz")
    try:
        # 1+2: download (or reuse) + verify
        if not (os.path.exists(dl) and os.path.getsize(dl) > 1024 and
                st.d.get("downloaded_sha") == cand["sha256"]):
            st.d["phase"] = "downloading"
            st.save()
            st.log("downloading %s (%s)" % (cand["version"],
                                            safe_url(cand["url"])))
            size = fetch_url(cand["url"], conf, dest=dl, timeout=90,
                             max_bytes=MAX_IMAGE_MB * 1024 * 1024)
            st.d["downloaded_sha"] = ""
            st.log("downloaded %d MB" % (size // (1024 * 1024)))
        st.d["phase"] = "verifying"
        st.save()
        got = sha256_file(dl, progress=lambda m: (
            st.d.__setitem__("progress", m), st.save()))
        if got != cand["sha256"].lower():
            os.unlink(dl)
            raise RuntimeError("sha256 mismatch — expected %s, got %s"
                               % (cand["sha256"], got))
        st.d["downloaded_sha"] = got
        st.log("checksum verified")

        # 3: idle slot geometry
        parts = parse_mbr(dl)
        active = active_slot(layout)
        idle = "b" if active == "a" else "a"
        idle_index = 2 if idle == "b" else 1     # parts[1]=p2/a, parts[2]=p3/b
        if len(parts) <= idle_index:
            raise RuntimeError("image lacks the idle slot partition")
        off, size, _ = parts[idle_index]
        cap = dev_size_bytes(slot_dev(layout, idle))
        if size > cap:
            raise RuntimeError("image slot partition (%d MB) larger than %s "
                               "(%d MB)" % (size // (1024 * 1024),
                                            slot_dev(layout, idle),
                                            cap // (1024 * 1024)))

        # 4: write idle slot
        st.d["phase"] = "writing_slot"
        st.save()
        write_idle_slot(dl, slot_dev(layout, idle), off, size, st)

        # 5: refresh shared boot artifacts
        st.d["phase"] = "writing_boot"
        st.save()
        write_boot_files(dl, parts, board, layout, st)

        # 6: flip + arm the boot counter
        st.d["phase"] = "flipping"
        st.save()
        boot_dir = layout["boot_dir"]
        atomic_write(os.path.join(boot_dir, "ab_slot"), idle)
        atomic_write(os.path.join(boot_dir, "ab_tries"), "0")
        os.sync()
        st.d["pending"] = {"slot": idle, "version": cand["version"],
                           "started": int(time.time())}
        st.d["phase"] = "flipping"
        st.log("slot %s staged for %s — rebooting" % (idle, cand["version"]))
        st.save()
    except Exception as e:
        st.d["phase"] = "error"
        st.d["error"] = str(e)[:400]
        st.d["progress"] = ""
        st.log("FAILED: %s" % e)
        st.save()
        return 1

    # 7: reboot into the new slot (only on the full success path)
    reboot_now()
    return 0


def atomic_write(path, text):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text + "\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def reboot_now():
    if os.environ.get("RNSBOX_SYSUPDATE_NO_REBOOT") == "1":
        return          # tests / dry runs: stay up, state says "flipping"
    for cmd in (["reboot", "-f"], ["busybox", "reboot", "-f"]):
        try:
            subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL,
                             start_new_session=True)
            return
        except OSError:
            continue
    try:
        os.kill(1, 2)   # last resort: SIGINT to init
    except OSError:
        pass


def do_reconcile():
    """Settle a pending flip after a reboot: applied, rolled back, or still
    confirming (S98confirm has ~5 min to clear the boot counter)."""
    st = State().load()
    pending = st.d.get("pending")
    if not pending:
        return 0
    try:
        layout = probe_layout()
    except LayoutError:
        return 0
    slot = active_slot(layout)
    try:
        with open(os.path.join(layout["boot_dir"], "ab_tries")) as f:
            tries = int(f.read().strip() or "0")
    except (OSError, ValueError):
        tries = -1
    if slot == pending["slot"] and tries == 0:
        st.d["phase"] = "applied"
        st.d["last_applied"] = {"version": pending["version"],
                                "at": int(time.time())}
        st.d["progress"] = ""
        st.log("update to %s confirmed healthy (slot %s)" %
               (pending["version"], slot))
        st.d.pop("pending", None)
        st.save()
        return 0
    if slot != pending["slot"]:
        st.d["phase"] = "rolled_back"
        st.d["error"] = ""
        st.d["progress"] = ""
        st.log("update to %s ROLLED BACK by boot-count (on slot %s)" %
               (pending["version"], slot))
        st.d.pop("pending", None)
        st.save()
        return 0
    st.d["phase"] = "confirming"
    st.save()
    return 0


# ------------------------------------------------------------------ check ---

def do_check(conf):
    st = State().load()
    st.d["phase"] = "checking"
    st.d["error"] = ""
    st.save()
    try:
        cand = fetch_candidate(conf)
        if not cand or not cand.get("url"):
            raise ValueError("provider returned no candidate")
        cur = running_version()
        newer = is_newer(cand["version"], cur) if cur else True
        st.d["candidate"] = {
            "version": cand["version"], "url": cand["url"],
            "sha256": (cand.get("sha256") or "").lower(),
            "prerelease": bool(cand.get("prerelease")),
        }
        if not cur:
            st.d["phase"] = "available"
            st.log("checked %s: candidate %s; running version unknown "
                   "(reflash once with a current image)" %
                   (cand["version"], cand["version"]))
        elif newer:
            st.d["phase"] = "available"
            st.log("checked: update available %s -> %s" %
                   (cur, cand["version"]))
        else:
            st.d["phase"] = "uptodate"
            st.log("checked: up to date (%s)" % cur)
    except Exception as e:
        st.d["phase"] = "error"
        st.d["error"] = str(e)[:400]
        st.log("check failed: %s" % e)
    st.d["last_check"] = int(time.time())
    st.d["next_check"] = draw_next_check(conf)
    st.d["progress"] = ""
    st.save()
    write_conf_kv({"next_check": str(st.d["next_check"])})
    return 0 if st.d["phase"] != "error" else 1


def do_tick(conf):
    do_reconcile()
    st = State().load()
    if st.d.get("pending"):
        st.log("tick: an update is awaiting boot confirmation — not checking")
        return 0
    if not truthy(conf.get("enabled"), True):
        return 0
    due = time.time() >= _int(conf.get("next_check"), 0)
    if due:
        if do_check(conf) == 0 and truthy(conf.get("auto_apply")):
            st2 = State().load()
            if st2.d.get("phase") == "available":
                return do_apply(conf)
    return 0


def detect_board():
    """Best-effort board id for release-asset selection."""
    try:
        with open("/proc/device-tree/model") as f:
            model = f.read().strip("\x00").lower()
        if "raspberry pi" in model:
            return "rpi0-2w"
        if "lichee" in model or "sg2002" in model:
            return "licheerv-nano"
        if "duo" in model or "sg2000" in model or "cv1800" in model:
            return "licheerv-nano"
    except OSError:
        pass
    if os.path.exists("/boot/boot.sd"):
        return "licheerv-nano"
    return "rpi0-2w"


# ------------------------------------------------------------------- main ---

def run_bg(fn, *a, **kw):
    """Double-fork so a CGI caller is never blocked."""
    if os.environ.get("RNSBOX_SYSUPDATE_FOREGROUND") == "1":
        return fn(*a, **kw)
    if os.fork() > 0:
        return 0
    os.setsid()
    if os.fork() > 0:
        os._exit(0)
    fd = os.open(os.devnull, os.O_RDWR)
    os.dup2(fd, 0)
    os.dup2(fd, 1)
    os.dup2(fd, 2)
    if fd > 2:
        os.close(fd)
    try:
        rc = fn(*a, **kw)
    except Exception as e:
        State().load().log("unhandled: %s" % e)
        rc = 1
    os._exit(rc)


def main(argv):
    if len(argv) < 2:
        print(__doc__)
        return 2
    cmd = argv[1]
    conf = read_conf()

    if cmd == "status":
        st = State().load()
        try:
            layout = probe_layout()
            st.d["layout"] = "ab"
            st.d["active_slot"] = active_slot(layout)
        except LayoutError as e:
            st.d["layout"] = "none"
            st.d["layout_error"] = str(e)
        st.d["running_version"] = running_version()
        print(json.dumps(st.d))
        return 0

    if cmd == "enable":
        write_conf_kv({"enabled": "yes"})
        return 0
    if cmd == "disable":
        write_conf_kv({"enabled": "no"})
        return 0

    if cmd == "reconcile":
        return do_reconcile()

    if cmd == "check":
        return run_bg(do_check, conf)

    if cmd == "apply":
        return run_bg(do_apply, conf,
                      allow_unknown_version="--allow-unknown-version"
                      in argv)

    if cmd == "tick":
        return run_bg(do_tick, conf)

    print("unknown command: %s" % cmd)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
