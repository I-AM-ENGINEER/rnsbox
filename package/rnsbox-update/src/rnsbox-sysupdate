def truthy(v, default=False):
    if v is None or v == "":
        return default
    return str(v).strip().lower() in ("yes", "true", "1", "on")


# ---------------------------------------------------------------- storage ---

def state_dir():
    """Persistent state: /data (A/B layout, survives slot swaps) or rootfs."""
    if STATEDIR_OVERRIDE:
        os.makedirs(STATEDIR_OVERRIDE, exist_ok=True)
        return STATEDIR_OVERRIDE
    for cand in ("/data/rnsbox-update", "/var/lib/rnsbox-update"):
        try:
            os.makedirs(cand, exist_ok=True)
            return cand
        except OSError:
            continue
    return "/tmp/rnsbox-update"


def read_conf():
    conf = dict(DEFAULTS)
    try:
        with open(CONF_PATH, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, _, v = line.partition("=")
                k = k.strip().lower()
                v = v.split("#", 1)[0].strip()
                if k:
                    conf[k] = v
    except OSError:
        pass
    return conf


def write_conf_kv(updates):
    """Set keys, preserve unknown keys and the file layout, atomic rename."""
    lines = []
    try:
        with open(CONF_PATH, "r", encoding="utf-8", errors="replace") as f:
            lines = f.readlines()
    except OSError:
        lines = [CONF_HEADER]
    seen = set()
    out = []
    for line in lines:
        stripped = line.strip()
        key = stripped.partition("=")[0].strip().lower() \
            if ("=" in stripped and not stripped.startswith("#")) else None
        if key and key in updates:
            if key not in seen:
                out.append("%s=%s\n" % (key, updates[key]))
                seen.add(key)
            # dropped duplicate or managed key: next_check is rewritten
        else:
            out.append(line)
    for k, v in updates.items():
        if k not in seen:
            if out and not out[-1].endswith("\n"):
                out[-1] += "\n"
            out.append("%s=%s\n" % (k, v))
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(CONF_PATH) or ".",
                               prefix=".update.conf.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.writelines(out)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, CONF_PATH)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


class State(object):
    """Volatile status for the portal (/run) + persistent markers."""

    def __init__(self):
        self.d = {
            "phase": "idle",            # idle|checking|downloading|verifying|
                                        # writing_slot|writing_boot|flipping|
                                        # available|uptodate|error|applied|
                                        # rolled_back
            "error": "",
            "last_check": 0,
            "last_result": "",
            "candidate": None,
            "progress": "",
        }

    def load(self):
        for path in (RUN_STATE,):
            try:
                with open(path) as f:
                    self.d.update(json.load(f))
            except (OSError, ValueError):
                pass
        return self

    def save(self):
        d = os.path.dirname(RUN_STATE)
        try:
            fd, tmp = tempfile.mkstemp(dir=d, prefix=".sysupdate.")
            with os.fdopen(fd, "w") as f:
                json.dump(self.d, f)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, RUN_STATE)
        except OSError:
            pass

    def log(self, msg):
        line = time.strftime("%Y-%m-%d %H:%M:%S ") + str(msg) + "\n"
        self.d["last_result"] = str(msg)[:400]
        self.save()
        path = os.path.join(state_dir(), "update.log")
        try:
            if os.path.getsize(path) > MAX_LOG_BYTES:
                with open(path, "r") as f:
                    keep = f.read()[-MAX_LOG_BYTES // 2:]
                tmp = path + ".tmp"
                with open(tmp, "w") as f:
                    f.write(keep)
                os.replace(tmp, path)
            with open(path, "a") as f:
                f.write(line)
                f.flush()
                os.fsync(f.fileno())
        except OSError:
            pass


# ------------------------------------------------------------ networking ---

class HttpsEnforced(urllib.request.HTTPRedirectHandler):
    """Follow redirects but never into a scheme we did not allow."""

    def __init__(self, allow_http):
        self.allow_http = allow_http

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not scheme_allowed(newurl, self.allow_http):
            raise urllib.error.URLError("redirect to disallowed scheme: %s"
                                        % safe_url(newurl))
        return urllib.request.HTTPRedirectHandler.redirect_request(
            self, req, fp, code, msg, headers, newurl)


def scheme_allowed(url, allow_http):
    u = urllib.parse.urlparse(url)
    return u.scheme == "https" or (allow_http and u.scheme == "http")


def safe_url(url):
    """URL string safe to put in logs / flash messages."""
    u = urllib.parse.urlparse(url)
    if u.query or len(url) > 300:
        return u.scheme + "://" + (u.netloc or "") + u.path + "?..."
    return url


def http_open(allow_http):
    return urllib.request.build_opener(HttpsEnforced(allow_http))


def fetch_url(url, conf, timeout=DOWNLOAD_TIMEOUT, dest=None, max_bytes=None):
    """GET a URL; returns bytes or writes to dest and returns byte count.

    HTTPS is enforced unless allow_insecure_http=yes. No URL is ever passed
    to a shell. Basic auth via token=<user:pass> is supported (github uses
    the token as the password-less header, so this path is for generic).
    """
    if not scheme_allowed(url, truthy(conf.get("allow_insecure_http"))):
        raise ValueError("refusing non-HTTPS URL (set allow_insecure_http=yes "
                         "to override): %s" % safe_url(url))
    req = urllib.request.Request(url, headers={
        "User-Agent": "rnsbox-sysupdate/1.0",
        "Accept": "*/*",
    })
    tok = conf.get("token") or ""
    if tok and "@" not in (urllib.parse.urlparse(url).netloc):
        if conf.get("provider") == "github-releases":
            req.add_header("Authorization", "Bearer " + tok)
        else:
            basic = base64.b64encode(tok.encode("utf-8")).decode("ascii")
            req.add_header("Authorization", "Basic " + basic)
    opener = http_open(truthy(conf.get("allow_insecure_http")))
    with opener.open(req, timeout=timeout) as r:
        if max_bytes is None:
            data = r.read(MAX_IMAGE_MB * 1024 * 1024 + 1)
            if len(data) > MAX_IMAGE_MB * 1024 * 1024:
                raise ValueError("response larger than %d MB" % MAX_IMAGE_MB)
            return data
        total = 0
        with open(dest, "wb") as f:
            while True:
                chunk = r.read(256 * 1024)
                if not chunk:
                    break
                total += len(chunk)
                if total > max_bytes:
                    raise ValueError("download exceeds %d bytes" % max_bytes)
                f.write(chunk)
            f.flush()
            os.fsync(f.fileno())
        return total


# ------------------------------------------------------------- providers ---

PROVIDERS_DIR = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                             "update_providers")


def load_provider(name):
    """Adding a provider = one module in update_providers/ + a registry row.
    Config names may use dashes ('github-releases'); module files use
    underscores (github_releases.py)."""
    modname = (name or "").strip().replace("-", "_")
    if not re.match(r"^[a-z0-9_]{1,40}$", modname):
        raise ValueError("invalid provider name %r" % name)
    if PROVIDERS_DIR not in sys.path:
        sys.path.insert(0, PROVIDERS_DIR)
    try:
        return __import__(modname)
    except ImportError as e:
        raise ValueError("unknown provider %r (%s)" % (name, e))


def fetch_candidate(conf):
    """Ask the configured provider for the newest candidate image."""
    name = (conf.get("provider") or "github-releases").strip()
    mod = load_provider(name)
    board = conf.get("board") or "auto"
    if board in ("", "auto"):
        board = detect_board()
    return mod.fetch(conf, board, fetch_url, truthy)


# --------------------------------------------------------------- version ---

TAG_RE = re.compile(r"^r(\d{4})\.(\d{2})\.(\d{2})-([0-9a-f]{7,40})$")


def parse_tag(tag):
    """'r2026.10.15-abc1234' -> (date, sha) or None."""
    m = TAG_RE.match((tag or "").strip())
    if not m:
        return None
    y, mo, d, sha = m.groups()
    return ((int(y), int(mo), int(d)), sha)


def running_version():
    try:
        with open(IMAGE_VER_FILE) as f:
            return f.read().strip()
    except OSError:
        return ""


def is_newer(cand_tag, cur_tag):
    """True when cand should be applied over cur.

    Primary key is the short sha (same image = same sha, whatever the dates);
    a different sha with a >= build date counts as newer. Same date + same
    sha = same build. Unknown running version is handled by the caller.
    """
    c, u = parse_tag(cand_tag), parse_tag(cur_tag)
    if not c:
        return False
    if not u:
        return True
    if c[1] == u[1]:
        return False
    return c[0] >= u[0]


# -------------------------------------------------------------- schedule ---

def draw_next_check(conf):
    lo = max(1, _int(conf.get("interval_min_days"), 7))
    hi = max(lo, _int(conf.get("interval_max_days"), 14))
    return int(time.time() + random.randint(lo * 86400, hi * 86400))


def _int(v, dflt):
    try:
        return int(str(v).strip())
    except (TypeError, ValueError):
        return dflt


# ---------------------------------------------------------------- layout ---

def probe_layout():
    """Find the A/B topology. Returns dict or raises LayoutError.

    RNSBOX_UPDATE_DEVMAP (json file) overrides everything for tests/QEMU:
      {"boot_dir": "...", "boot_dev": "...", "slot_a": "...", "slot_b": "..."}
    """
    devmap = os.environ.get("RNSBOX_UPDATE_DEVMAP")
    if devmap:
        with open(devmap) as f:
            m = json.load(f)
        m.setdefault("boot_dir", BOOT_DIR)
        return m

    boot_dev = ""
    with open("/proc/mounts") as f:
        for line in f:
            parts = line.split()
            if len(parts) >= 2 and parts[1] == BOOT_DIR:
                boot_dev = parts[0]
                break
    if not boot_dev or not re.search(r"\d+$", boot_dev):
        raise LayoutError("no %s mount — not an A/B image" % BOOT_DIR)
    base = re.sub(r"p?\d+$", "", boot_dev)
    slot_a, slot_b = base + "p2", base + "p3"
    # whole-disk devices that don't use the 'p' separator (vda2)
    if not os.path.exists(slot_a):
        slot_a, slot_b = base + "2", base + "3"
    for d in (slot_a, slot_b):
        if not os.path.exists(d):
            raise LayoutError("no A/B slot partition (%s missing) — reflash "
                              "with a current A/B image once" % d)
    return {"boot_dir": BOOT_DIR, "boot_dev": boot_dev,
            "slot_a": slot_a, "slot_b": slot_b}


class LayoutError(Exception):
    pass


def active_slot(layout):
    try:
        with open(os.path.join(layout["boot_dir"], "ab_slot")) as f:
            s = f.read().strip()
    except OSError:
        s = ""
    return s if s in ("a", "b") else "a"


def slot_dev(layout, slot):
    return layout["slot_a"] if slot == "a" else layout["slot_b"]


def dev_size_bytes(dev):
    try:
        with open("/sys/class/block/%s/size" % os.path.basename(dev)) as f:
            return int(f.read().strip()) * 512
    except OSError:
        # not a block device (file-backed slot in tests/QEMU): file size
        return os.path.getsize(dev)


# -------------------------------------------------------------- MBR + FAT ---

def parse_mbr_sector(sec):
    """[(start_byte, size_bytes, ptype)] for the 4 MBR entries of a 512-byte
    sector."""
    if len(sec) < 512 or sec[510:512] != b"\x55\xaa":
        raise ValueError("downloaded image has no MBR signature")
    parts = []
    for i in range(4):
        e = sec[446 + 16 * i: 446 + 16 * (i + 1)]
        ptype = e[4]
        lba, cnt = struct.unpack_from("<II", e, 8)
        if ptype and lba and cnt:
            parts.append((lba * 512, cnt * 512, ptype))
    if len(parts) < 3:
        raise ValueError("downloaded image has fewer than 3 partitions — "
                         "not an A/B image")
    return parts


def parse_mbr(path):
    """Partition table of a downloaded .img.xz: the MBR comes from the
    DECOMPRESSED stream (the file itself is compressed)."""
    if not shutil.which("xz"):
        raise RuntimeError("xz not found on the system")
    xz = subprocess.Popen(["xz", "-dc", "--", path],
                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    try:
        sec = xz.stdout.read(512)
    finally:
        xz.kill()
        xz.wait()
    return parse_mbr_sector(sec)


CIMG_MAGIC = b"CIMG"


def strip_cimg(data):
    """CI boot.sd assets may arrive wrapped in a 64-byte CIMG header; the
    on-card FIT must be bare. Detect and strip, pass anything else through.
    """
    if data[:4] == CIMG_MAGIC:
        return data[64:]
    return data


class FatError(Exception):
    pass


class FatReader(object):
    """Minimal read-only FAT12/16/32 with long-filename support, enough to
    pull boot artifacts out of a downloaded image's boot partition without
    any kernel loop-device dependency."""

    ATTR_LONG_NAME = 0x0F

    def __init__(self, data):
        if len(data) < 512:
            raise FatError("boot partition too small")
        self.d = data
        (self.bps, self.spc, self.reserved, self.nfats, self.root_ent,
         tot16) = struct.unpack_from("<HBHBHH", data, 11)
        # offset 21 is the media descriptor; FAT16 sector count is at 19,
        # FAT size at 22 (FAT16) / 36 (FAT32)
        self.fatsz16 = struct.unpack_from("<H", data, 22)[0]
        tot32 = struct.unpack_from("<I", data, 32)[0]
        self.fatsz = self.fatsz16 or struct.unpack_from("<I", data, 36)[0]
        self.root_cluster = struct.unpack_from("<I", data, 44)[0]
        totsec = tot16 or tot32
        if self.bps == 0 or self.spc == 0 or totsec == 0:
            raise FatError("not a FAT filesystem")
        self.fat_off = self.reserved * self.bps
        self.data_off = (self.reserved + self.nfats * self.fatsz) * self.bps
        nclusters = (totsec - self.data_off // self.bps) // self.spc
        self.fat12 = nclusters < 4085
        self.fat16 = nclusters < 65525
        self.root_dir_off = self.data_off
        self.root_dir_size = self.root_ent * 32
        if self.fat16:
            self.data_off += self.root_dir_size

    def _fat_entry(self, cl):
        o = self.fat_off
        if self.fat12:
            b = struct.unpack_from("<H", self.d, o + cl * 3 // 2)[0]
            return (b >> 4) if cl & 1 else (b & 0xFFF)
        if self.fat16:
            return struct.unpack_from("<H", self.d, o + cl * 2)[0]
        return struct.unpack_from("<I", self.d, o + cl * 4)[0] & 0x0FFFFFFF

    def _chain(self, first):
        cl, out, guard = first, [], set()
        end = 0xFFF if self.fat12 else (0xFFFF if self.fat16 else 0x0FFFFFF8)
        while 2 <= cl < end:
            if cl in guard:
                raise FatError("cluster loop")
            guard.add(cl)
            out.append(cl)
            cl = self._fat_entry(cl)
        return out

    def _clus_data(self, chain):
        n = self.spc * self.bps
        return b"".join(self.d[self.data_off + (c - 2) * n:
                               self.data_off + (c - 1) * n] for c in chain)

    def _dir_entries(self, dirdata):
        lfn, out = [], []
        for i in range(0, len(dirdata) - 31, 32):
            e = dirdata[i:i + 32]
            if e[0] == 0x00:
                lfn = []
                continue
            if e[0] == 0xE5:
                lfn = []
                continue
            if e[11] == self.ATTR_LONG_NAME:
                # LFN parts carry 26 UCS-2 chars in three scattered chunks
                raw = e[1:11] + e[14:26] + e[28:32]
                chars = raw.decode("utf-16-le", "ignore")
                chars = chars.split("\x00")[0]
                lfn.append((e[0] & 0x1F, chars.replace("\uffff", "")))
                continue
            name = e[0:8].decode("ascii", "replace").strip()
            ext = e[8:11].decode("ascii", "replace").strip()
            short = name + ("." + ext if ext else "")
            if lfn:
                lfn.sort()                  # entries arrive last-part first
                longname = "".join(c for _, c in lfn)
            else:
                longname = short
            lfn = []
            attr = e[11]
            if attr & 0x08:            # volume label
                continue
            cl = struct.unpack_from("<H", e, 26)[0]
            size = struct.unpack_from("<I", e, 28)[0]
            first = struct.unpack_from("<H", e, 20)[0] << 16 | cl
            out.append({"name": longname, "short": short, "attr": attr,
                        "cluster": first, "size": size,
                        "is_dir": bool(attr & 0x10)})
        return out

    def listdir(self, path="/"):
        data = self._dir_data(path)
        return self._dir_entries(data)

    def _dir_data(self, path):
        if path in ("/", ""):
            if self.fat16:
                return self.d[self.root_dir_off:
                              self.root_dir_off + self.root_dir_size]
            return self._clus_data(self._chain(self.root_cluster))
        parts = [p for p in path.split("/") if p]
        entries = self.listdir("/")
        cur = None
        for i, p in enumerate(parts):
            for e in entries:
                if e["name"].lower() == p.lower() and e["is_dir"]:
                    cur = e
                    break
            if cur is None:
                raise FatError("dir not found: %s" % p)
            if i == len(parts) - 1:
                return self._clus_data(self._chain(cur["cluster"]))
            entries = self._dir_entries(
                self._clus_data(self._chain(cur["cluster"])))
        raise FatError("dir not found: %s" % path)

    def read(self, path):
        parts = [p for p in path.split("/") if p]
        entries = self.listdir("/" + "/".join(parts[:-1]))
        fname = parts[-1]
        for e in entries:
            if e["name"].lower() == fname.lower() and not e["is_dir"]:
                data = self._clus_data(self._chain(e["cluster"]))
                return data[:e["size"]]
        raise FatError("file not found: %s" % path)


def read_fat_file(img_path, part_off, part_size, inner_path):
    """Extract one file from the FAT partition of a downloaded image."""
    with open(img_path, "rb") as f:
        f.seek(part_off)
        data = f.read(part_size)
    return FatReader(data).read(inner_path)


