2026-10-26T20:43:23.1258891Z [36;1m  echo ""[0m
2026-10-26T20:43:23.1259616Z [36;1m  printSeparationLine '*' 80[0m
2026-10-26T20:43:23.1260475Z [36;1m  if [ ! -z "${title}" ]; then[0m
2026-10-26T20:43:23.1261445Z [36;1m    echo "=> ${title}: Saved $(formatByteCount $saved)"[0m
2026-10-26T20:43:23.1262418Z [36;1m  else[0m
2026-10-26T20:43:23.1263197Z [36;1m    echo "=> Saved $(formatByteCount $saved)"[0m
